	local accent = getAccentColor()
	local isHead = (STATE.LockTargetPart == "Head")

	headTargetBtn.Text = isHead and "✓ 🧠 ГОЛОВА" or "🧠 ГОЛОВА"
	headTargetBtn.TextColor3 = isHead and COLORS.BgDark or COLORS.TextDim
	headTargetBtn.BackgroundColor3 = isHead and accent or COLORS.BgElement
	headStroke.Color = isHead and accent or COLORS.TextDim

	bodyTargetBtn.Text = (not isHead) and "✓ 🛡️ ТЕЛО" or "🛡️ ТЕЛО"
	bodyTargetBtn.TextColor3 = (not isHead) and COLORS.BgDark or COLORS.TextDim
	bodyTargetBtn.BackgroundColor3 = (not isHead) and accent or COLORS.BgElement
	bodyStroke.Color = (not isHead) and accent or COLORS.TextDim
end

