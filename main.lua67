-- ============================================================================
-- 8. АНИМАЦИЯ ОТКРЫТИЯ / ЗАКРЫТИЯ И ПЕРЕТАСКИВАНИЕ (MOUSE + TOUCH)
-- ============================================================================
local function setMenuVisible(visible: boolean)
	STATE.MenuOpen = visible
	if visible then
		mainFrame.Visible = true
		uiScale.Scale = 0.85
		quickTween(uiScale, 0.28, { Scale = 1 }, Enum.EasingStyle.Back)
	else
		local tw = quickTween(uiScale, 0.18, { Scale = 0.85 }, Enum.EasingStyle.Quad)
		tw.Completed:Once(function()
			if not STATE.MenuOpen then
				mainFrame.Visible = false
			end
		end)
	end
end

local function makeDraggable(dragHandle: GuiObject, moveTarget: GuiObject)
	local dragging = false
	local dragStart = Vector3.zero
	local startPos = UDim2.new()

	dragHandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = moveTarget.Position
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			moveTarget.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

makeDraggable(header, mainFrame)
makeDraggable(openPill, openPill)

openPill.MouseButton1Click:Connect(function()
	setMenuVisible(not STATE.MenuOpen)
end)
closeBtn.MouseButton1Click:Connect(function()
	setMenuVisible(false)
end)

-- ============================================================================
-- 9. ЦИКЛЫ ОБНОВЛЕНИЯ КАМЕРЫ, ФИЗИКИ И РЕНДЕРА
-- ============================================================================
local function onCameraStep(dt: number)
	local activeCam = camera
	if not activeCam then return end

	if not STATE.LockEnabled or not isLocking then
		clearTargetBeam()
		fovStroke.Color = THEME.NeonCyan
		return
	end

	local valid, targetPart = isValidTarget(currentTarget)
	if not valid or not targetPart then
		currentTarget = findClosestTarget()
		valid, targetPart = isValidTarget(currentTarget)
		if not valid or not targetPart then
			clearTargetBeam()
			fovStroke.Color = THEME.NeonCyan
			return
		end
	end

	fovStroke.Color = THEME.NeonPink
	updateTargetBeam(targetPart)

	if activeCam.CameraType ~= Enum.CameraType.Custom then
		activeCam.CameraType = Enum.CameraType.Custom
	end

	local camPos = activeCam.CFrame.Position
	local goalCFrame = CFrame.lookAt(camPos, targetPart.Position)
	local alpha = 1 - math.exp(-STATE.LockSmoothness * 60 * dt)
	activeCam.CFrame = activeCam.CFrame:Lerp(goalCFrame, alpha)
end

local elapsedTime = 0
local function onRenderStepped(dt: number)
	elapsedTime += dt

	-- Плавное вращение неоновой рамки меню (только когда меню открыто)
	if mainFrame.Visible then
		borderGradient.Rotation = (elapsedTime * 75) % 360
	end

	local activeCam = camera
	if not activeCam then return end
	local camPos = activeCam.CFrame.Position

	-- Полёт (Free-Fly) через MoveDirection (работает и с WASD, и со стиком на телефоне)
	if STATE.FlyEnabled then
		local char = localPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if root and hum then
			hum.PlatformStand = true
			local moveDir = hum.MoveDirection
			local flyVel = Vector3.zero
			if moveDir.Magnitude > 0.05 then
				-- Проецируем движение по направлению взгляда камеры
				local camLook = activeCam.CFrame.LookVector
				local camRight = activeCam.CFrame.RightVector
				local flatLook = Vector3.new(camLook.X, 0, camLook.Z).Unit
				local forwardAmt = moveDir:Dot(flatLook)
				local rightAmt = moveDir:Dot(camRight)
				flyVel = (camLook * forwardAmt + camRight * rightAmt) * STATE.FlySpeed
			end
			root.AssemblyLinearVelocity = flyVel
		end
	end

	-- Обновление оверлеев, дистанции и пульсации
	local pulseWave: number? = nil
	for _, data in pairs(activeOverlays) do
		local root = data.rootPart
		if root and root.Parent then
			local dist = (root.Position - camPos).Magnitude
			local inRange = dist <= STATE.OverlayMaxDistance

			if data.isVisible ~= inRange then
				data.isVisible = inRange
				data.billboard.Enabled = inRange and STATE.OverlayEnabled
				data.highlight.Enabled = inRange and STATE.ShowHighlight
				data.emitter.Enabled = inRange and STATE.ParticlesEnabled
			end

			if inRange then
				if STATE.OverlayEnabled then
					data.distLabel.Text = string.format("%dm • %d HP", math.floor(dist * 0.28), math.ceil(data.humanoid.Health))
				end
				if data.isLowHp and data.fadeReady then
					if not pulseWave then
						pulseWave = (math.sin(elapsedTime * 7.5) + 1) * 0.5
					end
					data.glowStroke.Transparency = 0.08 + (pulseWave * 0.55)
					data.glowImage.ImageTransparency = 0.2 + (pulseWave * 0.55)
				end
			end
		end
	end
end

-- ============================================================================
-- 10. ВВОД, ЖИЗНЕННЫЙ ЦИКЛ ИГРОКОВ И ОЧИСТКА
-- ============================================================================
UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
	if not gameProcessed and (input.KeyCode == STATE.MenuKey or input.KeyCode == STATE.AltMenuKey) then
		setMenuVisible(not STATE.MenuOpen)
		return
	end

	if STATE.LockEnabled then
		if input.UserInputType == STATE.LockKey or (not gameProcessed and input.KeyCode == STATE.LockAltKey) then
			if STATE.LockToggleMode then
				isLocking = not isLocking
				currentTarget = isLocking and findClosestTarget() or nil
			else
				isLocking = true
				currentTarget = findClosestTarget()
			end
		end
	end
end)

UserInputService.InputEnded:Connect(function(input: InputObject)
	if not STATE.LockToggleMode then
		if input.UserInputType == STATE.LockKey or input.KeyCode == STATE.LockAltKey then
			isLocking = false
			currentTarget = nil
		end
	end
end)

-- Прыжок в воздухе (Air-Jump) с неоновой вспышкой под ногами
UserInputService.JumpRequest:Connect(function()
	if not STATE.InfiniteJump then return end
	local char = localPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if hum and root and hum:GetState() == Enum.HumanoidStateType.Freefall then
		hum:ChangeState(Enum.HumanoidStateType.Jumping)
	end
end)

-- Сохранение пользовательских настроек скорости/прыжка при респавне локального игрока
localPlayer.CharacterAdded:Connect(function(char)
	local hum = char:WaitForChild("Humanoid", 5) :: Humanoid?
	if hum then
		hum.WalkSpeed = STATE.CustomWalkSpeed
		hum.UseJumpPower = true
		hum.JumpPower = STATE.CustomJumpPower
	end
end)

local function setupPlayer(player: Player)
	if player == localPlayer then return end
	if player.Character then
		task.spawn(createOverlay, player, player.Character)
	end
	playerConnections[player] = player.CharacterAdded:Connect(function(character)
		createOverlay(player, character)
	end)
end

local function cleanupPlayer(player: Player)
	local conn = playerConnections[player]
	if conn and conn.Connected then
		conn:Disconnect()
	end
	playerConnections[player] = nil
	removeOverlay(player)
end

for _, player in ipairs(Players:GetPlayers()) do
	setupPlayer(player)
end

Players.PlayerAdded:Connect(setupPlayer)
Players.PlayerRemoving:Connect(cleanupPlayer)

Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	camera = Workspace.CurrentCamera
end)

RunService:BindToRenderStep("NeonLockOnStep", Enum.RenderPriority.Camera.Value + 1, onCameraStep)
RunService.RenderStepped:Connect(onRenderStepped)
