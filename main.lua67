-- Единый LocalScript в StarterPlayerScripts
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local localPlayer = Players.LocalPlayer
local playerGui = localPlayer:WaitForChild("PlayerGui")
local camera = workspace.CurrentCamera
local targetsFolder = workspace:WaitForChild("Targets")

-- ==========================================
-- НАСТРОЙКИ И СОСТОЯНИЕ
-- ==========================================
local Config = {
	AimRadius = 250,         -- Радиус захвата в пикселях от центра экрана
	Smoothness = 0.2,        -- Плавность доводки камеры (0.05 - 1)
	TargetPart = "Head",     -- Часть тела для прицеливания
	MaxEspDistance = 200,    -- Дистанция видимости HP и цифр урона
	DmgPoolSize = 20,        -- Размер пула цифр урона (экономия FPS)
	DmgLifetime = 0.85,      -- Время жизни цифры урона (сек)
	DmgFloatSpeed = 2.8,     -- Скорость всплытия цифры (стадов/сек)
}

local State = {
	ScriptActive = true,
	AimbotEnabled = false,
	IsAiming = false,
	EspBots = true,
	EspPlayers = false,
	DamageNumbers = true,
	UILocked = false,
}

local Connections = {} -- Все глобальные слушатели для чистой выгрузки
local TrackedModels = {} -- [Model] = { billboard = BillboardGui, isPlayer = bool, conns = {} }
local lockedTarget = nil

local function trackConn(conn)
	table.insert(Connections, conn)
	return conn
end

-- ==========================================
-- ПУЛ ОБЪЕКТОВ ДЛЯ ЦИФР УРОНА (ZERO GC)
-- ==========================================
local dmgFolder = Instance.new("Folder")
dmgFolder.Name = "DebugDamagePool"
dmgFolder.Parent = camera -- Храним в камере, чтобы пули (Raycast) не задевали якоря

local inactiveDmgPool = {}
local activeDmgList = {}

for i = 1, Config.DmgPoolSize do
	local part = Instance.new("Part")
	part.Name = "DmgAnchor"
	part.Size = Vector3.new(0.1, 0.1, 0.1)
	part.Transparency = 1
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Parent = dmgFolder

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.new(3, 0, 1.2, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = Config.MaxEspDistance
	billboard.Enabled = false
	billboard.Parent = part

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextStrokeTransparency = 0.2
	label.TextStrokeColor3 = Color3.fromRGB(15, 15, 15)
	label.Parent = billboard

	table.insert(inactiveDmgPool, {
		part = part,
		billboard = billboard,
		label = label,
		elapsed = 0,
		startPos = Vector3.zero,
		offsetX = 0,
		offsetZ = 0,
	})
end

local function spawnDamageNumber(position, damageAmount)
	if not State.ScriptActive or not State.DamageNumbers then return end

	local item = table.remove(inactiveDmgPool)
	if not item then
		item = table.remove(activeDmgList, 1)
	end

	local roundedDmg = math.max(1, math.floor(damageAmount + 0.5))
	item.label.Text = tostring(roundedDmg)
	item.label.TextTransparency = 0
	item.label.TextStrokeTransparency = 0.2

	if roundedDmg >= 50 then
		item.label.TextColor3 = Color3.fromRGB(255, 75, 75)
	elseif roundedDmg >= 25 then
		item.label.TextColor3 = Color3.fromRGB(255, 195, 50)
	else
		item.label.TextColor3 = Color3.fromRGB(255, 255, 255)
	end

	item.elapsed = 0
	item.startPos = position + Vector3.new(0, 1.5, 0)
	item.offsetX = (math.random() - 0.5) * 1.6
	item.offsetZ = (math.random() - 0.5) * 1.6

	item.part.Position = item.startPos
	item.billboard.Enabled = true
	table.insert(activeDmgList, item)
end

-- ==========================================
-- ПЕРЕТАСКИВАНИЕ БЕЗ ДЁРГАНЬЯ (С LOCK)
-- ==========================================
local function makeDraggable(guiObject, dragHandle)
	dragHandle = dragHandle or guiObject
	local dragging = false
	local dragInput = nil
	local dragStart = nil
	local startPos = nil

	trackConn(dragHandle.InputBegan:Connect(function(input)
		if State.UILocked then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragInput = input
			dragStart = input.Position
			startPos = guiObject.Position
		end
	end))

	trackConn(UserInputService.InputChanged:Connect(function(input)
		if dragging and input == dragInput and not State.UILocked then
			local delta = input.Position - dragStart
			guiObject.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end))

	trackConn(UserInputService.InputEnded:Connect(function(input)
		if input == dragInput then
			dragging = false
			dragInput = nil
		end
	end))
end

