	local function refresh()
		local st = getVal()
		local accent = getAccentColor()
		quickTween(knob, 0.18, {
			Position = st and UDim2.fromOffset(25, 3) or UDim2.fromOffset(3, 3),
			BackgroundColor3 = st and accent or COLORS.TextDim,
		})
		sStroke.Color = st and accent or COLORS.TextDim
	end

	switchBg.MouseButton1Click:Connect(function()
		setVal(not getVal())
		refresh()
	end)

	table.insert(uiRefreshCallbacks, refresh)
	refresh()
end

local function addSlider(parent: Instance, title: string, minV: number, maxV: number, decimals: number, getVal: () -> number, setVal: (number) -> ())
	local box = Instance.new("Frame")
	box.Size = UDim2.new(1, -6, 0, 48)
	box.BackgroundColor3 = COLORS.BgElement
	box.BorderSizePixel = 0
	box.Parent = parent

	local bCorner = Instance.new("UICorner")
	bCorner.CornerRadius = UDim.new(0, 8)
	bCorner.Parent = box

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(0.68, 0, 0, 20)
	lbl.Position = UDim2.fromOffset(12, 4)
	lbl.BackgroundTransparency = 1
	lbl.Text = title
	lbl.TextColor3 = COLORS.TextMain
	lbl.Font = Enum.Font.GothamMedium
	lbl.TextSize = 12
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = box

	local valLbl = Instance.new("TextLabel")
	valLbl.Size = UDim2.new(0.28, -12, 0, 20)
	valLbl.Position = UDim2.new(0.72, 0, 0, 4)
	valLbl.BackgroundTransparency = 1
	valLbl.TextColor3 = getAccentColor()
	valLbl.Font = Enum.Font.GothamBold
	valLbl.TextSize = 12
	valLbl.TextXAlignment = Enum.TextXAlignment.Right
	valLbl.Parent = box

	local track = Instance.new("Frame")
	track.Size = UDim2.new(1, -24, 0, 8)
	track.Position = UDim2.fromOffset(12, 30)
	track.BackgroundColor3 = COLORS.BgDark
	track.BorderSizePixel = 0
	track.Parent = box

	local tCorner = Instance.new("UICorner")
	tCorner.CornerRadius = UDim.new(1, 0)
	tCorner.Parent = track

	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(0.5, 1)
	fill.BackgroundColor3 = getAccentColor()
	fill.BorderSizePixel = 0
	fill.Parent = track

	local fCorner = Instance.new("UICorner")
	fCorner.CornerRadius = UDim.new(1, 0)
	fCorner.Parent = fill

	local function refresh()
		local cur = math.clamp(getVal(), minV, maxV)
		local ratio = (cur - minV) / (maxV - minV)
		fill.Size = UDim2.fromScale(ratio, 1)
		fill.BackgroundColor3 = getAccentColor()
		valLbl.TextColor3 = getAccentColor()
		valLbl.Text = string.format("%." .. decimals .. "f", cur)
	end

	local dragging = false
	local function updateFromInput(inputPos: Vector3)
		local absPos = track.AbsolutePosition.X
		local absSize = track.AbsoluteSize.X
		if absSize <= 0 then return end
		local pct = math.clamp((inputPos.X - absPos) / absSize, 0, 1)
		local mult = 10 ^ decimals
		local newVal = math.round((minV + (maxV - minV) * pct) * mult) / mult
		setVal(newVal)
		refresh()
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			updateFromInput(input.Position)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			updateFromInput(input.Position)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	table.insert(uiRefreshCallbacks, refresh)
	refresh()
end

local function addActionButton(parent: Instance, getTitle: () -> string, onClick: () -> ())
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -6, 0, 34)
	btn.BackgroundColor3 = COLORS.BgElement
	btn.Text = getTitle()
	btn.TextColor3 = getAccentColor()
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 12
	btn.AutoButtonColor = false
	btn.Parent = parent

	local bCorner = Instance.new("UICorner")
	bCorner.CornerRadius = UDim.new(0, 8)
	bCorner.Parent = btn

	local bStroke = Instance.new("UIStroke")
	bStroke.Thickness = 1.2
	bStroke.Color = getAccentColor()
	bStroke.Transparency = 0.4
	bStroke.Parent = btn

	local function refresh()
		local accent = getAccentColor()
		btn.Text = getTitle()
		btn.TextColor3 = accent
		bStroke.Color = accent
	end
	table.insert(uiRefreshCallbacks, refresh)

	btn.MouseButton1Click:Connect(function()
		local accent = getAccentColor()
		quickTween(btn, 0.1, { BackgroundColor3 = accent, TextColor3 = COLORS.BgDark })
		task.delay(0.12, function()
			quickTween(btn, 0.18, { BackgroundColor3 = COLORS.BgElement, TextColor3 = getAccentColor() })
		end)
		onClick()
		refresh()
	end)
end

