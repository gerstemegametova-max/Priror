local function cycleDetailMode()
	if STATE.EspDetailMode == "FULL" then
		STATE.EspDetailMode = "COMPACT"
	elseif STATE.EspDetailMode == "COMPACT" then
		STATE.EspDetailMode = "MINIMAL"
	else
		STATE.EspDetailMode = "FULL"
	end
	refreshAllOverlayLayouts()
	for _, cb in ipairs(uiRefreshCallbacks) do cb() end
end

local function getDetailButtonLabel(): string
	if STATE.EspDetailMode == "FULL" then
		return "📋 Информация: ПОЛНАЯ (Имя+HP+м)"
	elseif STATE.EspDetailMode == "COMPACT" then
		return "📋 Информация: КОМПАКТ (Имя+HP)"
	else
		return "📋 Информация: МИНИ (Только полоска)"
	end
end

