indStroke.Parent = tabIndicator

-- Контейнер страниц
local pagesHolder = Instance.new("Frame")
pagesHolder.Size = UDim2.new(1, -24, 1, -100)
pagesHolder.Position = UDim2.fromOffset(12, 92)
pagesHolder.BackgroundTransparency = 1
pagesHolder.Parent = mainFrame

local tabNames = { "🎯 LOCK-ON", "✨ OVERLAY", "⚡ PHYSICS" }
local pages: { ScrollingFrame } = {}
local tabButtons: { TextButton } = {}

local function switchTab(index: number)
	for i, page in ipairs(pages) do
		page.Visible = (i == index)
		tabButtons[i].TextColor3 = (i == index) and THEME.NeonCyan or THEME.TextDim
	end
	quickTween(tabIndicator, 0.25, {
		Position = UDim2.new((index - 1) / 3, 3, 0, 3),
	})
end

for i, name in ipairs(tabNames) do
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1 / 3, 0, 1, 0)
	btn.Position = UDim2.fromScale((i - 1) / 3, 0)
	btn.BackgroundTransparency = 1
	btn.Text = name
	btn.TextColor3 = (i == 1) and THEME.NeonCyan or THEME.TextDim
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 12
	btn.ZIndex = 2
	btn.Parent = tabBar
	table.insert(tabButtons, btn)

	local page = Instance.new("ScrollingFrame")
	page.Size = UDim2.fromScale(1, 1)
	page.BackgroundTransparency = 1
	page.BorderSizePixel = 0
	page.ScrollBarThickness = 3
	page.ScrollBarImageColor3 = THEME.NeonCyan
	page.AutomaticCanvasSize = Enum.AutomaticSize.Y
	page.CanvasSize = UDim2.new(0, 0, 0, 0)
	page.Visible = (i == 1)
	page.Parent = pagesHolder

	local listLayout = Instance.new("UIListLayout")
	listLayout.Padding = UDim.new(0, 8)
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.Parent = page

	local pad = Instance.new("UIPadding")
	pad.PaddingBottom = UDim.new(0, 8)
	pad.Parent = page

	table.insert(pages, page)
	btn.MouseButton1Click:Connect(function()
		switchTab(i)
	end)
end

-- Фабрика UI-элементов (переключатели, ползунки, кнопки действия)
local function addToggle(parent: Instance, title: string, getVal: () -> boolean, setVal: (boolean) -> ())
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -6, 0, 38)
	row.BackgroundColor3 = THEME.BgElement
	row.BorderSizePixel = 0
	row.Parent = parent

	local rCorner = Instance.new("UICorner")
	rCorner.CornerRadius = UDim.new(0, 9)
	rCorner.Parent = row

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -68, 1, 0)
	lbl.Position = UDim2.fromOffset(12, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text = title
	lbl.TextColor3 = THEME.TextMain
	lbl.Font = Enum.Font.GothamMedium
	lbl.TextSize = 12
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = row

	local switchBg = Instance.new("TextButton")
	switchBg.Size = UDim2.fromOffset(44, 22)
	switchBg.Position = UDim2.new(1, -54, 0.5, -11)
	switchBg.BackgroundColor3 = THEME.BgDark
	switchBg.Text = ""
	switchBg.AutoButtonColor = false
	switchBg.Parent = row

	local sCorner = Instance.new("UICorner")
	sCorner.CornerRadius = UDim.new(1, 0)
	sCorner.Parent = switchBg

	local sStroke = Instance.new("UIStroke")
	sStroke.Thickness = 1.4
	sStroke.Color = THEME.TextDim
	sStroke.Parent = switchBg

	local knob = Instance.new("Frame")
	knob.Size = UDim2.fromOffset(16, 16)
	knob.Position = UDim2.fromOffset(3, 3)
	knob.BackgroundColor3 = THEME.TextDim
	knob.BorderSizePixel = 0
	knob.Parent = switchBg

	local kCorner = Instance.new("UICorner")
	kCorner.CornerRadius = UDim.new(1, 0)
	kCorner.Parent = knob

	local function refresh()
		local state = getVal()
		quickTween(knob, 0.2, {
			Position = state and UDim2.fromOffset(25, 3) or UDim2.fromOffset(3, 3),
			BackgroundColor3 = state and THEME.NeonCyan or THEME.TextDim,
		})
		quickTween(sStroke, 0.2, {
			Color = state and THEME.NeonCyan or THEME.TextDim,
		})
	end

	switchBg.MouseButton1Click:Connect(function()
		setVal(not getVal())
		refresh()
	end)

	table.insert(uiRefreshCallbacks, refresh)
	refresh()
end

local function addSlider(parent: Instance, title: string, minV: number, maxV: number, decimals: number, getVal: () -> number, setVal: (number) -> ())
	local box = Instance.new("Frame")
	box.Size = UDim2.new(1, -6, 0, 50)
	box.BackgroundColor3 = THEME.BgElement
	box.BorderSizePixel = 0
	box.Parent = parent

	local bCorner = Instance.new("UICorner")
	bCorner.CornerRadius = UDim.new(0, 9)
	bCorner.Parent = box

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(0.65, 0, 0, 22)
	lbl.Position = UDim2.fromOffset(12, 4)
	lbl.BackgroundTransparency = 1
	lbl.Text = title
	lbl.TextColor3 = THEME.TextMain
	lbl.Font = Enum.Font.GothamMedium
	lbl.TextSize = 12
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = box

	local valLbl = Instance.new("TextLabel")
	valLbl.Size = UDim2.new(0.3, -12, 0, 22)
	valLbl.Position = UDim2.new(0.7, 0, 0, 4)
	valLbl.BackgroundTransparency = 1
	valLbl.TextColor3 = THEME.NeonCyan
	valLbl.Font = Enum.Font.GothamBold
	valLbl.TextSize = 12
	valLbl.TextXAlignment = Enum.TextXAlignment.Right
	valLbl.Parent = box

	local track = Instance.new("Frame")
	track.Size = UDim2.new(1, -24, 0, 8)
	track.Position = UDim2.fromOffset(12, 32)
	track.BackgroundColor3 = THEME.BgDark
	track.BorderSizePixel = 0
	track.Parent = box

	local tCorner = Instance.new("UICorner")
	tCorner.CornerRadius = UDim.new(1, 0)
	tCorner.Parent = track

	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(0.5, 1)
	fill.BackgroundColor3 = THEME.NeonCyan
	fill.BorderSizePixel = 0
	fill.Parent = track

	local fCorner = Instance.new("UICorner")
	fCorner.CornerRadius = UDim.new(1, 0)
	fCorner.Parent = fill

	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new(THEME.NeonCyan, THEME.NeonPurple)
	grad.Parent = fill

	local function refresh()
		local cur = math.clamp(getVal(), minV, maxV)
		local ratio = (cur - minV) / (maxV - minV)
		fill.Size = UDim2.fromScale(ratio, 1)
		valLbl.Text = string.format("%." .. decimals .. "f", cur)
	end

	local dragging = false
	local function updateFromInput(inputPos: Vector3)
		local absPos = track.AbsolutePosition.X
		local absSize = track.AbsoluteSize.X
		if absSize <= 0 then return end
		local pct = math.clamp((inputPos.X - absPos) / absSize, 0, 1)
		local mult = 10 ^ decimals
		local newVal = math.round((minV + (maxV - minV) * pct) * mult) / mult
		setVal(newVal)
		refresh()
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			updateFromInput(input.Position)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			updateFromInput(input.Position)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	table.insert(uiRefreshCallbacks, refresh)
	refresh()
end

local function addActionButton(parent: Instance, title: string, accent: Color3, onClick: () -> ())
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -6, 0, 36)
	btn.BackgroundColor3 = THEME.BgElement
	btn.Text = title
	btn.TextColor3 = accent
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 12
	btn.AutoButtonColor = false
	btn.Parent = parent

	local bCorner = Instance.new("UICorner")
	bCorner.CornerRadius = UDim.new(0, 9)
	bCorner.Parent = btn

	local bStroke = Instance.new("UIStroke")
	bStroke.Thickness = 1.2
	bStroke.Color = accent
	bStroke.Transparency = 0.45
	bStroke.Parent = btn

	btn.MouseButton1Click:Connect(function()
		quickTween(btn, 0.1, { BackgroundColor3 = accent, TextColor3 = THEME.BgDark })
		task.delay(0.12, function()
			quickTween(btn, 0.2, { BackgroundColor3 = THEME.BgElement, TextColor3 = accent })
		end)
		onClick()
	end)
end

