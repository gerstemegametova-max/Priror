--!strict
--[[
    Универсальный отладочный и тренировочный инструментарий для Roblox Studio
    Включает:
    1. Систему захвата цели (Lock-On) с плавной доводкой камеры поверх стандартного контроллера.
    2. Оптимизированный визуальный оверлей (Debug Overlay) с индикатором здоровья,
       мягким свечением, пульсацией при низком HP и лёгкими частицами.
]]

-- ============================================================================
-- 1. БЛОК НАСТРОЕК (КОНФИГУРАЦИЯ)
-- ============================================================================
local CONFIG = {
	-- Настройки Lock-On (Захват цели)
	LOCK_ENABLED = true,
	LOCK_KEY = Enum.UserInputType.MouseButton2, -- Правая кнопка мыши
	LOCK_ALT_KEY = Enum.KeyCode.E,              -- Дополнительная клавиша для тестов
	LOCK_RADIUS_PX = 250,                       -- Радиус поиска цели от центра экрана (px)
	LOCK_SMOOTHNESS = 0.18,                     -- Плавность поворота (0.05 — плавно, 0.5 — резко)
	LOCK_MAX_DISTANCE = 350,                    -- Максимальная дистанция захвата (studs)
	LOCK_TARGET_PART = "HumanoidRootPart",      -- Целевая часть тела персонажа

	-- Настройки Debug Overlay (Оверлей над головой)
	OVERLAY_ENABLED = true,
	OVERLAY_MAX_DISTANCE = 350,                 -- Дистанция скрытия оверлея (studs)
	OVERLAY_OFFSET = Vector3.new(0, 3.2, 0),    -- Смещение над головой персонажа
	OVERLAY_SIZE = UDim2.fromOffset(170, 46),   -- Размер интерфейса в пикселях
	TWEEN_HP_TIME = 0.25,                       -- Скорость анимации изменения полоски HP
	TWEEN_FADE_TIME = 0.35,                     -- Скорость плавного появления оверлея

	-- Цветовая палитра здоровья
	COLOR_HIGH = Color3.fromRGB(72, 235, 130),  -- > 65% HP (Зелёный)
	COLOR_MID = Color3.fromRGB(255, 208, 64),   -- > 30% HP (Жёлтый)
	COLOR_LOW = Color3.fromRGB(245, 70, 85),    -- <= 30% HP (Красный)

	-- Настройки частиц и эффектов
	PARTICLES_ENABLED = true,
	PARTICLE_RATE = 4,                          -- Частота спавна частиц (3-5 для слабых устройств)
	PULSE_SPEED = 7,                            -- Скорость пульсации свечения при низком HP
}

-- ============================================================================
-- 2. СЕРВИСЫ И ПЕРЕМЕННЫЕ СОСТОЯНИЯ
-- ============================================================================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local localPlayer = Players.LocalPlayer
local camera: Camera? = Workspace.CurrentCamera

-- Состояние захвата цели
local isLocking = false
local currentTarget: Model? = nil

-- Реестр активных оверлеев и подключений игроков
type OverlayData = {
	player: Player,
	character: Model,
	humanoid: Humanoid,
	rootPart: BasePart,
	head: BasePart,
	billboard: BillboardGui,
	hpFill: Frame,
	glowStroke: UIStroke,
	glowImage: ImageLabel,
	attachment: Attachment?,
	emitter: ParticleEmitter?,
	connections: { RBXScriptConnection },
	isLowHp: boolean,
	isVisible: boolean,
	fadeReady: boolean,
}

local activeOverlays: { [Player]: OverlayData } = {}
local playerConnections: { [Player]: RBXScriptConnection } = {}

-- ============================================================================
-- 3. МОДУЛЬ DEBUG OVERLAY (СОЗДАНИЕ, ОБНОВЛЕНИЕ, ОЧИСТКА)
-- ============================================================================

-- Возвращает цвет в зависимости от процента здоровья
local function getHealthColor(percent: number): Color3
	if percent > 0.65 then
		return CONFIG.COLOR_HIGH
	elseif percent > 0.30 then
		return CONFIG.COLOR_MID
	else
		return CONFIG.COLOR_LOW
	end
end

-- Плавная синхронизация полоски здоровья и цветов при получении урона/лечении
local function syncOverlay(data: OverlayData)
	local hum = data.humanoid
	if not hum or hum.MaxHealth <= 0 then return end

	local ratio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
	local targetColor = getHealthColor(ratio)
	data.isLowHp = ratio <= 0.30

	-- Если HP восстановилось выше 30%, возвращаем базовую прозрачность свечения
	if not data.isLowHp and data.fadeReady then
		data.glowStroke.Transparency = 0.25
		data.glowImage.ImageTransparency = 0.45
	end

	local tweenInfo = TweenInfo.new(CONFIG.TWEEN_HP_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(data.hpFill, tweenInfo, {
		Size = UDim2.fromScale(ratio, 1),
		BackgroundColor3 = targetColor,
	}):Play()

	TweenService:Create(data.glowStroke, tweenInfo, {
		Color = targetColor,
	}):Play()

	TweenService:Create(data.glowImage, tweenInfo, {
		ImageColor3 = targetColor,
	}):Play()

	if data.emitter then
		data.emitter.Color = ColorSequence.new(targetColor, Color3.new(1, 1, 1))
	end
end

-- Полная очистка UI, частиц и подключений без утечек памяти
local function removeOverlay(player: Player)
	local data = activeOverlays[player]
	if not data then return end

	for _, conn in ipairs(data.connections) do
		if conn.Connected then
			conn:Disconnect()
		end
	end
	table.clear(data.connections)

	if data.billboard and data.billboard.Parent then
		data.billboard:Destroy()
	end

	if data.attachment and data.attachment.Parent then
		data.attachment:Destroy()
	end

	activeOverlays[player] = nil
end

-- Создание BillboardGui и системы частиц для персонажа
local function createOverlay(player: Player, character: Model)
	if not CONFIG.OVERLAY_ENABLED or player == localPlayer then return end

	removeOverlay(player)

	local humanoid = character:WaitForChild("Humanoid", 5) :: Humanoid?
	local head = character:WaitForChild("Head", 5) :: BasePart?
	local rootPart = character:WaitForChild("HumanoidRootPart", 5) :: BasePart?

	-- Защита от гонки потоков, если персонаж успел пересоздаться во время ожидания
	if player.Character ~= character then return end
	if not humanoid or not head or not rootPart or humanoid.Health <= 0 then
		return
	end

	-- 1. Основной контейнер BillboardGui
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "DebugInfoOverlay"
	billboard.Adornee = head
	billboard.Size = CONFIG.OVERLAY_SIZE
	billboard.StudsOffset = CONFIG.OVERLAY_OFFSET
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.MaxDistance = CONFIG.OVERLAY_MAX_DISTANCE
	billboard.ResetOnSpawn = false

	local container = Instance.new("Frame")
	container.Name = "Container"
	container.Size = UDim2.fromScale(1, 1)
	container.BackgroundTransparency = 1
	container.Parent = billboard

	-- Имя игрока (старт с прозрачностью 1 для плавного появления)
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "PlayerName"
	nameLabel.Size = UDim2.new(1, 0, 0.45, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = player.DisplayName
	nameLabel.TextColor3 = Color3.fromRGB(245, 247, 250)
	nameLabel.TextTransparency = 1
	nameLabel.TextStrokeTransparency = 1
	nameLabel.TextStrokeColor3 = Color3.fromRGB(15, 18, 24)
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextSize = 13
	nameLabel.Parent = container

	-- Подложка полоски здоровья
	local barBg = Instance.new("Frame")
	barBg.Name = "BarBackground"
	barBg.Size = UDim2.new(0.86, 0, 0.22, 0)
	barBg.Position = UDim2.new(0.07, 0, 0.54, 0)
	barBg.BackgroundColor3 = Color3.fromRGB(22, 25, 33)
	barBg.BackgroundTransparency = 1
	barBg.BorderSizePixel = 0
	barBg.Parent = container

	local bgCorner = Instance.new("UICorner")
	bgCorner.CornerRadius = UDim.new(1, 0)
	bgCorner.Parent = barBg

	-- Мягкая внешняя обводка (UIStroke)
	local glowStroke = Instance.new("UIStroke")
	glowStroke.Thickness = 1.6
	glowStroke.Transparency = 1
	glowStroke.Color = CONFIG.COLOR_HIGH
	glowStroke.Parent = barBg

	-- Радиальное свечение за полоской (без обрезки границами CanvasGroup)
	local glowImage = Instance.new("ImageLabel")
	glowImage.Name = "SoftGlow"
	glowImage.Size = UDim2.new(1.25, 0, 2.6, 0)
	glowImage.Position = UDim2.fromScale(0.5, 0.5)
	glowImage.AnchorPoint = Vector2.new(0.5, 0.5)
	glowImage.BackgroundTransparency = 1
	glowImage.Image = "rbxassetid://5028857084"
	glowImage.ImageColor3 = CONFIG.COLOR_HIGH
	glowImage.ImageTransparency = 1
	glowImage.ZIndex = 0
	glowImage.Parent = barBg

	-- Заполнение полоски здоровья
	local hpFill = Instance.new("Frame")
	hpFill.Name = "HealthFill"
	hpFill.Size = UDim2.fromScale(1, 1)
	hpFill.BackgroundColor3 = CONFIG.COLOR_HIGH
	hpFill.BackgroundTransparency = 1
	hpFill.BorderSizePixel = 0
	hpFill.ZIndex = 2
	hpFill.Parent = barBg

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = hpFill

	local fillGradient = Instance.new("UIGradient")
	fillGradient.Rotation = 90
	fillGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(195, 195, 195)),
	})
	fillGradient.Parent = hpFill

	billboard.Parent = head

	-- 2. Лёгкие частицы над головой (Attachment + ParticleEmitter)
	local attachment: Attachment? = nil
	local emitter: ParticleEmitter? = nil

	if CONFIG.PARTICLES_ENABLED then
		attachment = Instance.new("Attachment")
		attachment.Name = "DebugParticleAnchor"
		attachment.Position = Vector3.new(0, 1.2, 0)
		attachment.Parent = head

		emitter = Instance.new("ParticleEmitter")
		emitter.Name = "DebugSparks"
		emitter.Texture = "rbxassetid://243660364"
		emitter.Rate = CONFIG.PARTICLE_RATE
		emitter.Lifetime = NumberRange.new(1.0, 1.6)
		emitter.Speed = NumberRange.new(1.2, 2.2)
		emitter.SpreadAngle = Vector2.new(35, 35)
		emitter.Acceleration = Vector3.new(0, 1.5, 0)
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.18),
			NumberSequenceKeypoint.new(0.7, 0.12),
			NumberSequenceKeypoint.new(1, 0),
		})
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.3),
			NumberSequenceKeypoint.new(1, 1),
		})
		emitter.LightEmission = 0.8
		emitter.Parent = attachment
	end

	-- 3. Сохраняем структуру и подписываемся на события
	local data: OverlayData = {
		player = player,
		character = character,
		humanoid = humanoid,
		rootPart = rootPart,
		head = head,
		billboard = billboard,
		hpFill = hpFill,
		glowStroke = glowStroke,
		glowImage = glowImage,
		attachment = attachment,
		emitter = emitter,
		connections = {},
		isLowHp = false,
		isVisible = true,
		fadeReady = false,
	}

	table.insert(data.connections, humanoid.HealthChanged:Connect(function()
		syncOverlay(data)
	end))

	table.insert(data.connections, humanoid.Died:Connect(function()
		removeOverlay(player)
	end))

	table.insert(data.connections, character.AncestryChanged:Connect(function(_, parent)
		if not parent then
			removeOverlay(player)
		end
	end))

	activeOverlays[player] = data
	syncOverlay(data)

	-- Плавное появление элементов (Fade-In)
	local fadeInfo = TweenInfo.new(CONFIG.TWEEN_FADE_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(nameLabel, fadeInfo, { TextTransparency = 0, TextStrokeTransparency = 0.35 }):Play()
	TweenService:Create(barBg, fadeInfo, { BackgroundTransparency = 0.15 }):Play()
	TweenService:Create(hpFill, fadeInfo, { BackgroundTransparency = 0 }):Play()
	TweenService:Create(glowStroke, fadeInfo, { Transparency = 0.25 }):Play()
	TweenService:Create(glowImage, fadeInfo, { ImageTransparency = 0.45 }):Play()

	task.delay(CONFIG.TWEEN_FADE_TIME, function()
		if activeOverlays[player] == data then
			data.fadeReady = true
		end
	end)
end

-- ============================================================================
-- 4. МОДУЛЬ LOCK-ON (ПОИСК ЦЕЛИ И ДОВОДКА КАМЕРЫ)
-- ============================================================================

-- Проверяет, жив ли персонаж и валидна ли его целевая часть
local function isValidTarget(character: Model?): (boolean, BasePart?)
	if not character or not character.Parent then return false, nil end

	local hum = character:FindFirstChildOfClass("Humanoid")
	local targetPart = character:FindFirstChild(CONFIG.LOCK_TARGET_PART) :: BasePart?

	if not hum or hum.Health <= 0 or not targetPart then
		return false, nil
	end

	return true, targetPart
end

-- Ищет ближайшего живого персонажа в радиусе N пикселей от центра экрана
local function findClosestTarget(): Model?
	local activeCam = camera
	if not activeCam then return nil end

	local viewportSize = activeCam.ViewportSize
	local screenCenter = Vector2.new(viewportSize.X * 0.5, viewportSize.Y * 0.5)

	local bestTarget: Model? = nil
	local shortestScreenDist = CONFIG.LOCK_RADIUS_PX
	local camPos = activeCam.CFrame.Position

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer and player.Character then
			local valid, targetPart = isValidTarget(player.Character)
			if valid and targetPart then
				local worldDist = (targetPart.Position - camPos).Magnitude
				if worldDist <= CONFIG.LOCK_MAX_DISTANCE then
					local screenPos, onScreen = activeCam:WorldToViewportPoint(targetPart.Position)
					if onScreen and screenPos.Z > 0 then
						local distFromCenter = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
						if distFromCenter < shortestScreenDist then
							shortestScreenDist = distFromCenter
							bestTarget = player.Character
						end
					end
				end
			end
		end
	end

	return bestTarget
end

-- Обновление камеры (строго после стандартного контроллера камеры)
local function onCameraStep(dt: number)
	if not CONFIG.LOCK_ENABLED or not isLocking then return end

	local activeCam = camera
	if not activeCam then return end

	local valid, targetPart = isValidTarget(currentTarget)
	if not valid or not targetPart then
		currentTarget = findClosestTarget()
		valid, targetPart = isValidTarget(currentTarget)
		if not valid or not targetPart then
			return
		end
	end

	-- Сохраняем стандартный тип управления камерой Custom
	if activeCam.CameraType ~= Enum.CameraType.Custom then
		activeCam.CameraType = Enum.CameraType.Custom
	end

	local camPos = activeCam.CFrame.Position
	local goalCFrame = CFrame.lookAt(camPos, targetPart.Position)

	-- Плавная интерполяция с компенсацией частоты кадров (30 / 60 / 120 FPS)
	local alpha = 1 - math.exp(-CONFIG.LOCK_SMOOTHNESS * 60 * dt)
	activeCam.CFrame = activeCam.CFrame:Lerp(goalCFrame, alpha)
end

-- ============================================================================
-- 5. ЕДИНЫЙ ЦИКЛ ОПТИМИЗИРОВАННОГО ОБНОВЛЕНИЯ (RENDERSTEPPED)
-- ============================================================================
local elapsedAccumulator = 0

local function onRenderStepped(dt: number)
	local activeCam = camera
	if not activeCam then return end

	elapsedAccumulator += dt
	local camPos = activeCam.CFrame.Position
	local pulseWave: number? = nil

	for _, data in pairs(activeOverlays) do
		local root = data.rootPart
		if root and root.Parent then
			local dist = (root.Position - camPos).Magnitude
			local shouldBeVisible = dist <= CONFIG.OVERLAY_MAX_DISTANCE

			-- Переключаем рендер и частицы только в момент пересечения порога дистанции
			if data.isVisible ~= shouldBeVisible then
				data.isVisible = shouldBeVisible
				data.billboard.Enabled = shouldBeVisible
				if data.emitter then
					data.emitter.Enabled = shouldBeVisible
				end
			end

			-- Синусоида вычисляется лениво (1 раз за кадр) и только если в кадре есть раненый игрок
			if shouldBeVisible and data.isLowHp and data.fadeReady then
				if not pulseWave then
					pulseWave = (math.sin(elapsedAccumulator * CONFIG.PULSE_SPEED) + 1) * 0.5
				end
				data.glowStroke.Transparency = 0.1 + (pulseWave * 0.55)
				data.glowImage.ImageTransparency = 0.25 + (pulseWave * 0.55)
			end
		end
	end
end

-- ============================================================================
-- 6. ИНИЦИАЛИЗАЦИЯ, ВВОД И ОЧИСТКА ПРИ ВЫХОДЕ ИГРОКА
-- ============================================================================
local function setupPlayer(player: Player)
	if player == localPlayer then return end

	if player.Character then
		task.spawn(createOverlay, player, player.Character)
	end

	playerConnections[player] = player.CharacterAdded:Connect(function(character)
		createOverlay(player, character)
	end)
end

local function cleanupPlayer(player: Player)
	local conn = playerConnections[player]
	if conn then
		if conn.Connected then
			conn:Disconnect()
		end
		playerConnections[player] = nil
	end
	removeOverlay(player)
end

UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
	if not CONFIG.LOCK_ENABLED then return end
	if input.UserInputType == CONFIG.LOCK_KEY or (not gameProcessed and input.KeyCode == CONFIG.LOCK_ALT_KEY) then
		isLocking = true
		currentTarget = findClosestTarget()
	end
end)

UserInputService.InputEnded:Connect(function(input: InputObject)
	if input.UserInputType == CONFIG.LOCK_KEY or input.KeyCode == CONFIG.LOCK_ALT_KEY then
		isLocking = false
		currentTarget = nil
	end
end)

for _, player in ipairs(Players:GetPlayers()) do
	setupPlayer(player)
end

Players.PlayerAdded:Connect(setupPlayer)
Players.PlayerRemoving:Connect(cleanupPlayer)

Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	camera = Workspace.CurrentCamera
end)

RunService:BindToRenderStep("DebugLockOnCamera", Enum.RenderPriority.Camera.Value + 1, onCameraStep)
RunService.RenderStepped:Connect(onRenderStepped)
