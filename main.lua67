-- ============================================================================
-- 9. АНИМАЦИЯ ОТКРЫТИЯ И ПЕРЕТАСКИВАНИЕ (MOUSE + TOUCH)
-- ============================================================================
local function setMenuVisible(visible: boolean)
	STATE.MenuOpen = visible
	if visible then
		mainFrame.Visible = true
		uiScale.Scale = 0.85
		quickTween(uiScale, 0.26, { Scale = 1 }, Enum.EasingStyle.Back)
	else
		local tw = quickTween(uiScale, 0.16, { Scale = 0.85 }, Enum.EasingStyle.Quad)
		tw.Completed:Once(function()
			if not STATE.MenuOpen then
				mainFrame.Visible = false
			end
		end)
	end
end

local function makeDraggable(dragHandle: GuiObject, moveTarget: GuiObject, onTap: (() -> ())?)
	local dragging = false
	local moved = false
	local dragStart = Vector3.zero
	local startPos = UDim2.new()

	dragHandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			moved = false
			dragStart = input.Position
			startPos = moveTarget.Position
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			if delta.Magnitude > 6 then
				moved = true
			end
			moveTarget.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if dragging and not moved and onTap then
				onTap()
			end
			dragging = false
		end
	end)
end

makeDraggable(header, mainFrame, nil)
makeDraggable(openPill, openPill, function()
	setMenuVisible(not STATE.MenuOpen)
end)
makeDraggable(lockPill, lockPill, function()
	setLockActive(not isLocking)
end)

closeBtn.MouseButton1Click:Connect(function()
	setMenuVisible(false)
end)

-- ============================================================================
-- 10. ЦИКЛ LOCK-ON КАМЕРЫ С УПРЕЖДЕНИЕМ + ФИЗИКА + РЕНДЕР
-- ============================================================================
local function onCameraStep(dt: number)
	local activeCam = camera
	if not activeCam then return end

	if not STATE.LockEnabled or not isLocking then
		fovStroke.Color = getAccentColor()
		lockStatusLabel.Text = ""
		clearLockBeam()
		smoothedLookDir = nil
		return
	end

	local valid, targetPart = isValidTarget(currentTarget)
	if not valid or not targetPart then
		currentTarget = findClosestTarget()
		valid, targetPart = isValidTarget(currentTarget)
		if not valid or not targetPart then
			fovStroke.Color = getAccentColor()
			lockStatusLabel.Text = "SEARCHING..."
			lockStatusLabel.TextColor3 = getAccentColor()
			clearLockBeam()
			smoothedLookDir = nil
			return
		end
	end

	local predictedPos = getPredictedAimPosition(targetPart)
	local zoneTag = (STATE.LockTargetPart == "Head") and "HEAD" or "BODY"

	fovStroke.Color = COLORS.Red
	lockStatusLabel.Text = string.format("LOCKED: %s [%s]", currentTarget and currentTarget.Name or "TARGET", zoneTag)
	lockStatusLabel.TextColor3 = COLORS.Red
	updateLockBeam(targetPart, predictedPos)

	if activeCam.CameraType ~= Enum.CameraType.Custom then
		activeCam.CameraType = Enum.CameraType.Custom
	end

	local curDir: Vector3 = smoothedLookDir or activeCam.CFrame.LookVector
	local alpha = 1 - math.exp(-STATE.LockSmoothness * 45 * dt)
	local focusPos = activeCam.Focus.Position
	local zoomDist = (activeCam.CFrame.Position - focusPos).Magnitude

	if zoomDist > 1.5 then
		local toTarget = predictedPos - focusPos
		if toTarget.Magnitude > 0.01 then
			local lerped = curDir:Lerp(toTarget.Unit, alpha)
			if lerped.Magnitude > 0.001 then
				curDir = lerped.Unit
			end
			local newCamPos = focusPos - curDir * zoomDist
			activeCam.CFrame = CFrame.lookAt(newCamPos, newCamPos + curDir)
		end
	else
		local camPos = activeCam.CFrame.Position
		local toTarget = predictedPos - camPos
		if toTarget.Magnitude > 0.01 then
			local lerped = curDir:Lerp(toTarget.Unit, alpha)
			if lerped.Magnitude > 0.001 then
				curDir = lerped.Unit
			end
			activeCam.CFrame = CFrame.lookAt(camPos, camPos + curDir)
		end
	end

	smoothedLookDir = curDir
end

local function onPhysicsStep()
	if not STATE.NoclipEnabled then return end
	local char = localPlayer.Character
	if not char then return end

	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") and part.CanCollide then
			noclipCachedParts[part] = true
			part.CanCollide = false
		end
	end
end

local elapsedTime = 0
local function updateOverlayList(list: { [any]: EntityOverlay }, camPos: Vector3, pulseWave: number?)
	for _, data in pairs(list) do
		local root = data.rootPart
		if root and root.Parent then
			local maxDist = data.isBot and STATE.BotMaxDistance or STATE.MaxDistance
			local dist = (root.Position - camPos).Magnitude
			local inRange = dist <= maxDist

			local wantOverlay = inRange and (data.isBot and STATE.BotEspEnabled or STATE.PlayerOverlayEnabled)
			local wantChams = inRange and (data.isBot and STATE.BotHighlight or STATE.PlayerHighlight)
			local wantParticles = inRange and (data.isBot and STATE.BotParticles or STATE.ParticlesEnabled)

			data.isVisible = inRange
			data.billboard.Enabled = wantOverlay
			data.highlight.Enabled = wantChams
			data.sparkEmitter.Enabled = wantParticles
			data.auraEmitter.Enabled = wantParticles

			if not data.isBot then
				ensurePlayerTracer(data)
			end

			if wantOverlay then
				if STATE.EspDetailMode == "FULL" then
					data.distLabel.Text = string.format("%dm • %d HP", math.floor(dist * 0.28), math.ceil(data.humanoid.Health))
				end
				if data.isLowHp and data.fadeReady and pulseWave then
					data.glowStroke.Transparency = 0.08 + (pulseWave * 0.55)
				end
			end
		end
	end
end

local function onRenderStepped(dt: number)
	elapsedTime += dt

	local dashRot = (elapsedTime * 55) % 360
	pillGrad.Rotation = dashRot
	if mainFrame.Visible then
		mainBorderGrad.Rotation = dashRot
	end

	local activeCam = camera
	if not activeCam then return end
	local camPos = activeCam.CFrame.Position

	if STATE.FlyEnabled then
		local char = localPlayer.Character
		local root = char and getCharacterRoot(char)
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if root and hum then
			hum.PlatformStand = true
			local moveDir = hum.MoveDirection
			local flyVel = Vector3.zero
			if moveDir.Magnitude > 0.05 then
				local camLook = activeCam.CFrame.LookVector
				local camRight = activeCam.CFrame.RightVector
				local horiz = Vector3.new(camLook.X, 0, camLook.Z)
				local flatLook = (horiz.Magnitude > 0.01) and horiz.Unit or Vector3.new(0, 0, -1)
				flyVel = (camLook * moveDir:Dot(flatLook) + camRight * moveDir:Dot(camRight)) * STATE.FlySpeed
			end
			root.AssemblyLinearVelocity = flyVel
		end
	end

	local pulseWave = (math.sin(elapsedTime * 7.5) + 1) * 0.5
	updateOverlayList(playerOverlays, camPos, pulseWave)
	updateOverlayList(botOverlays, camPos, pulseWave)
end

-- ============================================================================
-- 11. ВВОД, ЖИЗНЕННЫЙ ЦИКЛ И ОЧИСТКА
-- ============================================================================
UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
	if not gameProcessed and (input.KeyCode == STATE.MenuKey or input.KeyCode == STATE.AltMenuKey) then
		setMenuVisible(not STATE.MenuOpen)
		return
	end

	if not STATE.LockEnabled then return end

	if input.UserInputType == STATE.LockKey or (not gameProcessed and input.KeyCode == STATE.LockAltKey) then
		if STATE.LockToggleMode then
			setLockActive(not isLocking)
		else
			setLockActive(true)
		end
		return
	end

	if STATE.LockOnFire and not gameProcessed then
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			setLockActive(true)
		end
	end
end)

UserInputService.InputEnded:Connect(function(input: InputObject)
	if not STATE.LockToggleMode then
		if input.UserInputType == STATE.LockKey or input.KeyCode == STATE.LockAltKey then
			setLockActive(false)
		end
	end

	if STATE.LockOnFire then
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			setLockActive(false)
		end
	end
end)

UserInputService.JumpRequest:Connect(function()
	if not STATE.InfiniteJump then return end
	local char = localPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum and hum:GetState() == Enum.HumanoidStateType.Freefall then
		hum:ChangeState(Enum.HumanoidStateType.Jumping)
	end
end)

localPlayer.CharacterAdded:Connect(function(char)
	table.clear(noclipCachedParts)
	local hum = char:WaitForChild("Humanoid", 5) :: Humanoid?
	if hum then
		hum.WalkSpeed = STATE.CustomWalkSpeed
		hum.UseJumpPower = true
		hum.JumpPower = STATE.CustomJumpPower
	end
end)

local function setupPlayer(player: Player)
	if player == localPlayer then return end
	if player.Character then
		task.spawn(createEntityOverlay, player.Character, player.DisplayName, false, player)
	end
	playerConnections[player] = player.CharacterAdded:Connect(function(character)
		createEntityOverlay(character, player.DisplayName, false, player)
	end)
end

local function cleanupPlayer(player: Player)
	local conn = playerConnections[player]
	if conn and conn.Connected then conn:Disconnect() end
	playerConnections[player] = nil
	removeEntityOverlay(playerOverlays[player])
end

for _, player in ipairs(Players:GetPlayers()) do
	setupPlayer(player)
end
scanWorkspaceBots()

Players.PlayerAdded:Connect(setupPlayer)
Players.PlayerRemoving:Connect(cleanupPlayer)

Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	camera = Workspace.CurrentCamera
end)

RunService:BindToRenderStep("NeonLockOnV34", Enum.RenderPriority.Camera.Value + 1, onCameraStep)
RunService.Stepped:Connect(onPhysicsStep)
RunService.RenderStepped:Connect(onRenderStepped)
