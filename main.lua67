-- ==========================================
-- ОТСЛЕЖИВАНИЕ МОДЕЛЕЙ (ESP + ЦИФРЫ УРОНА)
-- ==========================================
local function updateAllEspVisibility()
	for _, data in pairs(TrackedModels) do
		if data.billboard then
			data.billboard.Enabled = data.isPlayer and State.EspPlayers or State.EspBots
		end
	end
end

local function cleanupModel(model)
	local data = TrackedModels[model]
	if not data then return end
	for _, c in ipairs(data.conns) do
		if c.Connected then c:Disconnect() end
	end
	if data.billboard then
		data.billboard:Destroy()
	end
	TrackedModels[model] = nil
end

local function registerModel(model, isPlayer)
	if not State.ScriptActive or not model or TrackedModels[model] then return end
	if isPlayer and model == localPlayer.Character then return end

	local head = model:WaitForChild("Head", 5)
	local humanoid = model:WaitForChild("Humanoid", 5)
	if not head or not humanoid or not State.ScriptActive then return end

	-- Создаем ESP HP Bar
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "DebugESP"
	billboard.Adornee = head
	billboard.Size = UDim2.new(4, 0, 1.1, 0)
	billboard.StudsOffset = Vector3.new(0, 2.5, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = Config.MaxEspDistance
	billboard.Enabled = isPlayer and State.EspPlayers or State.EspBots

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1, 0, 0.45, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = (isPlayer and "[P] " or "[NPC] ") .. model.Name
	nameLabel.TextColor3 = isPlayer and Color3.fromRGB(100, 190, 255) or Color3.fromRGB(255, 220, 110)
	nameLabel.TextStrokeTransparency = 0.4
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextScaled = true
	nameLabel.Parent = billboard

	local bgFrame = Instance.new("Frame")
	bgFrame.Size = UDim2.new(1, 0, 0.45, 0)
	bgFrame.Position = UDim2.new(0, 0, 0.5, 0)
	bgFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
	bgFrame.BorderSizePixel = 0
	bgFrame.Parent = billboard

	local bar = Instance.new("Frame")
	bar.Size = UDim2.new(1, 0, 1, 0)
	bar.BackgroundColor3 = Color3.fromRGB(65, 215, 95)
	bar.BorderSizePixel = 0
	bar.Parent = bgFrame

	local hpText = Instance.new("TextLabel")
	hpText.Size = UDim2.new(1, 0, 1, 0)
	hpText.BackgroundTransparency = 1
	hpText.TextColor3 = Color3.fromRGB(255, 255, 255)
	hpText.TextStrokeTransparency = 0.4
	hpText.Font = Enum.Font.Code
	hpText.TextScaled = true
	hpText.ZIndex = 2
	hpText.Parent = bgFrame

	local lastHealth = humanoid.Health

	local function refreshHealthUI(newHealth)
		local cur = math.max(0, math.floor(newHealth))
		local max = math.max(1, math.floor(humanoid.MaxHealth))
		local ratio = cur / max
		bar.Size = UDim2.new(ratio, 0, 1, 0)
		bar.BackgroundColor3 = Color3.fromHSV(ratio * 0.33, 0.85, 0.9)
		hpText.Text = cur .. " / " .. max
	end

	refreshHealthUI(lastHealth)
	billboard.Parent = head

	local modelConns = {}
	table.insert(modelConns, humanoid.HealthChanged:Connect(function(newHealth)
		local delta = lastHealth - newHealth
		lastHealth = newHealth
		refreshHealthUI(newHealth)

		if delta > 0.1 then
			spawnDamageNumber(head.Position, delta)
		end
	end))

	table.insert(modelConns, humanoid.Died:Connect(function()
		refreshHealthUI(0)
		task.delay(1.2, function()
			cleanupModel(model)
		end)
	end))

	table.insert(modelConns, model.AncestryChanged:Connect(function(_, parent)
		if not parent then
			cleanupModel(model)
		end
	end))

	TrackedModels[model] = {
		billboard = billboard,
		isPlayer = isPlayer,
		conns = modelConns,
	}
end

-- Инициализация ботов
for _, npc in ipairs(targetsFolder:GetChildren()) do
	task.spawn(registerModel, npc, false)
end
trackConn(targetsFolder.ChildAdded:Connect(function(npc)
	task.spawn(registerModel, npc, false)
end))

-- Инициализация игроков
local function setupPlayer(plr)
	if plr == localPlayer then return end
	if plr.Character then
		task.spawn(registerModel, plr.Character, true)
	end
	trackConn(plr.CharacterAdded:Connect(function(char)
		task.spawn(registerModel, char, true)
	end))
end

for _, plr in ipairs(Players:GetPlayers()) do
	setupPlayer(plr)
end
trackConn(Players.PlayerAdded:Connect(setupPlayer))

-- ==========================================
-- КНОПКИ МЕНЮ
-- ==========================================
createToggleBtn(1, "Aimbot System", State.AimbotEnabled, function(val)
	State.AimbotEnabled = val
	aimBtn.Visible = val
	if not val then
		State.IsAiming = false
		lockedTarget = nil
		aimBtn.Text = "AIM\nOFF"
		aimBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
	end
end)

createToggleBtn(2, "ESP Боты (NPC)", State.EspBots, function(val)
	State.EspBots = val
	updateAllEspVisibility()
end)

createToggleBtn(3, "ESP Игроки", State.EspPlayers, function(val)
	State.EspPlayers = val
	updateAllEspVisibility()
end)

createToggleBtn(4, "Цифры урона", State.DamageNumbers, function(val)
	State.DamageNumbers = val
end)

