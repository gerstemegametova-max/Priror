local activeTabIndex = 1

local function switchTab(index: number)
	activeTabIndex = index
	local accent = getAccentColor()
	for i, page in ipairs(pages) do
		page.Visible = (i == index)
		tabButtons[i].TextColor3 = (i == index) and accent or COLORS.TextDim
	end
	quickTween(tabIndicator, 0.24, {
		Position = UDim2.new((index - 1) * 0.25, 2, 0, 3),
		BackgroundColor3 = accent,
	})
	indStroke.Color = accent
end

for i, name in ipairs(tabNames) do
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0.25, 0, 1, 0)
	btn.Position = UDim2.fromScale((i - 1) * 0.25, 0)
	btn.BackgroundTransparency = 1
	btn.Text = name
	btn.TextColor3 = (i == 1) and getAccentColor() or COLORS.TextDim
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 11
	btn.ZIndex = 2
	btn.Parent = tabBar
	table.insert(tabButtons, btn)

	local page = Instance.new("ScrollingFrame")
	page.Size = UDim2.fromScale(1, 1)
	page.BackgroundTransparency = 1
	page.BorderSizePixel = 0
	page.ScrollBarThickness = 3
	page.ScrollBarImageColor3 = getAccentColor()
	page.AutomaticCanvasSize = Enum.AutomaticSize.Y
	page.CanvasSize = UDim2.new(0, 0, 0, 0)
	page.Visible = (i == 1)
	page.Parent = pagesHolder

	local listLayout = Instance.new("UIListLayout")
	listLayout.Padding = UDim.new(0, 8)
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.Parent = page

	local pad = Instance.new("UIPadding")
	pad.PaddingBottom = UDim.new(0, 8)
	pad.Parent = page

	table.insert(pages, page)
	btn.MouseButton1Click:Connect(function()
		switchTab(i)
	end)
end

local function applyDashedTheme()
	local accent = getAccentColor()
	themeSwitchBtn.Text = (STATE.DashedColorMode == "LIME") and "🟢 LIME" or "🔴 RED"
	themeSwitchBtn.TextColor3 = accent
	tBtnStroke.Color = accent

	openPill.TextColor3 = accent
	pillStroke.Color = accent
	mainStroke.Color = accent
	fovStroke.Color = accent
	tabIndicator.BackgroundColor3 = accent
	indStroke.Color = accent
	tabButtons[activeTabIndex].TextColor3 = accent

	if isLocking then
		lockPill.TextColor3 = accent
		lockPillStroke.Color = accent
	end

	for _, page in ipairs(pages) do
		page.ScrollBarImageColor3 = accent
	end

	for _, data in pairs(playerOverlays) do
		data.boxStroke.Color = accent
		data.distLabel.TextColor3 = accent
		data.highlight.OutlineColor = accent
		if data.tracerBeam then
			data.tracerBeam.Color = ColorSequence.new(accent)
		end
		syncEntityOverlay(data)
	end

	for _, cb in ipairs(uiRefreshCallbacks) do
		cb()
	end
end

themeSwitchBtn.MouseButton1Click:Connect(function()
	STATE.DashedColorMode = (STATE.DashedColorMode == "LIME") and "RED" or "LIME"
	applyDashedTheme()
end)

