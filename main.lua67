local function createToggleBtn(order, text, defaultState, callback)
	local btn = Instance.new("TextButton")
	btn.LayoutOrder = order
	btn.Size = UDim2.new(0, 190, 0, 32)
	btn.Font = Enum.Font.GothamSemibold
	btn.TextSize = 12
	btn.AutoButtonColor = false
	btn.Parent = mainFrame

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = btn

	local active = defaultState
	local function refreshVisual()
		btn.Text = text .. (active and ": ON" or ": OFF")
		btn.BackgroundColor3 = active and Color3.fromRGB(45, 130, 85) or Color3.fromRGB(35, 35, 42)
		btn.TextColor3 = active and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(175, 175, 185)
	end

	refreshVisual()

	trackConn(btn.MouseButton1Click:Connect(function()
		active = not active
		refreshVisual()
		callback(active)
	end))

	return btn
end

-- Плавающая кнопка Aimbot
