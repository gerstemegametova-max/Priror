--!strict
--[[
    NEON DEV & TRAINING SUITE v2.0 (Universal LocalScript)
    Универсальный инструментарий для тестирования механик и полигонов:
    1. Neon Animated UI (поддержка мыши и сенсорного экрана).
    2. Lock-On System + визуальный FOV-круг + неоновый луч до цели.
    3. Debug Overlay + Damage Ghost Bar + Highlight Chams + Neon Sparks.
    4. Physics Lab: WalkSpeed, JumpPower, Air-Jump, Free-Fly, Target TP.
]]

-- ============================================================================
-- 1. СЕРВИСЫ И БАЗОВЫЕ ПЕРЕМЕННЫЕ
-- ============================================================================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local localPlayer = Players.LocalPlayer
local playerGui = localPlayer:WaitForChild("PlayerGui")
local camera: Camera? = Workspace.CurrentCamera

-- ============================================================================
-- 2. РЕАКТИВНАЯ КОНФИГУРАЦИЯ (УПРАВЛЯЕТСЯ ИЗ МЕНЮ В РЕАЛЬНОМ ВРЕМЕНИ)
-- ============================================================================
local STATE = {
	-- Меню
	MenuOpen = false,
	MenuKey = Enum.KeyCode.RightShift,
	AltMenuKey = Enum.KeyCode.K,

	-- Модуль 1: Lock-On
	LockEnabled = true,
	LockToggleMode = false, -- false = зажатие, true = вкл/выкл по нажатию
	LockKey = Enum.UserInputType.MouseButton2,
	LockAltKey = Enum.KeyCode.E,
	LockRadiusPx = 220,
	LockSmoothness = 0.22,
	LockMaxDistance = 350,
	LockTargetPart = "HumanoidRootPart", -- "HumanoidRootPart" или "Head"
	ShowFovCircle = true,
	ShowTargetBeam = true,

	-- Модуль 2: Debug Overlay & Visuals
	OverlayEnabled = true,
	OverlayMaxDistance = 350,
	ShowHighlight = true, -- Неоновая обводка персонажа (Chams)
	ParticlesEnabled = true,
	ParticleRate = 8,

	-- Модуль 3: Physics & Movement Lab
	CustomWalkSpeed = 16,
	CustomJumpPower = 50,
	InfiniteJump = false,
	FlyEnabled = false,
	FlySpeed = 65,
}

-- Неоновая палитра интерфейса
local THEME = {
	BgDark = Color3.fromRGB(13, 15, 22),
	BgPanel = Color3.fromRGB(20, 24, 34),
	BgElement = Color3.fromRGB(28, 33, 46),
	NeonCyan = Color3.fromRGB(0, 245, 212),
	NeonPurple = Color3.fromRGB(168, 85, 247),
	NeonPink = Color3.fromRGB(255, 56, 130),
	TextMain = Color3.fromRGB(245, 248, 255),
	TextDim = Color3.fromRGB(145, 156, 180),
	HpHigh = Color3.fromRGB(52, 245, 152),
	HpMid = Color3.fromRGB(255, 204, 51),
	HpLow = Color3.fromRGB(255, 65, 95),
}

-- Состояние модулей
local isLocking = false
local currentTarget: Model? = nil
local targetBeam: Beam? = nil
local beamAtt0: Attachment? = nil
local beamAtt1: Attachment? = nil

-- Реестр оверлеев
type OverlayData = {
	player: Player,
	character: Model,
	humanoid: Humanoid,
	rootPart: BasePart,
	head: BasePart,
	billboard: BillboardGui,
	hpFill: Frame,
	hpGhost: Frame,
	distLabel: TextLabel,
	glowStroke: UIStroke,
	glowImage: ImageLabel,
	highlight: Highlight,
	attachment: Attachment,
	emitter: ParticleEmitter,
	connections: { RBXScriptConnection },
	lastHealth: number,
	isLowHp: boolean,
	isVisible: boolean,
	fadeReady: boolean,
}

local activeOverlays: { [Player]: OverlayData } = {}
local playerConnections: { [Player]: RBXScriptConnection } = {}
local uiRefreshCallbacks: { () -> () } = {}

-- ============================================================================
-- 3. ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ АНИМАЦИИ И МАТЕМАТИКИ
-- ============================================================================
local function quickTween(inst: Instance, duration: number, props: { [string]: any }, style: Enum.EasingStyle?)
	local info = TweenInfo.new(duration, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	local tw = TweenService:Create(inst, info, props)
	tw:Play()
	return tw
end

local function getHealthColor(percent: number): Color3
	if percent > 0.65 then
		return THEME.HpHigh
	elseif percent > 0.30 then
		return THEME.HpMid
	else
		return THEME.HpLow
	end
end

-- ============================================================================
-- 4. МОДУЛЬ VISUAL OVERLAY (BILLBOARD + GHOST BAR + HIGHLIGHT + PARTICLES)
-- ============================================================================
local function syncOverlay(data: OverlayData)
	local hum = data.humanoid
	if not hum or hum.MaxHealth <= 0 then return end

	local currentHp = hum.Health
	local ratio = math.clamp(currentHp / hum.MaxHealth, 0, 1)
	local targetColor = getHealthColor(ratio)
	data.isLowHp = ratio <= 0.30

	-- Если персонаж получил урон — запускаем вспышку частиц и задержку призрачной полоски
	if currentHp < data.lastHealth then
		if STATE.ParticlesEnabled and data.isVisible then
			data.emitter:Emit(8)
		end
		task.delay(0.22, function()
			if activeOverlays[data.player] == data then
				quickTween(data.hpGhost, 0.35, { Size = UDim2.fromScale(ratio, 1) }, Enum.EasingStyle.Quad)
			end
		end)
	else
		data.hpGhost.Size = UDim2.fromScale(ratio, 1)
	end
	data.lastHealth = currentHp

	if not data.isLowHp and data.fadeReady then
		data.glowStroke.Transparency = 0.2
		data.glowImage.ImageTransparency = 0.4
	end

	quickTween(data.hpFill, 0.22, {
		Size = UDim2.fromScale(ratio, 1),
		BackgroundColor3 = targetColor,
	}, Enum.EasingStyle.Quad)

	quickTween(data.glowStroke, 0.22, { Color = targetColor }, Enum.EasingStyle.Quad)
	quickTween(data.glowImage, 0.22, { ImageColor3 = targetColor }, Enum.EasingStyle.Quad)

	data.highlight.OutlineColor = targetColor
	data.highlight.FillColor = targetColor
	data.emitter.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, targetColor),
		ColorSequenceKeypoint.new(0.6, THEME.NeonCyan),
		ColorSequenceKeypoint.new(1, Color3.new(1, 1, 1)),
	})
end

local function removeOverlay(player: Player)
	local data = activeOverlays[player]
	if not data then return end

	for _, conn in ipairs(data.connections) do
		if conn.Connected then
			conn:Disconnect()
		end
	end
	table.clear(data.connections)

	if data.billboard and data.billboard.Parent then data.billboard:Destroy() end
	if data.highlight and data.highlight.Parent then data.highlight:Destroy() end
	if data.attachment and data.attachment.Parent then data.attachment:Destroy() end

	activeOverlays[player] = nil
end

local function createOverlay(player: Player, character: Model)
	if player == localPlayer then return end
	removeOverlay(player)

	local humanoid = character:WaitForChild("Humanoid", 5) :: Humanoid?
	local head = character:WaitForChild("Head", 5) :: BasePart?
	local rootPart = character:WaitForChild("HumanoidRootPart", 5) :: BasePart?

	if player.Character ~= character then return end
	if not humanoid or not head or not rootPart or humanoid.Health <= 0 then return end

	-- 1. BillboardGui над головой
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "NeonDebugOverlay"
	billboard.Adornee = head
	billboard.Size = UDim2.fromOffset(185, 54)
	billboard.StudsOffset = Vector3.new(0, 3.3, 0)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.MaxDistance = STATE.OverlayMaxDistance
	billboard.Enabled = STATE.OverlayEnabled
	billboard.ResetOnSpawn = false

	local container = Instance.new("Frame")
	container.Size = UDim2.fromScale(1, 1)
	container.BackgroundTransparency = 1
	container.Parent = billboard

	-- Имя + дистанция
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1, 0, 0.42, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = player.DisplayName
	nameLabel.TextColor3 = THEME.TextMain
	nameLabel.TextTransparency = 1
	nameLabel.TextStrokeTransparency = 1
	nameLabel.TextStrokeColor3 = Color3.fromRGB(10, 12, 18)
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextSize = 13
	nameLabel.Parent = container

	local distLabel = Instance.new("TextLabel")
	distLabel.Size = UDim2.new(1, 0, 0.3, 0)
	distLabel.Position = UDim2.fromScale(0, 0.72)
	distLabel.BackgroundTransparency = 1
	distLabel.Text = "0m • 100 HP"
	distLabel.TextColor3 = THEME.NeonCyan
	distLabel.TextTransparency = 1
	distLabel.TextStrokeTransparency = 1
	distLabel.Font = Enum.Font.GothamMedium
	distLabel.TextSize = 10
	distLabel.Parent = container

	-- Подложка полоски HP
	local barBg = Instance.new("Frame")
	barBg.Size = UDim2.new(0.86, 0, 0.2, 0)
	barBg.Position = UDim2.new(0.07, 0, 0.46, 0)
	barBg.BackgroundColor3 = Color3.fromRGB(16, 18, 26)
	barBg.BackgroundTransparency = 1
	barBg.BorderSizePixel = 0
	barBg.Parent = container

	local bgCorner = Instance.new("UICorner")
	bgCorner.CornerRadius = UDim.new(1, 0)
	bgCorner.Parent = barBg

	local glowStroke = Instance.new("UIStroke")
	glowStroke.Thickness = 1.6
	glowStroke.Transparency = 1
	glowStroke.Color = THEME.HpHigh
	glowStroke.Parent = barBg

	local glowImage = Instance.new("ImageLabel")
	glowImage.Size = UDim2.new(1.3, 0, 2.8, 0)
	glowImage.Position = UDim2.fromScale(0.5, 0.5)
	glowImage.AnchorPoint = Vector2.new(0.5, 0.5)
	glowImage.BackgroundTransparency = 1
	glowImage.Image = "rbxassetid://5028857084"
	glowImage.ImageColor3 = THEME.HpHigh
	glowImage.ImageTransparency = 1
	glowImage.ZIndex = 0
	glowImage.Parent = barBg

	-- Призрачная полоска урона (белая)
	local hpGhost = Instance.new("Frame")
	hpGhost.Size = UDim2.fromScale(1, 1)
	hpGhost.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	hpGhost.BackgroundTransparency = 1
	hpGhost.BorderSizePixel = 0
	hpGhost.ZIndex = 1
	hpGhost.Parent = barBg

	local ghostCorner = Instance.new("UICorner")
	ghostCorner.CornerRadius = UDim.new(1, 0)
	ghostCorner.Parent = hpGhost

	-- Основная полоска HP
	local hpFill = Instance.new("Frame")
	hpFill.Size = UDim2.fromScale(1, 1)
	hpFill.BackgroundColor3 = THEME.HpHigh
	hpFill.BackgroundTransparency = 1
	hpFill.BorderSizePixel = 0
	hpFill.ZIndex = 2
	hpFill.Parent = barBg

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = hpFill

	billboard.Parent = head

	-- 2. Неоновая обводка персонажа (Highlight Chams)
	local highlight = Instance.new("Highlight")
	highlight.Name = "NeonCharHighlight"
	highlight.Adornee = character
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillColor = THEME.HpHigh
	highlight.FillTransparency = 0.82
	highlight.OutlineColor = THEME.HpHigh
	highlight.OutlineTransparency = 0.15
	highlight.Enabled = STATE.ShowHighlight
	highlight.Parent = character

	-- 3. Исправленные неоновые частицы над головой (100% видимые в любом плейсе)
	local attachment = Instance.new("Attachment")
	attachment.Name = "NeonParticleAnchor"
	attachment.Position = Vector3.new(0, 1.35, 0)
	attachment.Parent = head

	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "NeonSparks"
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds" -- Встроенная текстура движка
	emitter.Rate = STATE.ParticleRate
	emitter.Enabled = STATE.ParticlesEnabled
	emitter.Lifetime = NumberRange.new(1.1, 1.8)
	emitter.Speed = NumberRange.new(1.8, 3.2)
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.SpreadAngle = Vector2.new(45, 45)
	emitter.Acceleration = Vector3.new(0, 2.2, 0)
	emitter.Drag = 1.5
	emitter.RotSpeed = NumberRange.new(-120, 120)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.45),
		NumberSequenceKeypoint.new(0.65, 0.28),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(0.8, 0.4),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.LightEmission = 1
	emitter.LightInfluence = 0
	emitter.ZOffset = 0.5
	emitter.Parent = attachment

	local data: OverlayData = {
		player = player,
		character = character,
		humanoid = humanoid,
		rootPart = rootPart,
		head = head,
		billboard = billboard,
		hpFill = hpFill,
		hpGhost = hpGhost,
		distLabel = distLabel,
		glowStroke = glowStroke,
		glowImage = glowImage,
		highlight = highlight,
		attachment = attachment,
		emitter = emitter,
		connections = {},
		lastHealth = humanoid.Health,
		isLowHp = false,
		isVisible = true,
		fadeReady = false,
	}

	table.insert(data.connections, humanoid.HealthChanged:Connect(function()
		syncOverlay(data)
	end))

	table.insert(data.connections, humanoid.Died:Connect(function()
		removeOverlay(player)
	end))

	table.insert(data.connections, character.AncestryChanged:Connect(function(_, parent)
		if not parent then
			removeOverlay(player)
		end
	end))

	activeOverlays[player] = data
	syncOverlay(data)

	-- Плавное появление Fade-In
	quickTween(nameLabel, 0.35, { TextTransparency = 0, TextStrokeTransparency = 0.35 }, Enum.EasingStyle.Quad)
	quickTween(distLabel, 0.35, { TextTransparency = 0.1, TextStrokeTransparency = 0.5 }, Enum.EasingStyle.Quad)
	quickTween(barBg, 0.35, { BackgroundTransparency = 0.15 }, Enum.EasingStyle.Quad)
	quickTween(hpGhost, 0.35, { BackgroundTransparency = 0.35 }, Enum.EasingStyle.Quad)
	quickTween(hpFill, 0.35, { BackgroundTransparency = 0 }, Enum.EasingStyle.Quad)
	quickTween(glowStroke, 0.35, { Transparency = 0.2 }, Enum.EasingStyle.Quad)
	quickTween(glowImage, 0.35, { ImageTransparency = 0.4 }, Enum.EasingStyle.Quad)

	task.delay(0.35, function()
		if activeOverlays[player] == data then
			data.fadeReady = true
		end
	end)
end

-- ============================================================================
-- 5. МОДУЛЬ LOCK-ON + НЕОНОВЫЙ ЛУЧ (BEAM)
-- ============================================================================
local function clearTargetBeam()
	if targetBeam then targetBeam:Destroy(); targetBeam = nil end
	if beamAtt0 then beamAtt0:Destroy(); beamAtt0 = nil end
	if beamAtt1 then beamAtt1:Destroy(); beamAtt1 = nil end
end

local function updateTargetBeam(targetPart: BasePart?)
	if not STATE.ShowTargetBeam or not isLocking or not targetPart then
		clearTargetBeam()
		return
	end

	local myChar = localPlayer.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not myRoot then
		clearTargetBeam()
		return
	end

	if not targetBeam or not beamAtt0 or not beamAtt1 or beamAtt1.Parent ~= targetPart or beamAtt0.Parent ~= myRoot then
		clearTargetBeam()
		beamAtt0 = Instance.new("Attachment")
		beamAtt0.Parent = myRoot

		beamAtt1 = Instance.new("Attachment")
		beamAtt1.Parent = targetPart

		local beam = Instance.new("Beam")
		beam.Name = "NeonLockBeam"
		beam.Attachment0 = beamAtt0
		beam.Attachment1 = beamAtt1
		beam.Width0 = 0.16
		beam.Width1 = 0.08
		beam.FaceCamera = true
		beam.LightEmission = 1
		beam.LightInfluence = 0
		beam.Color = ColorSequence.new(THEME.NeonCyan, THEME.NeonPink)
		beam.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.6),
			NumberSequenceKeypoint.new(0.5, 0.15),
			NumberSequenceKeypoint.new(1, 0.1),
		})
		beam.Parent = myRoot
		targetBeam = beam
	end
end

local function isValidTarget(character: Model?): (boolean, BasePart?)
	if not character or not character.Parent then return false, nil end
	local hum = character:FindFirstChildOfClass("Humanoid")
	local targetPart = (character:FindFirstChild(STATE.LockTargetPart) or character:FindFirstChild("HumanoidRootPart")) :: BasePart?
	if not hum or hum.Health <= 0 or not targetPart then
		return false, nil
	end
	return true, targetPart
end

local function findClosestTarget(): Model?
	local activeCam = camera
	if not activeCam then return nil end

	local viewportSize = activeCam.ViewportSize
	local screenCenter = Vector2.new(viewportSize.X * 0.5, viewportSize.Y * 0.5)

	local bestTarget: Model? = nil
	local shortestScreenDist = STATE.LockRadiusPx
	local camPos = activeCam.CFrame.Position

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer and player.Character then
			local valid, targetPart = isValidTarget(player.Character)
			if valid and targetPart then
				local worldDist = (targetPart.Position - camPos).Magnitude
				if worldDist <= STATE.LockMaxDistance then
					local screenPos, onScreen = activeCam:WorldToViewportPoint(targetPart.Position)
					if onScreen and screenPos.Z > 0 then
						local distFromCenter = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
						if distFromCenter < shortestScreenDist then
							shortestScreenDist = distFromCenter
							bestTarget = player.Character
						end
					end
				end
			end
		end
	end

	return bestTarget
end

