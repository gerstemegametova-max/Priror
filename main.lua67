local function setLockActive(active: boolean)
	if not STATE.LockEnabled then
		active = false
	end
	isLocking = active
	if active then
		currentTarget = findClosestTarget()
		smoothedLookDir = nil
		lockPill.Text = "🎯 LOCK: ON"
		lockPill.TextColor3 = getAccentColor()
		lockPillStroke.Color = getAccentColor()
	else
		currentTarget = nil
		smoothedLookDir = nil
		clearLockBeam()
		lockStatusLabel.Text = ""
		lockPill.Text = "🎯 LOCK: OFF"
		lockPill.TextColor3 = COLORS.TextDim
		lockPillStroke.Color = COLORS.TextDim
	end
end

