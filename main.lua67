-- ==========================================
-- LOCK-ON SYSTEM (ПКМ ИЛИ КНОПКА AIM)
-- ==========================================
local function getClosestTarget()
	local viewportSize = camera.ViewportSize
	local screenCenter = Vector2.new(viewportSize.X * 0.5, viewportSize.Y * 0.5)
	local closestPart = nil
	local shortestDistance = Config.AimRadius

	local function checkModel(model)
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		local part = model:FindFirstChild(Config.TargetPart)
		if humanoid and humanoid.Health > 0 and part then
			local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
			if onScreen then
				local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
				if dist < shortestDistance then
					shortestDistance = dist
					closestPart = part
				end
			end
		end
	end

	for _, npc in ipairs(targetsFolder:GetChildren()) do
		checkModel(npc)
	end

	if State.EspPlayers then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= localPlayer and plr.Character then
				checkModel(plr.Character)
			end
		end
	end

	return closestPart
end

local function setAimingState(active)
	if not State.AimbotEnabled then return end
	State.IsAiming = active
	if active then
		lockedTarget = getClosestTarget()
		aimBtn.Text = "AIM\nLOCKED"
		aimBtn.BackgroundColor3 = Color3.fromRGB(45, 140, 85)
	else
		lockedTarget = nil
		aimBtn.Text = "AIM\nOFF"
		aimBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
	end
end

trackConn(UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		setAimingState(true)
	end
end))

trackConn(UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		setAimingState(false)
	end
end))

trackConn(aimBtn.MouseButton1Click:Connect(function()
	setAimingState(not State.IsAiming)
end))

-- ==========================================
-- ЕДИНЫЙ ЦИКЛ RENDERSTEPPED (AIMBOT + ЦИФРЫ УРОНА)
-- ==========================================
trackConn(RunService.RenderStepped:Connect(function(dt)
	if not State.ScriptActive then return end

	-- 1. Обновление активных цифр урона
	local dmgCount = #activeDmgList
	if dmgCount > 0 then
		for i = dmgCount, 1, -1 do
			local item = activeDmgList[i]
			item.elapsed += dt

			if item.elapsed >= Config.DmgLifetime then
				item.billboard.Enabled = false
				table.remove(activeDmgList, i)
				table.insert(inactiveDmgPool, item)
			else
				local progress = item.elapsed / Config.DmgLifetime
				local currentY = Config.DmgFloatSpeed * (1 - (1 - progress) ^ 2)
				item.part.Position = item.startPos + Vector3.new(item.offsetX, currentY, item.offsetZ)

				if progress > 0.65 then
					local fade = (progress - 0.65) / 0.35
					item.label.TextTransparency = fade
					item.label.TextStrokeTransparency = 0.2 + (0.8 * fade)
				end
			end
		end
	end

	-- 2. Доводка камеры (Aimbot)
	if State.AimbotEnabled and State.IsAiming then
		if not lockedTarget or not lockedTarget.Parent then
			lockedTarget = getClosestTarget()
		end

		if lockedTarget then
			local hum = lockedTarget.Parent:FindFirstChildOfClass("Humanoid")
			if not hum or hum.Health <= 0 then
				lockedTarget = getClosestTarget()
			else
				local currentCF = camera.CFrame
				local targetCF = CFrame.lookAt(currentCF.Position, lockedTarget.Position)
				camera.CFrame = currentCF:Lerp(targetCF, Config.Smoothness)
			end
		end
	end
end))

-- ==========================================
-- ПОЛНАЯ ДЕАКТИВАЦИЯ СКРИПТА (KILL-SWITCH)
-- ==========================================
unloadBtn.MouseButton1Click:Connect(function()
	State.ScriptActive = false
	State.IsAiming = false
	lockedTarget = nil

	for _, conn in ipairs(Connections) do
		if conn.Connected then
			conn:Disconnect()
		end
	end
	table.clear(Connections)

	for model in pairs(TrackedModels) do
		cleanupModel(model)
	end

	if dmgFolder then
		dmgFolder:Destroy()
	end

	if screenGui then
		screenGui:Destroy()
	end
end)
