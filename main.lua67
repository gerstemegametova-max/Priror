--!strict
--[[
    NEON DEV & TRAINING SUITE v3.4 (Universal LocalScript)
    Модули:
    1. Neon Dashed UI (пунктирная рамка меню, переключатель Lime / Red, анимации).
    2. Lock-On System (раздельный выбор Голова / Тело, упреждение по скорости цели, FOV-круг).
    3. Players Visuals (настройка объёма информации плашек, масштаб, 3D-лучи, Chams, частицы).
    4. Bot / NPC ESP (автопоиск NPC в Workspace, компактные плашки, подсветка, частицы).
    5. Physics Lab (WalkSpeed, JumpPower, Air-Jump, Free-Fly, Noclip, Teleport).
]]

-- ============================================================================
-- 1. СЕРВИСЫ И БАЗОВЫЕ ПЕРЕМЕННЫЕ
-- ============================================================================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local localPlayer = Players.LocalPlayer
local playerGui = localPlayer:WaitForChild("PlayerGui")
local camera: Camera? = Workspace.CurrentCamera

-- ============================================================================
-- 2. КОНФИГУРАЦИЯ И СОСТОЯНИЕ МОДУЛЕЙ
-- ============================================================================
local STATE = {
	-- Меню и тема пунктира
	MenuOpen = false,
	MenuKey = Enum.KeyCode.RightShift,
	AltMenuKey = Enum.KeyCode.K,
	DashedColorMode = "LIME", -- "LIME" или "RED"

	-- Вкладка 1: Lock-On
	LockEnabled = true,
	LockToggleMode = false,
	LockOnFire = false,
	LockIncludeBots = true,
	LockKey = Enum.UserInputType.MouseButton2,
	LockAltKey = Enum.KeyCode.E,
	LockRadiusPx = 240,
	LockSmoothness = 0.30,
	LockMaxDistance = 400,
	LockTargetPart = "Head", -- "Head" (Голова) или "HumanoidRootPart" (Тело)
	LockPredictionEnabled = true,
	LockPredictionTime = 0.16,
	ShowFovCircle = true,
	ShowLockBeam = true,

	-- Общие настройки плашек ESP (уменьшение информации и размер)
	EspDetailMode = "COMPACT", -- "FULL" (всё), "COMPACT" (имя + HP), "MINIMAL" (только полоска HP)
	EspScale = 0.85,           -- Масштаб плашек (0.55 - 1.30)

	-- Вкладка 2: Players
	PlayerOverlayEnabled = true,
	PlayerDashedTracers = true,
	PlayerHighlight = true,
	ParticlesEnabled = true,
	MaxDistance = 350,

	-- Вкладка 3: Bot ESP
	BotEspEnabled = true,
	BotHighlight = true,
	BotParticles = true,
	BotMaxDistance = 350,

	-- Вкладка 4: Physics Lab
	CustomWalkSpeed = 16,
	CustomJumpPower = 50,
	InfiniteJump = false,
	FlyEnabled = false,
	FlySpeed = 65,
	NoclipEnabled = false,
}

local COLORS = {
	BgDark = Color3.fromRGB(12, 14, 20),
	BgPanel = Color3.fromRGB(19, 23, 33),
	BgElement = Color3.fromRGB(27, 32, 45),
	Lime = Color3.fromRGB(163, 255, 18),
	Red = Color3.fromRGB(255, 42, 72),
	Cyan = Color3.fromRGB(0, 240, 255),
	Purple = Color3.fromRGB(175, 90, 255),
	TextMain = Color3.fromRGB(245, 248, 255),
	TextDim = Color3.fromRGB(145, 156, 180),
	HpHigh = Color3.fromRGB(163, 255, 18),
	HpMid = Color3.fromRGB(255, 204, 51),
	HpLow = Color3.fromRGB(255, 42, 72),
}

local function getAccentColor(): Color3
	return (STATE.DashedColorMode == "LIME") and COLORS.Lime or COLORS.Red
end

-- Состояние Lock-On и Noclip
local isLocking = false
local currentTarget: Model? = nil
local smoothedLookDir: Vector3? = nil
local lockBeam: Beam? = nil
local lockAtt0: Attachment? = nil
local lockAtt1: Attachment? = nil
local noclipCachedParts: { [BasePart]: boolean } = {}

type EntityOverlay = {
	key: Instance,
	displayName: string,
	isBot: boolean,
	character: Model,
	humanoid: Humanoid,
	rootPart: BasePart,
	head: BasePart,
	billboard: BillboardGui,
	card: Frame,
	boxStroke: UIStroke,
	nameLabel: TextLabel,
	barBg: Frame,
	hpFill: Frame,
	hpGhost: Frame,
	distLabel: TextLabel,
	glowStroke: UIStroke,
	highlight: Highlight,
	headAttachment: Attachment,
	sparkEmitter: ParticleEmitter,
	bodyAttachment: Attachment,
	auraEmitter: ParticleEmitter,
	tracerBeam: Beam?,
	tracerAtt0: Attachment?,
	tracerAtt1: Attachment?,
	connections: { RBXScriptConnection },
	lastHealth: number,
	isLowHp: boolean,
	isVisible: boolean,
	fadeReady: boolean,
}

local playerOverlays: { [Player]: EntityOverlay } = {}
local botOverlays: { [Model]: EntityOverlay } = {}
local playerConnections: { [Player]: RBXScriptConnection } = {}
local uiRefreshCallbacks: { () -> () } = {}

-- ============================================================================
-- 3. ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ (TWEEN, ПУНКТИР, ЧАСТИ ТЕЛА, УПРЕЖДЕНИЕ)
-- ============================================================================
local function quickTween(inst: Instance, duration: number, props: { [string]: any }, style: Enum.EasingStyle?)
	local info = TweenInfo.new(duration, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	local tw = TweenService:Create(inst, info, props)
	tw:Play()
	return tw
end

local function buildDashedSequence(dashes: number): NumberSequence
	local count = math.clamp(dashes, 2, 4)
	local keypoints: { NumberSequenceKeypoint } = {}
	local step = 1 / count

	for i = 0, count - 1 do
		local t0 = i * step
		local t1 = t0 + step * 0.55
		local t2 = t0 + step * 0.57
		local t3 = (i + 1) * step - 0.004

		table.insert(keypoints, NumberSequenceKeypoint.new(math.clamp(t0, 0, 1), 0))
		table.insert(keypoints, NumberSequenceKeypoint.new(math.clamp(t1, 0, 1), 0))
		table.insert(keypoints, NumberSequenceKeypoint.new(math.clamp(t2, 0, 1), 1))
		table.insert(keypoints, NumberSequenceKeypoint.new(math.clamp(t3, 0, 1), 1))
	end
	table.insert(keypoints, NumberSequenceKeypoint.new(1, 1))
	return NumberSequence.new(keypoints)
end

local DASHED_UI_TRANSPARENCY = buildDashedSequence(4)
local DASHED_BEAM_TRANSPARENCY = buildDashedSequence(4)

local function attachDashedStroke(target: GuiObject, thickness: number, color: Color3): (UIStroke, UIGradient)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = thickness
	stroke.Color = color
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = target

	local grad = Instance.new("UIGradient")
	grad.Transparency = DASHED_UI_TRANSPARENCY
	grad.Parent = stroke

	return stroke, grad
end

local function getHealthColor(percent: number): Color3
	if percent > 0.65 then
		return COLORS.HpHigh
	elseif percent > 0.30 then
		return COLORS.HpMid
	else
		return COLORS.HpLow
	end
end

local function getCharacterRoot(character: Model): BasePart?
	local root = character:FindFirstChild("HumanoidRootPart")
		or character:FindFirstChild("Torso")
		or character:FindFirstChild("UpperTorso")
		or character.PrimaryPart
		or character:FindFirstChildWhichIsA("BasePart")
	return root :: BasePart?
end

local function getTargetAimPart(character: Model): BasePart?
	if STATE.LockTargetPart == "Head" then
		local head = character:FindFirstChild("Head")
		if head and head:IsA("BasePart") then
			return head
		end
	end
	return getCharacterRoot(character)
end

local function getPredictedAimPosition(targetPart: BasePart): Vector3
	if not STATE.LockPredictionEnabled or STATE.LockPredictionTime <= 0 then
		return targetPart.Position
	end

	local vel = targetPart.AssemblyLinearVelocity
	if vel.Magnitude < 0.5 then
		return targetPart.Position
	end

	local leadVector = Vector3.new(vel.X, vel.Y * 0.6, vel.Z) * STATE.LockPredictionTime
	return targetPart.Position + leadVector
end

local function disableNoclip()
	STATE.NoclipEnabled = false
	for part, wasCollidable in pairs(noclipCachedParts) do
		if part and part.Parent then
			part.CanCollide = wasCollidable
		end
	end
	table.clear(noclipCachedParts)
end

-- ============================================================================
-- 4. МОДУЛЬ ОВЕРЛЕЕВ (УМЕНЬШЕНИЕ ИНФОРМАЦИИ ПЛАШЕК + ЛУЧИ + ЧАСТИЦЫ)
-- ============================================================================

-- Применяет выбранный режим объёма информации (FULL / COMPACT / MINIMAL) и масштаб к плашке
local function applyOverlayCompactness(data: EntityOverlay)
	local s = STATE.EspScale
	local mode = STATE.EspDetailMode

	if mode == "FULL" then
		data.billboard.Size = UDim2.fromOffset(math.round(184 * s), math.round(54 * s))
		data.billboard.StudsOffset = Vector3.new(0, 3.2, 0)
		data.card.BackgroundTransparency = 0.42
		data.boxStroke.Enabled = true
		data.nameLabel.Visible = true
		data.nameLabel.Size = UDim2.new(1, -8, 0.40, 0)
		data.nameLabel.Position = UDim2.fromOffset(4, 2)
		data.nameLabel.TextSize = math.max(9, math.round(12 * s))
		data.barBg.Size = UDim2.new(0.88, 0, 0.18, 0)
		data.barBg.Position = UDim2.new(0.06, 0, 0.46, 0)
		data.distLabel.Visible = true
		data.distLabel.TextSize = math.max(8, math.round(10 * s))
	elseif mode == "COMPACT" then
		-- Компактная плашка: убираем нижнюю строку (дистанцию и цифры HP), сжимаем карточку
		data.billboard.Size = UDim2.fromOffset(math.round(132 * s), math.round(34 * s))
		data.billboard.StudsOffset = Vector3.new(0, 2.8, 0)
		data.card.BackgroundTransparency = 0.48
		data.boxStroke.Enabled = true
		data.nameLabel.Visible = true
		data.nameLabel.Size = UDim2.new(1, -6, 0.52, 0)
		data.nameLabel.Position = UDim2.fromOffset(3, 1)
		data.nameLabel.TextSize = math.max(9, math.round(11 * s))
		data.barBg.Size = UDim2.new(0.88, 0, 0.24, 0)
		data.barBg.Position = UDim2.new(0.06, 0, 0.62, 0)
		data.distLabel.Visible = false
	else
		-- MINIMAL: только аккуратная полоска HP без текста и фона карточки
		data.billboard.Size = UDim2.fromOffset(math.round(88 * s), math.round(14 * s))
		data.billboard.StudsOffset = Vector3.new(0, 2.5, 0)
		data.card.BackgroundTransparency = 1
		data.boxStroke.Enabled = false
		data.nameLabel.Visible = false
		data.distLabel.Visible = false
		data.barBg.Size = UDim2.new(0.92, 0, 0.56, 0)
		data.barBg.Position = UDim2.new(0.04, 0, 0.22, 0)
	end
end

local function refreshAllOverlayLayouts()
	for _, data in pairs(playerOverlays) do
		applyOverlayCompactness(data)
	end
	for _, data in pairs(botOverlays) do
		applyOverlayCompactness(data)
	end
end

local function destroyTracer(data: EntityOverlay)
	if data.tracerBeam then data.tracerBeam:Destroy(); data.tracerBeam = nil end
	if data.tracerAtt0 then data.tracerAtt0:Destroy(); data.tracerAtt0 = nil end
	if data.tracerAtt1 then data.tracerAtt1:Destroy(); data.tracerAtt1 = nil end
end

local function ensurePlayerTracer(data: EntityOverlay)
	if data.isBot or not STATE.PlayerDashedTracers or not data.isVisible then
		destroyTracer(data)
		return
	end

	local myChar = localPlayer.Character
	local myRoot = myChar and getCharacterRoot(myChar)
	if not myRoot then
		destroyTracer(data)
		return
	end

	if not data.tracerBeam or not data.tracerAtt0 or data.tracerAtt0.Parent ~= myRoot or not data.tracerAtt1 or data.tracerAtt1.Parent ~= data.rootPart then
		destroyTracer(data)

		local att0 = Instance.new("Attachment")
		att0.Parent = myRoot

		local att1 = Instance.new("Attachment")
		att1.Parent = data.rootPart

		local beam = Instance.new("Beam")
		beam.Attachment0 = att0
		beam.Attachment1 = att1
		beam.Width0 = 0.14
		beam.Width1 = 0.14
		beam.FaceCamera = true
		beam.LightEmission = 1
		beam.LightInfluence = 0
		beam.Texture = "rbxasset://textures/ui/Scroll/scroll-middle.png"
		beam.TextureMode = Enum.TextureMode.Wrap
		beam.TextureLength = 4
		beam.TextureSpeed = 1.8
		beam.Color = ColorSequence.new(getAccentColor())
		beam.Transparency = DASHED_BEAM_TRANSPARENCY
		beam.Parent = myRoot

		data.tracerAtt0 = att0
		data.tracerAtt1 = att1
		data.tracerBeam = beam
	else
		data.tracerBeam.Color = ColorSequence.new(getAccentColor())
	end
end

local function syncEntityOverlay(data: EntityOverlay)
	local hum = data.humanoid
	if not hum or hum.MaxHealth <= 0 then return end

	local currentHp = hum.Health
	local ratio = math.clamp(currentHp / hum.MaxHealth, 0, 1)
	local hpColor = getHealthColor(ratio)
	local accentColor = getAccentColor()
	data.isLowHp = ratio <= 0.30

	if currentHp < data.lastHealth then
		if data.isVisible then
			if (data.isBot and STATE.BotParticles) or (not data.isBot and STATE.ParticlesEnabled) then
				data.sparkEmitter:Emit(7)
				data.auraEmitter:Emit(5)
			end
		end
		task.delay(0.2, function()
			if data.billboard and data.billboard.Parent then
				quickTween(data.hpGhost, 0.32, { Size = UDim2.fromScale(ratio, 1) }, Enum.EasingStyle.Quad)
			end
		end)
	else
		data.hpGhost.Size = UDim2.fromScale(ratio, 1)
	end
	data.lastHealth = currentHp

	if not data.isLowHp and data.fadeReady then
		data.glowStroke.Transparency = 0.25
	end

	quickTween(data.hpFill, 0.2, {
		Size = UDim2.fromScale(ratio, 1),
		BackgroundColor3 = hpColor,
	}, Enum.EasingStyle.Quad)

	quickTween(data.glowStroke, 0.2, { Color = hpColor }, Enum.EasingStyle.Quad)

	data.boxStroke.Color = data.isBot and COLORS.Purple or accentColor
	data.highlight.OutlineColor = data.isBot and hpColor or accentColor
	data.highlight.FillColor = hpColor
	data.sparkEmitter.Color = ColorSequence.new(accentColor, Color3.new(1, 1, 1))
	data.auraEmitter.Color = ColorSequence.new(hpColor, accentColor)
end

local function removeEntityOverlay(data: EntityOverlay?)
	if not data then return end

	for _, conn in ipairs(data.connections) do
		if conn.Connected then
			conn:Disconnect()
		end
	end
	table.clear(data.connections)

	destroyTracer(data)
	if data.billboard and data.billboard.Parent then data.billboard:Destroy() end
	if data.highlight and data.highlight.Parent then data.highlight:Destroy() end
	if data.headAttachment and data.headAttachment.Parent then data.headAttachment:Destroy() end
	if data.bodyAttachment and data.bodyAttachment.Parent then data.bodyAttachment:Destroy() end

	if data.isBot then
		botOverlays[data.character] = nil
	else
		playerOverlays[data.key :: Player] = nil
	end
end

local function createEntityOverlay(character: Model, displayName: string, isBot: boolean, playerKey: Player?)
	if isBot then
		if botOverlays[character] then return end
	elseif playerKey then
		if playerKey == localPlayer then return end
		removeEntityOverlay(playerOverlays[playerKey])
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 4) :: Humanoid?
	if not humanoid or humanoid.Health <= 0 then return end

	local rootPart = getCharacterRoot(character)
	local head = (character:FindFirstChild("Head") :: BasePart?) or rootPart
	if not rootPart or not head then return end
	if playerKey and playerKey.Character ~= character then return end

	local accentColor = getAccentColor()
	local isEnabled = isBot and STATE.BotEspEnabled or STATE.PlayerOverlayEnabled

	local billboard = Instance.new("BillboardGui")
	billboard.Name = isBot and "BotEspOverlay" or "PlayerEspOverlay"
	billboard.Adornee = head
	billboard.Size = UDim2.fromOffset(184, 54)
	billboard.StudsOffset = Vector3.new(0, 3.2, 0)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.MaxDistance = isBot and STATE.BotMaxDistance or STATE.MaxDistance
	billboard.Enabled = isEnabled
	billboard.ResetOnSpawn = false

	local card = Instance.new("Frame")
	card.Size = UDim2.new(1, -4, 1, -4)
	card.Position = UDim2.fromOffset(2, 2)
	card.BackgroundColor3 = COLORS.BgDark
	card.BackgroundTransparency = 0.42
	card.BorderSizePixel = 0
	card.Parent = billboard

	local cardCorner = Instance.new("UICorner")
	cardCorner.CornerRadius = UDim.new(0, 7)
	cardCorner.Parent = card

	local boxStroke = attachDashedStroke(card, 1.6, isBot and COLORS.Purple or accentColor)

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1, -8, 0.42, 0)
	nameLabel.Position = UDim2.fromOffset(4, 2)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = isBot and ("[BOT] " .. displayName) or displayName
	nameLabel.TextColor3 = isBot and COLORS.Purple or COLORS.TextMain
	nameLabel.TextTransparency = 1
	nameLabel.TextStrokeTransparency = 0.4
	nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextSize = 12
	nameLabel.Parent = card

	local distLabel = Instance.new("TextLabel")
	distLabel.Size = UDim2.new(1, -8, 0.3, 0)
	distLabel.Position = UDim2.new(0, 4, 0.68, 0)
	distLabel.BackgroundTransparency = 1
	distLabel.Text = "0m • 100 HP"
	distLabel.TextColor3 = accentColor
	distLabel.TextTransparency = 1
	distLabel.Font = Enum.Font.GothamMedium
	distLabel.TextSize = 10
	distLabel.Parent = card

	local barBg = Instance.new("Frame")
	barBg.Size = UDim2.new(0.88, 0, 0.18, 0)
	barBg.Position = UDim2.new(0.06, 0, 0.46, 0)
	barBg.BackgroundColor3 = Color3.fromRGB(16, 18, 25)
	barBg.BackgroundTransparency = 0.15
	barBg.BorderSizePixel = 0
	barBg.Parent = card

	local bgCorner = Instance.new("UICorner")
	bgCorner.CornerRadius = UDim.new(1, 0)
	bgCorner.Parent = barBg

	local glowStroke = Instance.new("UIStroke")
	glowStroke.Thickness = 1.2
	glowStroke.Transparency = 0.25
	glowStroke.Color = COLORS.HpHigh
	glowStroke.Parent = barBg

	local hpGhost = Instance.new("Frame")
	hpGhost.Size = UDim2.fromScale(1, 1)
	hpGhost.BackgroundColor3 = Color3.new(1, 1, 1)
	hpGhost.BackgroundTransparency = 0.4
	hpGhost.BorderSizePixel = 0
	hpGhost.ZIndex = 1
	hpGhost.Parent = barBg

	local ghostCorner = Instance.new("UICorner")
	ghostCorner.CornerRadius = UDim.new(1, 0)
	ghostCorner.Parent = hpGhost

	local hpFill = Instance.new("Frame")
	hpFill.Size = UDim2.fromScale(1, 1)
	hpFill.BackgroundColor3 = COLORS.HpHigh
	hpFill.BorderSizePixel = 0
	hpFill.ZIndex = 2
	hpFill.Parent = barBg

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = hpFill

	billboard.Parent = head

	local highlight = Instance.new("Highlight")
	highlight.Name = isBot and "BotHighlight" or "PlayerHighlight"
	highlight.Adornee = character
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillColor = COLORS.HpHigh
	highlight.FillTransparency = 0.84
	highlight.OutlineColor = isBot and COLORS.HpHigh or accentColor
	highlight.OutlineTransparency = 0.15
	highlight.Enabled = isBot and STATE.BotHighlight or STATE.PlayerHighlight
	highlight.Parent = character

	local headAtt = Instance.new("Attachment")
	headAtt.Position = Vector3.new(0, 1.35, 0)
	headAtt.Parent = head

	local sparkEmitter = Instance.new("ParticleEmitter")
	sparkEmitter.Name = "NeonHeadSparks"
	sparkEmitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkEmitter.Rate = 6
	sparkEmitter.Lifetime = NumberRange.new(1.0, 1.6)
	sparkEmitter.Speed = NumberRange.new(1.5, 2.8)
	sparkEmitter.EmissionDirection = Enum.NormalId.Top
	sparkEmitter.SpreadAngle = Vector2.new(40, 40)
	sparkEmitter.Acceleration = Vector3.new(0, 2.0, 0)
	sparkEmitter.RotSpeed = NumberRange.new(-140, 140)
	sparkEmitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.42),
		NumberSequenceKeypoint.new(0.7, 0.25),
		NumberSequenceKeypoint.new(1, 0),
	})
	sparkEmitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	sparkEmitter.LightEmission = 1
	sparkEmitter.LightInfluence = 0
	sparkEmitter.Parent = headAtt

	local bodyAtt = Instance.new("Attachment")
	bodyAtt.Position = Vector3.new(0, -1.8, 0)
	bodyAtt.Parent = rootPart

	local auraEmitter = Instance.new("ParticleEmitter")
	auraEmitter.Name = "NeonBodyAura"
	auraEmitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
	auraEmitter.Rate = 7
	auraEmitter.Lifetime = NumberRange.new(1.2, 1.9)
	auraEmitter.Speed = NumberRange.new(2.2, 3.6)
	auraEmitter.EmissionDirection = Enum.NormalId.Top
	auraEmitter.SpreadAngle = Vector2.new(25, 25)
	auraEmitter.Drag = 1.2
	auraEmitter.RotSpeed = NumberRange.new(-90, 90)
	auraEmitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.25),
		NumberSequenceKeypoint.new(0.5, 0.65),
		NumberSequenceKeypoint.new(1, 0.1),
	})
	auraEmitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.85),
		NumberSequenceKeypoint.new(0.4, 0.55),
		NumberSequenceKeypoint.new(1, 1),
	})
	auraEmitter.LightEmission = 1
	auraEmitter.LightInfluence = 0
	auraEmitter.Parent = bodyAtt

	local data: EntityOverlay = {
		key = (playerKey or character) :: Instance,
		displayName = displayName,
		isBot = isBot,
		character = character,
		humanoid = humanoid,
		rootPart = rootPart,
		head = head,
		billboard = billboard,
		card = card,
		boxStroke = boxStroke,
		nameLabel = nameLabel,
		barBg = barBg,
		hpFill = hpFill,
		hpGhost = hpGhost,
		distLabel = distLabel,
		glowStroke = glowStroke,
		highlight = highlight,
		headAttachment = headAtt,
		sparkEmitter = sparkEmitter,
		bodyAttachment = bodyAtt,
		auraEmitter = auraEmitter,
		connections = {},
		lastHealth = humanoid.Health,
		isLowHp = false,
		isVisible = true,
		fadeReady = false,
	}

	table.insert(data.connections, humanoid.HealthChanged:Connect(function()
		syncEntityOverlay(data)
	end))

	table.insert(data.connections, humanoid.Died:Connect(function()
		removeEntityOverlay(data)
	end))

	table.insert(data.connections, character.AncestryChanged:Connect(function(_, parent)
		if not parent then
			removeEntityOverlay(data)
		end
	end))

	if isBot then
		botOverlays[character] = data
	elseif playerKey then
		playerOverlays[playerKey] = data
	end

	applyOverlayCompactness(data)
	syncEntityOverlay(data)
	quickTween(nameLabel, 0.3, { TextTransparency = 0 }, Enum.EasingStyle.Quad)
	quickTween(distLabel, 0.3, { TextTransparency = 0.05 }, Enum.EasingStyle.Quad)

	task.delay(0.3, function()
		data.fadeReady = true
	end)
end

-- ============================================================================
-- 5. АВТОПОИСК БОТОВ / NPC В WORKSPACE
-- ============================================================================
local function tryRegisterBot(inst: Instance)
	if not inst:IsA("Humanoid") then return end
	task.defer(function()
		local model = inst.Parent
		if not model or not model:IsA("Model") or not model.Parent then return end
		if model == localPlayer.Character then return end
		if Players:GetPlayerFromCharacter(model) ~= nil then return end
		if inst.Health <= 0 then return end
		createEntityOverlay(model, model.Name, true, nil)
	end)
end

local function scanWorkspaceBots()
	for _, desc in ipairs(Workspace:GetDescendants()) do
		if desc:IsA("Humanoid") then
			tryRegisterBot(desc)
		end
	end
end

Workspace.DescendantAdded:Connect(tryRegisterBot)

-- ============================================================================
-- 6. МОДУЛЬ LOCK-ON (ПОИСК ЦЕЛИ + ЛУЧ И ТОЧКА УПРЕЖДЕНИЯ)
-- ============================================================================
local function clearLockBeam()
	if lockBeam then lockBeam:Destroy(); lockBeam = nil end
	if lockAtt0 then lockAtt0:Destroy(); lockAtt0 = nil end
	if lockAtt1 then lockAtt1:Destroy(); lockAtt1 = nil end
end

local function updateLockBeam(targetPart: BasePart?, predictedWorldPos: Vector3?)
	if not STATE.ShowLockBeam or not isLocking or not targetPart or not predictedWorldPos then
		clearLockBeam()
		return
	end

	local myChar = localPlayer.Character
	local myRoot = myChar and getCharacterRoot(myChar)
	if not myRoot then
		clearLockBeam()
		return
	end

	if not lockBeam or not lockAtt0 or lockAtt0.Parent ~= myRoot or not lockAtt1 or lockAtt1.Parent ~= targetPart then
		clearLockBeam()
		local att0 = Instance.new("Attachment")
		att0.Parent = myRoot

		local att1 = Instance.new("Attachment")
		att1.Parent = targetPart

		local leadDotGui = Instance.new("BillboardGui")
		leadDotGui.Size = UDim2.fromOffset(14, 14)
		leadDotGui.AlwaysOnTop = true
		leadDotGui.LightInfluence = 0
		leadDotGui.Parent = att1

		local dot = Instance.new("Frame")
		dot.Size = UDim2.fromScale(1, 1)
		dot.BackgroundColor3 = COLORS.Red
		dot.BorderSizePixel = 0
		dot.Parent = leadDotGui

		local dotCorner = Instance.new("UICorner")
		dotCorner.CornerRadius = UDim.new(1, 0)
		dotCorner.Parent = dot

		local dotStroke = Instance.new("UIStroke")
		dotStroke.Thickness = 1.5
		dotStroke.Color = Color3.new(1, 1, 1)
		dotStroke.Parent = dot

		local beam = Instance.new("Beam")
		beam.Attachment0 = att0
		beam.Attachment1 = att1
		beam.Width0 = 0.16
		beam.Width1 = 0.08
		beam.FaceCamera = true
		beam.LightEmission = 1
		beam.LightInfluence = 0
		beam.Color = ColorSequence.new(COLORS.Cyan, COLORS.Red)
		beam.Transparency = NumberSequence.new(0.15)
		beam.Parent = myRoot

		lockAtt0 = att0
		lockAtt1 = att1
		lockBeam = beam
	end

	if lockAtt1 then
		lockAtt1.Position = targetPart.CFrame:PointToObjectSpace(predictedWorldPos)
	end
end

local function isValidTarget(character: Model?): (boolean, BasePart?)
	if not character or not character.Parent or character == localPlayer.Character then
		return false, nil
	end
	local hum = character:FindFirstChildOfClass("Humanoid")
	local targetPart = getTargetAimPart(character)
	if not hum or hum.Health <= 0 or not targetPart then
		return false, nil
	end
	return true, targetPart
end

local function findClosestTarget(): Model?
	local activeCam = camera
	if not activeCam then return nil end

	local viewportSize = activeCam.ViewportSize
	local screenCenter = Vector2.new(viewportSize.X * 0.5, viewportSize.Y * 0.5)
	local camPos = activeCam.CFrame.Position

	local bestTarget: Model? = nil
	local shortestScreenDist = STATE.LockRadiusPx

	local function evaluateCandidate(char: Model?)
		local valid, targetPart = isValidTarget(char)
		if valid and targetPart and char then
			local worldDist = (targetPart.Position - camPos).Magnitude
			if worldDist <= STATE.LockMaxDistance then
				local screenPos, onScreen = activeCam:WorldToViewportPoint(targetPart.Position)
				if onScreen and screenPos.Z > 0 then
					local distFromCenter = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
					if distFromCenter < shortestScreenDist then
						shortestScreenDist = distFromCenter
						bestTarget = char
					end
				end
			end
		end
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer then
			evaluateCandidate(player.Character)
		end
	end

	if STATE.LockIncludeBots then
		for botModel, _ in pairs(botOverlays) do
			evaluateCandidate(botModel)
		end
		for _, desc in ipairs(Workspace:GetDescendants()) do
			if desc:IsA("Humanoid") and desc.Parent and desc.Parent:IsA("Model") then
				if Players:GetPlayerFromCharacter(desc.Parent) == nil then
					evaluateCandidate(desc.Parent)
				end
			end
		end
	end

	return bestTarget
end

