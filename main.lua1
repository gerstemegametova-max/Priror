-- ═══════════════════════════════════════════════════════════════════════
-- BLACKHAWK RESCUE MISSION 5 // ULTIMATE (Aimbot + ESP + Hitbox)
-- ═══════════════════════════════════════════════════════════════════════
print("[BRM5] Запуск скрипта...")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")
local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

local Env = (type(getgenv) == "function" and getgenv()) or _G
if Env.BRM5_Cleanup then pcall(Env.BRM5_Cleanup) end

-- 1. Настройки
local State = {
    Active = true, Minimized = false, Connections = {},
    -- Aimbot
    AimbotEnabled = false, AimPart = "Head", FOV = 250, Smoothness = 0.25,
    -- Hitbox
    HitboxEnabled = false, HitboxSize = 15,
    -- ESP
    ESPEnabled = false, ESPHealth = true, ESPDistance = 2000,
    ESPOutline = true, ESPRadius = true
}
Env.BRM5_State = State

local Theme = {
    Background = Color3.fromRGB(12, 12, 14), Surface = Color3.fromRGB(18, 18, 22),
    Element = Color3.fromRGB(26, 26, 32), ElementActive = Color3.fromRGB(52, 52, 64),
    Stroke = Color3.fromRGB(45, 45, 54), TextPrimary = Color3.fromRGB(235, 235, 240),
    TextSecondary = Color3.fromRGB(145, 145, 155), Danger = Color3.fromRGB(40, 22, 24),
    DangerStroke = Color3.fromRGB(95, 40, 45)
}

-- Паттерны для обычных персонажей (R6/R15)
local PartPatterns = {
    Head = { "head" },
    Body = { "torso", "upper torso", "lower torso", "humanoidrootpart" },
    Arms = { "arm", "left arm", "right arm" },
    Legs = { "leg", "left leg", "right leg" }
}

-- 2. Утилиты
local Utils = {}
function Utils.Track(c) if c then table.insert(State.Connections, c) end return c end
function Utils.Notify(t, x) pcall(function() StarterGui:SetCore("SendNotification", { Title = t, Text = x, Duration = 3 }) end) end
function Utils.GuiParent()
    local ok, p = pcall(function() if type(gethui) == "function" then return gethui() end return CoreGui end)
    if ok and p then return p end
    return LocalPlayer and LocalPlayer:WaitForChild("PlayerGui", 5) or CoreGui
end
function Utils.Style(i, r, sc, sw)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r or 8); c.Parent = i
    if sc then local s = Instance.new("UIStroke"); s.Color = sc; s.Thickness = sw or 1; s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; s.Parent = i end
end
function Utils.Drag(tr, tf, cb)
    local d, di, ds, sp, md = false, nil, nil, nil, 0
    Utils.Track(tr.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            d = true; ds = inp.Position; sp = tf.Position; md = 0
            local rc; rc = inp.Changed:Connect(function()
                if inp.UserInputState == Enum.UserInputState.End then d = false; if rc then rc:Disconnect() end; if md < 12 and cb then cb() end end
            end)
        end
    end))
    Utils.Track(tr.InputChanged:Connect(function(inp) if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then di = inp end end))
    Utils.Track(UserInputService.InputChanged:Connect(function(inp)
        if inp == di and d and ds and sp then local dl = inp.Position - ds; md = dl.Magnitude; tf.Position = UDim2.new(sp.X.Scale, sp.X.Offset + dl.X, sp.Y.Scale, sp.Y.Offset + dl.Y) end
    end))
end

-- 3. Основные функции (Поиск частей, Проверка стен)
local function FindPartByCat(model, cat)
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") then
            local n = string.lower(d.Name)
            for _, pat in ipairs(PartPatterns[cat]) do if string.find(n, pat, 1, true) then return d end end
        end
    end
    return nil
end

local function HasLineOfSight(targetPart)
    if not targetPart then return false end
    local origin = Camera.CFrame.Position
    local direction = targetPart.Position - origin
    
    local raycastParams = RaycastParams.new()
    -- Игнорируем себя и саму цель
    raycastParams.FilterDescendantsInstances = { LocalPlayer.Character, Camera, targetPart.Parent }
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    
    local result = Workspace:Raycast(origin, direction, raycastParams)
    return result == nil or result.Instance:IsDescendantOf(targetPart.Parent)
end

-- 4. Aimbot и Hitbox
local CachedOriginalHitboxes = {}

local function UpdateAimbot()
    if not State.AimbotEnabled or not LocalPlayer.Character then return end
    
    local closestTarget = nil
    local shortestDistance = State.FOV
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local targetPart = FindPartByCat(player.Character, State.AimPart)
            if targetPart and HasLineOfSight(targetPart) then
                local screenPos, onScreen = Camera:WorldToScreenPoint(targetPart.Position)
                if onScreen then
                    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                    local distanceToCenter = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                    
                    if distanceToCenter < shortestDistance then
                        shortestDistance = distanceToCenter
                        closestTarget = targetPart
                    end
                end
            end
        end
    end
    
    if closestTarget then
        -- Плавный поворот камеры (Aimbot)
        local targetCFrame = CFrame.new(Camera.CFrame.Position, closestTarget.Position)
        Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, State.Smoothness)
    end
end

local function UpdateHitboxes()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and (part.Name == "Head" or part.Name == "HumanoidRootPart" or part.Name == "Torso" or part.Name == "UpperTorso") then
                    if State.HitboxEnabled and not CachedOriginalHitboxes[part] then
                        CachedOriginalHitboxes[part] = { Size = part.Size, Trans = part.Transparency, Collide = part.CanCollide }
                        part.CanCollide = false
                        part.Transparency = 0.7
                        part.Size = Vector3.new(State.HitboxSize, State.HitboxSize, State.HitboxSize)
                        part.Massless = true
                    elseif not State.HitboxEnabled and CachedOriginalHitboxes[part] then
                        local orig = CachedOriginalHitboxes[part]
                        part.Size = orig.Size
                        part.Transparency = orig.Trans
                        part.CanCollide = orig.Collide
                        CachedOriginalHitboxes[part] = nil
                    end
                end
            end
        end
    end
end

-- 5. ESP и Радиус
local espFolder = Instance.new("Folder"); espFolder.Name = "BRM5_ESP"; pcall(function() espFolder.Parent = Utils.GuiParent() end)
local espGuis = {}
local highlights = {}
local radiusCircle = nil

local function UpdateRadius()
    if not State.ESPRadius then
        if radiusCircle then radiusCircle.Transparency = 1 end
        return
    end
    
    if not radiusCircle then
        radiusCircle = Instance.new("Part")
        radiusCircle.Shape = Enum.PartType.Cylinder
        radiusCircle.Size = Vector3.new(1, State.ESPDistance * 2, State.ESPDistance * 2)
        radiusCircle.Anchored = true
        radiusCircle.CanCollide = false
        radiusCircle.Material = Enum.Material.Neon
        radiusCircle.Color = Color3.fromRGB(50, 150, 255)
        radiusCircle.Transparency = 0.8
        radiusCircle.Parent = Workspace
    end
    
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        radiusCircle.CFrame = LocalPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, -3, 0) * CFrame.Angles(0, 0, math.rad(90))
        radiusCircle.Transparency = 0.8
    end
end

local function UpdateESP()
    local myPos = Camera.CFrame.Position
    if not State.ESPEnabled then
        for _, data in pairs(espGuis) do if data.gui then data.gui.Enabled = false end end
        for _, hl in pairs(highlights) do hl.Enabled = false end
        return
    end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local head = char:FindFirstChild("Head")
            local hum = char:FindFirstChildOfClass("Humanoid")
            
            if head and hum then
                local dist = (myPos - head.Position).Magnitude
                local isVisible = HasLineOfSight(head)
                
                if dist <= State.ESPDistance and isVisible then
                    if not espGuis[player] then
                        -- Создаем UI
                        local bb = Instance.new("BillboardGui"); bb.Size = UDim2.fromOffset(160, 40); bb.StudsOffset = Vector3.new(0, 3, 0); bb.AlwaysOnTop = true; bb.Parent = espFolder
                        local nameLbl = Instance.new("TextLabel"); nameLbl.Size = UDim2.new(1, 0, 0, 14); nameLbl.BackgroundTransparency = 1; nameLbl.TextColor3 = Color3.fromRGB(255, 255, 255); nameLbl.TextStrokeTransparency = 0.1; nameLbl.Font = Enum.Font.GothamBold; nameLbl.TextSize = 11; nameLbl.Parent = bb
                        local hpBg = Instance.new("Frame"); hpBg.Size = UDim2.new(1, 0, 0, 12); hpBg.Position = UDim2.new(0, 0, 0, 16); hpBg.BackgroundColor3 = Color3.fromRGB(24, 24, 28); hpBg.Parent = bb; Utils.Style(hpBg, 3, Color3.fromRGB(0, 0, 0), 1)
                        local hpFill = Instance.new("Frame"); hpFill.Size = UDim2.new(1, 0, 1, 0); hpFill.BackgroundColor3 = Color3.fromRGB(65, 235, 85); hpFill.Parent = hpBg; Utils.Style(hpFill, 3, nil)
                        local hpText = Instance.new("TextLabel"); hpText.Size = UDim2.fromScale(1, 1); hpText.BackgroundTransparency = 1; hpText.TextColor3 = Color3.fromRGB(255, 255, 255); hpText.TextStrokeTransparency = 0.05; hpText.Font = Enum.Font.GothamBold; hpText.TextSize = 9; hpText.ZIndex = 3; hpText.Parent = hpBg
                        
                        espGuis[player] = { gui = bb, name = nameLbl, hpBg = hpBg, hpFill = hpFill, hpText = hpText }
                    end
                    
                    -- Highlight (Обводка)
                    if State.ESPOutline and not highlights[player] then
                        local hl = Instance.new("Highlight")
                        hl.DepthMode = Enum.HighlightDepthMode.Occlusion -- Не видно сквозь стены
                        hl.FillColor = Color3.fromRGB(255, 50, 50)
                        hl.FillTransparency = 0.5
                        hl.OutlineColor = Color3.fromRGB(255, 50, 50)
                        hl.Parent = char
                        highlights[player] = hl
                    end
                    
                    local data = espGuis[player]
                    data.gui.Adornee = head
                    data.gui.Enabled = true
                    data.name.Text = string.format("[%dm] %s", math.floor(dist), player.DisplayName)
                    
                    if State.ESPHealth then
                        data.hpBg.Visible = true
                        local hpRatio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                        data.hpFill.Size = UDim2.new(hpRatio, 0, 1, 0)
                        data.hpText.Text = string.format("HP: %d/%d", math.floor(hum.Health), math.floor(hum.MaxHealth))
                        data.hpFill.BackgroundColor3 = (hpRatio < 0.3 and Color3.fromRGB(235, 65, 65)) or (hpRatio < 0.65 and Color3.fromRGB(240, 190, 50)) or Color3.fromRGB(60, 215, 80)
                    else
                        data.hpBg.Visible = false
                    end
                    
                else
                    if espGuis[player] then espGuis[player].gui.Enabled = false end
                    if highlights[player] then highlights[player].Enabled = false end
                end
            end
        end
    end
end

-- 6. Меню
local ScreenGui = Instance.new("ScreenGui"); ScreenGui.Name = "BRM5_UI"; ScreenGui.ResetOnSpawn = false; pcall(function() ScreenGui.Parent = Utils.GuiParent() end)
local TargetSize, IconSize = UDim2.fromOffset(450, 300), UDim2.fromOffset(50, 50)
local MainFrame = Instance.new("Frame"); MainFrame.AnchorPoint = Vector2.new(0.5, 0.5); MainFrame.Position = UDim2.fromScale(0.5, 0.5); MainFrame.Size = UDim2.fromOffset(0, 0); MainFrame.BackgroundColor3 = Theme.Background; MainFrame.ClipsDescendants = true; MainFrame.Parent = ScreenGui; Utils.Style(MainFrame, 12, Theme.Stroke, 1.2)
local TopBar = Instance.new("Frame"); TopBar.Size = UDim2.new(1, 0, 0, 42); TopBar.BackgroundColor3 = Theme.Surface; TopBar.Parent = MainFrame; Utils.Style(TopBar, 12, nil)
local TitleLabel = Instance.new("TextLabel"); TitleLabel.Size = UDim2.new(1, -120, 1, 0); TitleLabel.Position = UDim2.fromOffset(15, 0); TitleLabel.BackgroundTransparency = 1; TitleLabel.Text = "BLACKHAWK RM5 // ULTIMATE"; TitleLabel.TextColor3 = Theme.TextPrimary; TitleLabel.Font = Enum.Font.GothamBold; TitleLabel.TextSize = 13; TitleLabel.TextXAlignment = Enum.TextXAlignment.Left; TitleLabel.Parent = TopBar
local MinimizeBtn = Instance.new("TextButton"); MinimizeBtn.Size = UDim2.fromOffset(32, 28); MinimizeBtn.Position = UDim2.new(1, -40, 0.5, -14); MinimizeBtn.BackgroundColor3 = Theme.Element; MinimizeBtn.Text = "—"; MinimizeBtn.TextColor3 = Theme.TextPrimary; MinimizeBtn.Font = Enum.Font.GothamBold; MinimizeBtn.TextSize = 14; MinimizeBtn.Parent = TopBar; Utils.Style(MinimizeBtn, 6, Theme.Stroke, 1)
local MiniIcon = Instance.new("TextButton"); MiniIcon.AnchorPoint = Vector2.new(0.5, 0.5); MiniIcon.Position = UDim2.new(0.1, 0, 0.2, 0); MiniIcon.Size = UDim2.fromOffset(0, 0); MiniIcon.BackgroundColor3 = Theme.Surface; MiniIcon.Text = "BR"; MiniIcon.TextColor3 = Theme.TextPrimary; MiniIcon.Font = Enum.Font.GothamBold; MiniIcon.TextSize = 14; MiniIcon.Visible = false; MiniIcon.Parent = ScreenGui; Utils.Style(MiniIcon, 25, Theme.Stroke, 1.5)
local Sidebar = Instance.new("Frame"); Sidebar.Size = UDim2.new(0, 120, 1, -42); Sidebar.Position = UDim2.fromOffset(0, 42); Sidebar.BackgroundColor3 = Theme.Surface; Sidebar.Parent = MainFrame
local TabList = Instance.new("ScrollingFrame"); TabList.Size = UDim2.new(1, -16, 1, -66); TabList.Position = UDim2.fromOffset(8, 10); TabList.BackgroundTransparency = 1; TabList.ScrollBarThickness = 0; TabList.CanvasSize = UDim2.new(0, 0, 0, 0); TabList.AutomaticCanvasSize = Enum.AutomaticSize.Y; TabList.Parent = Sidebar
local TabListLayout = Instance.new("UIListLayout"); TabListLayout.Padding = UDim.new(0, 6); TabListLayout.Parent = TabList
local DeactivateBtn = Instance.new("TextButton"); DeactivateBtn.Size = UDim2.new(1, -16, 0, 38); DeactivateBtn.Position = UDim2.new(0, 8, 1, -46); DeactivateBtn.BackgroundColor3 = Theme.Danger; DeactivateBtn.Text = "Unload"; DeactivateBtn.TextColor3 = Theme.TextPrimary; DeactivateBtn.Font = Enum.Font.GothamSemibold; DeactivateBtn.TextSize = 13; DeactivateBtn.Parent = Sidebar; Utils.Style(DeactivateBtn, 8, Theme.DangerStroke, 1)
local PagesContainer = Instance.new("Frame"); PagesContainer.Size = UDim2.new(1, -120, 1, -42); PagesContainer.Position = UDim2.fromOffset(120, 42); PagesContainer.BackgroundTransparency = 1; PagesContainer.Parent = MainFrame
local Tabs = {}; local CurrentTab = nil
local function SelectTab(tabName) for name, data in pairs(Tabs) do local isSelected = (name == tabName); data.Page.Visible = isSelected; data.Button.BackgroundColor3 = isSelected and Theme.ElementActive or Theme.Element; data.Button.TextColor3 = isSelected and Theme.TextPrimary or Theme.TextSecondary end; CurrentTab = tabName end
local function CreateTab(tabName)
    local btn = Instance.new("TextButton"); btn.Size = UDim2.new(1, 0, 0, 38); btn.BackgroundColor3 = Theme.Element; btn.Text = tabName; btn.TextColor3 = Theme.TextSecondary; btn.Font = Enum.Font.GothamMedium; btn.TextSize = 13; btn.Parent = TabList; Utils.Style(btn, 8, Theme.Stroke, 1)
    local page = Instance.new("ScrollingFrame"); page.Size = UDim2.new(1, -20, 1, -20); page.Position = UDim2.fromOffset(10, 10); page.BackgroundTransparency = 1; page.ScrollBarThickness = 2; page.CanvasSize = UDim2.new(0, 0, 0, 0); page.AutomaticCanvasSize = Enum.AutomaticSize.Y; page.Visible = false; page.Parent = PagesContainer
    local layout = Instance.new("UIListLayout"); layout.Padding = UDim.new(0, 8); layout.SortOrder = Enum.SortOrder.LayoutOrder; layout.Parent = page
    Utils.Track(btn.Activated:Connect(function() SelectTab(tabName) end))
    Tabs[tabName] = { Button = btn, Page = page }; if not CurrentTab then SelectTab(tabName) end; return page
end
local function CreateToggle(parent, text, defaultState, order, callback)
    local btn = Instance.new("TextButton"); btn.LayoutOrder = order; btn.Size = UDim2.new(1, 0, 0, 42); btn.BackgroundColor3 = Theme.Surface; btn.Text = ""; btn.AutoButtonColor = false; btn.Parent = parent; Utils.Style(btn, 8, Theme.Stroke, 1)
    local lbl = Instance.new("TextLabel"); lbl.Size = UDim2.new(1, -70, 1, 0); lbl.Position = UDim2.fromOffset(12, 0); lbl.BackgroundTransparency = 1; lbl.Text = text; lbl.TextColor3 = Theme.TextPrimary; lbl.Font = Enum.Font.GothamMedium; lbl.TextSize = 13; lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.Parent = btn
    local ind = Instance.new("Frame"); ind.Size = UDim2.fromOffset(40, 22); ind.Position = UDim2.new(1, -52, 0.5, -11); ind.BackgroundColor3 = defaultState and Theme.ElementActive or Theme.Element; ind.Parent = btn; Utils.Style(ind, 11, Theme.Stroke, 1)
    local kn = Instance.new("Frame"); kn.Size = UDim2.fromOffset(16, 16); kn.Position = defaultState and UDim2.fromOffset(21, 3) or UDim2.fromOffset(3, 3); kn.BackgroundColor3 = defaultState and Theme.TextPrimary or Theme.TextSecondary; kn.Parent = ind; Utils.Style(kn, 8, nil)
    local state = defaultState
    Utils.Track(btn.Activated:Connect(function() state = not state; ind.BackgroundColor3 = state and Theme.ElementActive or Theme.Element; kn.Position = state and UDim2.fromOffset(21, 3) or UDim2.fromOffset(3, 3); kn.BackgroundColor3 = state and Theme.TextPrimary or Theme.TextSecondary; if callback then pcall(callback, state) end end))
end
local function CreateCycleButton(parent, labelPrefix, options, defaultIndex, order, callback)
    local idx = defaultIndex or 1
    local btn = Instance.new("TextButton"); btn.LayoutOrder = order; btn.Size = UDim2.new(1, 0, 0, 42); btn.BackgroundColor3 = Theme.Element; btn.Text = labelPrefix .. ": " .. tostring(options[idx]); btn.TextColor3 = Theme.TextPrimary; btn.Font = Enum.Font.GothamSemibold; btn.TextSize = 13; btn.Parent = parent; Utils.Style(btn, 8, Theme.Stroke, 1)
    Utils.Track(btn.Activated:Connect(function() idx = (idx % #options) + 1; btn.Text = labelPrefix .. ": " .. tostring(options[idx]); if callback then pcall(callback, options[idx], idx) end end))
end

local CombatPage = CreateTab("Combat"); local RenderPage = CreateTab("Render")

CreateToggle(CombatPage, "Aimbot (Поворот камеры)", State.AimbotEnabled, 1, function(v) State.AimbotEnabled = v end)
CreateCycleButton(CombatPage, "Цель Aimbot", { "Head", "Body", "HumanoidRootPart" }, 1, 2, function(opt) 
    State.AimPart = (opt == "HumanoidRootPart" and "Body" or opt) 
end)
CreateCycleButton(CombatPage, "Плавность Aimbot", { "0.1 (Медленно)", "0.25 (Средне)", "0.5 (Быстро)", "1.0 (Мгновенно)" }, 2, 3, function(_, idx) State.Smoothness = ({0.1, 0.25, 0.5, 1.0})[idx] end)

CreateToggle(CombatPage, "Hitbox Expander (Увеличение)", State.HitboxEnabled, 4, function(v) State.HitboxEnabled = v end)
CreateCycleButton(CombatPage, "Размер Hitbox", { "8", "12", "15", "20", "30" }, 3, 5, function(_, idx) State.HitboxSize = ({8, 12, 15, 20, 30})[idx] end)

CreateToggle(RenderPage, "ESP Игроков (Не сквозь стены)", State.ESPEnabled, 1, function(v) State.ESPEnabled = v end)
CreateToggle(RenderPage, "Обводка (Highlight)", State.ESPOutline, 2, function(v) State.ESPOutline = v end)
CreateToggle(RenderPage, "Показывать HP", State.ESPHealth, 3, function(v) State.ESPHealth = v end)
CreateToggle(RenderPage, "Круг радиуса ESP", State.ESPRadius, 4, function(v) State.ESPRadius = v end)
CreateCycleButton(RenderPage, "Дистанция ESP", { 1000, 2000, 3500, 5000 }, 2, 5, function(val) State.ESPDistance = val end)

local function MinimizeUI() if State.Minimized then return end State.Minimized = true; MainFrame.Visible = false; MiniIcon.Size = IconSize; MiniIcon.Visible = true end
local function RestoreUI() if not State.Minimized then return end State.Minimized = false; MiniIcon.Visible = false; MainFrame.Visible = true end
local function DeactivateScript()
    if not State.Active then return end
    State.Active = false; State.AimbotEnabled = false; State.ESPEnabled = false; State.HitboxEnabled = false; State.ESPRadius = false
    for _, conn in ipairs(State.Connections) do pcall(function() conn:Disconnect() end) end
    for _, hl in pairs(highlights) do pcall(function() hl:Destroy() end) end
    if espFolder then pcall(function() espFolder:Destroy() end) end
    if radiusCircle then pcall(function() radiusCircle:Destroy() end) end
    pcall(function() ScreenGui:Destroy() end)
    Env.BRM5_Cleanup = nil
    Utils.Notify("BRM5", "Скрипт выгружен.")
end
Env.BRM5_Cleanup = DeactivateScript
Utils.Drag(TopBar, MainFrame, nil); Utils.Drag(MiniIcon, MiniIcon, RestoreUI)
Utils.Track(MinimizeBtn.Activated:Connect(MinimizeUI)); Utils.Track(DeactivateBtn.Activated:Connect(DeactivateScript))

-- Главный цикл
Utils.Track(RunService.RenderStepped:Connect(function()
    if not State.Active then return end
    UpdateHitboxes()
    UpdateAimbot()
    UpdateESP()
    UpdateRadius()
end))

task.spawn(function() pcall(function() TweenService:Create(MainFrame, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = TargetSize }):Play() end) end)