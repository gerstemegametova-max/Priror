-- Конструкторы контролов
local function AddSection(page, title, accent)
    return Utils.Create("TextLabel", {
        Size = UDim2.new(1, 0, 0, 20),
        BackgroundTransparency = 1,
        Text = string.upper(title),
        TextColor3 = accent or Utils.Colors.SubText,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 12,
    }, page)
end

local function AddToggle(page, label, tbl, key, accent)
    local row = Utils.Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = Utils.Colors.Panel,
        Text = "",
        AutoButtonColor = false,
        ZIndex = 12,
    }, page)
    Utils.AddCorner(row, 7)
    Utils.AddStroke(row, Utils.Colors.Border, 1, 0.4)

    Utils.Create("TextLabel", {
        Size = UDim2.new(1, -60, 1, 0),
        Position = UDim2.fromOffset(10, 0),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = Utils.Colors.Text,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 13,
    }, row)

    local pill = Utils.Create("Frame", {
        Size = UDim2.fromOffset(36, 18),
        Position = UDim2.new(1, -46, 0.5, -9),
        BackgroundColor3 = Utils.Colors.Element,
        ZIndex = 13,
    }, row)
    Utils.AddCorner(pill, 9)

    local knob = Utils.Create("Frame", {
        Size = UDim2.fromOffset(14, 14),
        Position = UDim2.fromOffset(2, 2),
        BackgroundColor3 = Utils.Colors.White,
        ZIndex = 14,
    }, pill)
    Utils.AddCorner(knob, 7)

    local function sync()
        local on = tbl[key] == true
        pill.BackgroundColor3 = on and (accent or Utils.Colors.LegitAccent) or Utils.Colors.Element
        knob.Position = on and UDim2.fromOffset(20, 2) or UDim2.fromOffset(2, 2)
    end
    sync()

    row.MouseButton1Click:Connect(function()
        tbl[key] = not tbl[key]
        sync()
    end)
end

local function AddCycle(page, label, tbl, key, options, accent)
    local row = Utils.Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = Utils.Colors.Panel,
        Text = "",
        AutoButtonColor = false,
        ZIndex = 12,
    }, page)
    Utils.AddCorner(row, 7)
    Utils.AddStroke(row, Utils.Colors.Border, 1, 0.4)

    Utils.Create("TextLabel", {
        Size = UDim2.new(0.6, 0, 1, 0),
        Position = UDim2.fromOffset(10, 0),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = Utils.Colors.Text,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 13,
    }, row)

    local valLbl = Utils.Create("TextLabel", {
        Size = UDim2.new(0.4, -14, 1, 0),
        Position = UDim2.new(0.6, 0, 0, 0),
        BackgroundTransparency = 1,
        Text = tostring(tbl[key]),
        TextColor3 = accent or Utils.Colors.LegitAccent,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
        ZIndex = 13,
    }, row)

    row.MouseButton1Click:Connect(function()
        local curIdx = 1
        for i, v in ipairs(options) do
            if v == tbl[key] then curIdx = i break end
        end
        local nextVal = options[(curIdx % #options) + 1]
        tbl[key] = nextVal
        valLbl.Text = tostring(nextVal)
    end)
end

local function AddSlider(page, label, tbl, key, minV, maxV, step, accent)
    local box = Utils.Create("Frame", {
        Size = UDim2.new(1, 0, 0, 44),
        BackgroundColor3 = Utils.Colors.Panel,
        ZIndex = 12,
    }, page)
    Utils.AddCorner(box, 7)
    Utils.AddStroke(box, Utils.Colors.Border, 1, 0.4)

    Utils.Create("TextLabel", {
        Size = UDim2.new(0.7, 0, 0, 20),
        Position = UDim2.fromOffset(10, 3),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = Utils.Colors.Text,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 13,
    }, box)

    local valLbl = Utils.Create("TextLabel", {
        Size = UDim2.new(0.3, -12, 0, 20),
        Position = UDim2.new(0.7, 0, 0, 3),
        BackgroundTransparency = 1,
        Text = tostring(tbl[key]),
        TextColor3 = accent or Utils.Colors.LegitAccent,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
        ZIndex = 13,
    }, box)

    local track = Utils.Create("Frame", {
        Size = UDim2.new(1, -20, 0, 6),
        Position = UDim2.fromOffset(10, 29),
        BackgroundColor3 = Utils.Colors.Element,
        ZIndex = 13,
    }, box)
    Utils.AddCorner(track, 3)

    local fill = Utils.Create("Frame", {
        Size = UDim2.fromScale(0, 1),
        BackgroundColor3 = accent or Utils.Colors.LegitAccent,
        ZIndex = 14,
    }, track)
    Utils.AddCorner(fill, 3)

    local function applyRatio(r)
        r = math.clamp(r, 0, 1)
        local raw = minV + (maxV - minV) * r
        local snapped = math.floor((raw / step) + 0.5) * step
        snapped = math.clamp(snapped, minV, maxV)
        -- Округляем до 2 знаков, чтобы не было 0.2500000001
        snapped = math.floor(snapped * 100 + 0.5) / 100
        tbl[key] = snapped
        fill.Size = UDim2.fromScale((snapped - minV) / (maxV - minV), 1)
        valLbl.Text = tostring(snapped)
    end

    applyRatio((tbl[key] - minV) / (maxV - minV))

    local sliding = false
    local function updateFromInput(input)
        local rel = (input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1)
        applyRatio(rel)
    end

    table.insert(Connections, track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliding = true
            updateFromInput(input)
        end
    end))
    table.insert(Connections, UserInputService.InputChanged:Connect(function(input)
        if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromInput(input)
        end
    end))
    table.insert(Connections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliding = false
        end
    end))
end

