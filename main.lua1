SwitchTab("Main")

-- // =========================================================================
-- // 9. ПРИВЯЗКА ЦИКЛОВ И ХОТКЕЙ (RightShift / Insert)
-- // =========================================================================
local bindAim = "REBASE_AimStep"
RunService:BindToRenderStep(bindAim, Enum.RenderPriority.Camera.Value + 1, function(dt)
    TargetAssist.Step(dt)
    WeaponMod.Step()
end)
table.insert(RenderBindings, bindAim)

local bindEsp = "REBASE_EspStep"
RunService:BindToRenderStep(bindEsp, Enum.RenderPriority.Last.Value, function()
    EspMod.Step()
end)
table.insert(RenderBindings, bindEsp)

table.insert(Connections, RunService.Heartbeat:Connect(function()
    HitboxMod.Step()
end))

table.insert(Connections, UserInputService.InputBegan:Connect(function(input, gp)
    if gp or State.Unloaded then return end
    if input.KeyCode == Enum.KeyCode.RightShift or input.KeyCode == Enum.KeyCode.Insert then
        State.Minimized = not State.Minimized
        MainFrame.Visible = not State.Minimized
        MiniBtn.Visible = State.Minimized
    end
end))

RescanNpcs()
Utils.Notify("BRM5 Suite", "Загружено. Найдено NPC: " .. tostring(#CachedNpcs), Utils.Colors.LegitAccent)
