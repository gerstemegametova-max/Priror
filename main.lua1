local TabButtons = {}
local Pages = {}

local function SwitchTab(name)
    State.ActiveMode = name
    for k, page in pairs(Pages) do
        page.Visible = (k == name)
    end
    for k, btn in pairs(TabButtons) do
        local accent = (k == "Rage") and Utils.Colors.RageAccent or Utils.Colors.LegitAccent
        btn.BackgroundColor3 = (k == name) and accent or Utils.Colors.Element
        btn.TextColor3 = (k == name) and Utils.Colors.White or Utils.Colors.SubText
    end
end

local tabNames = { "Main", "Legit", "Rage" }
for idx, tName in ipairs(tabNames) do
    local b = Utils.Create("TextButton", {
        Size = UDim2.fromOffset(58, 24),
        Position = UDim2.fromOffset(145 + (idx - 1) * 64, 7),
        BackgroundColor3 = Utils.Colors.Element,
        Text = tName,
        TextColor3 = Utils.Colors.SubText,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        AutoButtonColor = false,
        ZIndex = 12,
    }, TopBar)
    Utils.AddCorner(b, 6)
    b.MouseButton1Click:Connect(function()
        SwitchTab(tName)
    end)
    TabButtons[tName] = b
end

