    local deactivateBtn = Utils.Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 38),
        Position = UDim2.new(0, 0, 1, -38),
        BackgroundColor3 = Color3.fromRGB(36, 15, 20),
        Text = "ДЕАКТИВИРОВАТЬ СКРИПТ",
        TextColor3 = Utils.Colors.RageAccent,
        Font = Enum.Font.GothamBold,
        TextSize = 12
    }, mainPage)
    Utils.AddCorner(deactivateBtn, 8)
    Utils.AddStroke(deactivateBtn, Utils.Colors.RageAccent, 1.2)
    deactivateBtn.MouseButton1Click:Connect(DeactivateScript)

    -- // Страница настроек с кнопкой возврата
    local function CreateSettingsPage(pageKey, titleText, accentColor)
        local page = Utils.Create("Frame", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Visible = false
        }, contentContainer)
        Pages[pageKey] = page

        local subBar = Utils.Create("Frame", {
            Size = UDim2.new(1, -24, 0, 34),
            Position = UDim2.new(0, 12, 0, 8),
            BackgroundTransparency = 1
        }, page)

        local backBtn = Utils.Create("TextButton", {
            Size = UDim2.new(0, 88, 1, 0),
            BackgroundColor3 = Utils.Colors.Element,
            Text = "← НАЗАД",
            TextColor3 = Utils.Colors.Text,
            Font = Enum.Font.GothamBold,
            TextSize = 11
        }, subBar)
        Utils.AddCorner(backBtn, 7)
        Utils.AddStroke(backBtn, accentColor, 1.2)
        backBtn.MouseButton1Click:Connect(function() SwitchPage("Main") end)

        Utils.Create("TextLabel", {
            Size = UDim2.new(1, -98, 1, 0),
            Position = UDim2.new(0, 98, 0, 0),
            BackgroundTransparency = 1,
            Text = titleText,
            TextColor3 = accentColor,
            Font = Enum.Font.GothamBlack,
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Right
        }, subBar)

        local scroll = Utils.Create("ScrollingFrame", {
            Size = UDim2.new(1, -24, 1, -52),
            Position = UDim2.new(0, 12, 0, 48),
            BackgroundTransparency = 1,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = accentColor,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y
        }, page)

        Utils.Create("UIListLayout", {
            Padding = UDim.new(0, 6),
            SortOrder = Enum.SortOrder.LayoutOrder
        }, scroll)

        return scroll
    end

    -- // СТРАНИЦА 2: LEGIT PROFILE
    local legitScroll = CreateSettingsPage("Legit", "LEGIT PROFILE", Utils.Colors.LegitAccent)
    local L = State.Legit
    local LA = Utils.Colors.LegitAccent

    AddSectionHeader(legitScroll, "Модуль 1: Target Assist", LA)
    AddToggle(legitScroll, "L_Aim", "Наведение камеры (ПКМ)", "L: Aim Assist", L, "AimEnabled", LA)
    AddSlider(legitScroll, "Плавность наведения", L, "Smoothness", 0.1, 1.0, 0.05, "", LA)
    AddCycleButton(legitScroll, "Часть тела", L, "TargetPart", { "Head", "Torso", "HumanoidRootPart" }, nil, LA)
    AddSlider(legitScroll, "Макс. дистанция", L, "MaxDistance", 100, 500, 25, " st", LA)
    AddSlider(legitScroll, "Радиус FOV", L, "FovRadius", 100, 400, 10, " px", LA)
    AddToggle(legitScroll, "L_Fov", "Показывать круг FOV", "L: FOV Circle", L, "ShowFov", LA)
    AddToggle(legitScroll, "L_Vis", "Только видимые (Raycast)", "L: Raycast", L, "VisibleOnly", LA)

    AddSectionHeader(legitScroll, "Модуль 2: Hitbox Modifier", LA)
    AddToggle(legitScroll, "L_Hitbox", "Расширение головы", "L: Head Box", L, "HitboxEnabled", LA, function() HitboxModifier.RestoreAll() end)
    AddSlider(legitScroll, "Множитель головы", L, "HitboxScale", 1.5, 2.0, 0.1, "x", LA, function() HitboxModifier.RestoreAll() end)

    AddSectionHeader(legitScroll, "Модуль 3: Tactical Visual Overlay", LA)
    AddToggle(legitScroll, "L_Esp", "Включить Tactical ESP", "L: ESP", L, "EspEnabled", LA)
    AddCycleButton(legitScroll, "Стиль рамки (Box)", L, "BoxStyle", { "Corners", "Full", "Off" }, nil, LA)
    AddToggle(legitScroll, "L_Hp", "Полоска HP + след урона", "L: HP Bar", L, "ShowHpBar", LA)
    AddToggle(legitScroll, "L_Name", "Имя игрока", "L: Names", L, "ShowName", LA)
    AddToggle(legitScroll, "L_Dist", "Дистанция и статус [VIS]", "L: Distance", L, "ShowDistance", LA)
    AddToggle(legitScroll, "L_Dot", "Маркер головы (Head Dot)", "L: Head Dot", L, "ShowHeadDot", LA)
    AddToggle(legitScroll, "L_Tracer", "Трассеры (Snaplines)", "L: Tracers", L, "ShowTracers", LA)
    AddToggle(legitScroll, "L_Offscr", "Стрелки целей вне экрана", "L: Offscreen", L, "ShowOffscreen", LA)
    AddToggle(legitScroll, "L_Skel", "Скелет (R6/R15)", "L: Skeleton", L, "ShowSkeleton", LA)
    AddCycleButton(legitScroll, "Дальность ESP", L, "EspMaxDist", { 1000, 2000, 3500, 5000 }, function(v) return v .. " st" end, LA)
    AddToggle(legitScroll, "L_EspVis", "ESP в прямой видимости", "L: ESP Vis", L, "EspVisibleOnly", LA)

    AddSectionHeader(legitScroll, "Модуль 4: Weapon Modifier", LA)
    AddToggle(legitScroll, "L_Recoil", "Мягкий No Recoil", "L: No Recoil", L, "NoRecoil", LA)
    AddToggle(legitScroll, "L_Shake", "Отключить тряску камеры", "L: No Shake", L, "NoShake", LA)

    -- // СТРАНИЦА 3: RAGE PROFILE
    local rageScroll = CreateSettingsPage("Rage", "RAGE PROFILE", Utils.Colors.RageAccent)
    local R = State.Rage
    local RA = Utils.Colors.RageAccent

    AddSectionHeader(rageScroll, "Модуль 1: Target Assist (360°)", RA)
    AddToggle(rageScroll, "R_Aim", "Постоянное авто-наведение", "R: Auto Aim", R, "AimEnabled", RA)
    AddSlider(rageScroll, "Дистанция захвата", R, "MaxDistance", 500, 2000, 100, " st", RA)
    AddToggle(rageScroll, "R_Walls", "Игнорировать стены", "R: Wall Aim", R, "IgnoreWalls", RA)

    AddSectionHeader(rageScroll, "Модуль 2: Hitbox Modifier (Все части)", RA)
    AddToggle(rageScroll, "R_Hitbox", "Расширение всех хитбоксов", "R: All Boxes", R, "HitboxEnabled", RA, function() HitboxModifier.RestoreAll() end)
    AddSlider(rageScroll, "Множитель хитбоксов", R, "HitboxScale", 5.0, 10.0, 0.5, "x", RA, function() HitboxModifier.RestoreAll() end)

    AddSectionHeader(rageScroll, "Модуль 3: Full Tactical Overlay", RA)
    AddToggle(rageScroll, "R_Esp", "Включить Rage ESP", "R: Rage ESP", R, "EspEnabled", RA)
    AddCycleButton(rageScroll, "Стиль рамки (Box)", R, "BoxStyle", { "Corners", "Full", "Off" }, nil, RA)
    AddToggle(rageScroll, "R_High", "Highlight (сквозь стены)", "R: Highlight", R, "ShowHighlight", RA)
    AddToggle(rageScroll, "R_Skel", "Скелет (R6/R15)", "R: Skeleton", R, "ShowSkeleton", RA)
    AddToggle(rageScroll, "R_Tracer", "Трассеры (Snaplines)", "R: Tracers", R, "ShowTracers", RA)
    AddToggle(rageScroll, "R_Offscr", "Стрелки целей вне экрана", "R: Offscreen", R, "ShowOffscreen", RA)
    AddToggle(rageScroll, "R_Part", "Партиклы над головой", "R: Particles", R, "ShowParticles", RA)
    AddCycleButton(rageScroll, "Дальность ESP", R, "EspMaxDist", { 1000, 2000, 3500, 5000 }, function(v) return v .. " st" end, RA)

    AddSectionHeader(rageScroll, "Модуль 4: Weapon Modifier", RA)
    AddToggle(rageScroll, "R_Recoil", "Полный No Recoil", "R: No Recoil", R, "NoRecoil", RA)
    AddToggle(rageScroll, "R_Shake", "Полный No Camera Shake", "R: No Shake", R, "NoShake", RA)
    AddToggle(rageScroll, "R_Fire", "Auto Fire по цели", "R: Auto Fire", R, "AutoFire", RA)

    -- Анимация появления главного окна (0.3 сек, Back easing)
    MainWindow.Size = UDim2.new(0, 0, 0, 0)
    TweenService:Create(
        MainWindow,
        TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        { Size = UDim2.new(0, 380, 0, 470) }
    ):Play()
end

-- // 8. ИНИЦИАЛИЗАЦИЯ ВСЕХ МОДУЛЕЙ
local function Init()
    BuildUI()

    local cAdded = Players.PlayerAdded:Connect(function(player)
        VisualOverlay.CreatePlayerEsp(player)
        local cChar = player.CharacterAdded:Connect(function(char)
            task.wait(0.3)
            HitboxModifier.ApplyToCharacter(char)
        end)
        table.insert(Connections, cChar)
    end)

    local cRemoving = Players.PlayerRemoving:Connect(function(player)
        if player.Character then
            HitboxModifier.RestoreCharacter(player.Character)
        end
        VisualOverlay.RemovePlayerEsp(player)
    end)

    table.insert(Connections, cAdded)
    table.insert(Connections, cRemoving)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            VisualOverlay.CreatePlayerEsp(player)
            if player.Character then
                HitboxModifier.ApplyToCharacter(player.Character)
            end
            local cChar = player.CharacterAdded:Connect(function(char)
                task.wait(0.3)
                HitboxModifier.ApplyToCharacter(char)
            end)
            table.insert(Connections, cChar)
        end
    end

    local aimBindName = "BRM5_TargetAssist_Render"
    RunService:BindToRenderStep(aimBindName, Enum.RenderPriority.Camera.Value + 1, TargetAssist.Step)
    table.insert(RenderBindings, aimBindName)

    local cRender = RunService.RenderStepped:Connect(function()
        if State.Unloaded then return end
        pcall(HitboxModifier.Update)
        pcall(VisualOverlay.Update)
        pcall(WeaponModifier.Step)
    end)
    table.insert(Connections, cRender)

    Utils.Notify("BRM5 Tactical Suite", "Система загружена. Доступны 2D-боксы, индикаторы и HUD-плашки.", Utils.Colors.LegitAccent)
end

Init()
