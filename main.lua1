-- // BRM5 Tactical Suite (PvP + PvE, PC + Mobile)
-- // Единый модульный клиентский скрипт

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer
local IsMobile = UserInputService.TouchEnabled and not UserInputService.MouseEnabled

-- // =========================================================================
-- // КОНФИГ СБОРКИ (BUILD-DEPENDENT VALUES)
-- // =========================================================================
local Config = {
    BuildTag = "Unverified / Generic Roblox + BRM5",
    -- Если знаешь точное имя папки с NPC в Workspace (через Dex), впиши сюда.
    -- Пока список пустой — используется универсальный сканер Workspace.
    NpcContainerNames = {
        -- "NPCs", "Enemies", "Bots" (не проверено на текущей сборке BRM5)
    },
    NpcRescanInterval = 1.0,      -- как часто обновлять кэш NPC (сек)
    MaxHighlights = 20,           -- лимит движка Roblox ~31 Highlight одновременно
    GuiName = "REBASE_BRM5_Suite",
}

-- // =========================================================================
-- // 1. СОСТОЯНИЕ (STATE)
-- // =========================================================================
local State = {
    ActiveMode = "Main",          -- "Main" | "Legit" | "Rage"
    TargetMode = "Both",          -- "Both" | "PvP" | "PvE"
    TeamCheck = true,             -- игнорировать союзников в PvP
    Minimized = false,
    UiLocked = false,
    Unloaded = false,

    Legit = {
        AimEnabled = false,
        Smoothness = 0.22,        -- 0.05 (плавно) .. 1.0 (мгновенно)
        TargetPart = "Head",      -- "Head" | "Torso" | "HumanoidRootPart"
        MaxDistance = 300,
        FovRadius = 150,
        ShowFov = true,
        RequireRMB = not IsMobile,
        VisibleOnly = true,

        HitboxEnabled = false,
        HitboxScale = 2.0,

        EspEnabled = false,
        BoxStyle = "Corners",     -- "Corners" | "Full" | "Off"
        ShowHpBar = true,
        ShowInfo = true,
        ShowHeadDot = true,
        ShowTracers = false,
        ShowOffscreen = true,
        ShowHighlight = false,
        EspMaxDist = 1000,
        EspVisibleOnly = false,

        CamStabilizer = false,    -- базовая компенсация вертикального рывка камеры
        StabilizerPower = 0.65,
    },

    Rage = {
        AimEnabled = false,
        TargetPart = "Head",
        MaxDistance = 2000,
        IgnoreWalls = true,

        HitboxEnabled = false,
        HitboxScale = 5.0,

        EspEnabled = false,
        BoxStyle = "Full",
        ShowHpBar = true,
        ShowInfo = true,
        ShowHeadDot = true,
        ShowTracers = true,
        ShowOffscreen = true,
        ShowHighlight = true,
        EspMaxDist = 3000,
        EspVisibleOnly = false,

        CamStabilizer = false,
        StabilizerPower = 0.9,
    }
}

-- // Реестры для чистой выгрузки
local Connections = {}
local RenderBindings = {}
local OriginalHitboxes = {}       -- [BasePart] = { Size, Transparency, CanCollide, Massless }
local EspEntries = {}             -- [Model] = { Container, ... }
local HighlightCache = {}         -- [Model] = Highlight
local CachedNpcs = {}
local LastNpcScan = 0

local Camera = Workspace.CurrentCamera
table.insert(Connections, Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    Camera = Workspace.CurrentCamera
end))

local function GetCamera()
    if not Camera or not Camera.Parent then
        Camera = Workspace.CurrentCamera
    end
    return Camera
end

-- // =========================================================================
-- // 2. УТИЛИТЫ И ЦВЕТА
-- // =========================================================================
local Utils = {}

Utils.Colors = {
    Bg = Color3.fromRGB(10, 10, 13),
    Panel = Color3.fromRGB(16, 17, 22),
    PanelLight = Color3.fromRGB(22, 24, 31),
    Element = Color3.fromRGB(24, 26, 34),
    ElementHover = Color3.fromRGB(32, 35, 46),
    Border = Color3.fromRGB(44, 48, 62),
    Text = Color3.fromRGB(242, 244, 250),
    SubText = Color3.fromRGB(145, 152, 172),
    LegitAccent = Color3.fromRGB(55, 145, 255),
    RageAccent = Color3.fromRGB(255, 52, 72),
    NpcAccent = Color3.fromRGB(255, 165, 45),
    LockAccent = Color3.fromRGB(255, 185, 45),
    Green = Color3.fromRGB(55, 230, 120),
    Yellow = Color3.fromRGB(255, 210, 60),
    White = Color3.fromRGB(255, 255, 255),
}

function Utils.GetSafeGuiParent()
    if type(gethui) == "function" then
        local ok, ui = pcall(gethui)
        if ok and ui then return ui end
    end
    local ok = pcall(function()
        local _ = CoreGui.Name
    end)
    if ok then
        return CoreGui
    end
    return LocalPlayer:WaitForChild("PlayerGui")
end

function Utils.Create(className, props, parent)
    local inst = Instance.new(className)
    for k, v in pairs(props or {}) do
        inst[k] = v
    end
    if parent then
        inst.Parent = parent
    end
    return inst
end

function Utils.AddCorner(parent, radius)
    return Utils.Create("UICorner", { CornerRadius = UDim.new(0, radius or 6) }, parent)
end

function Utils.AddStroke(parent, color, thickness, transparency)
    return Utils.Create("UIStroke", {
        Color = color or Utils.Colors.Border,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, parent)
end

function Utils.MakeDraggable(dragHandle, targetFrame)
    local dragging = false
    local dragInput, dragStart, startPos

    local function update(input)
        if State.UiLocked then
            dragging = false
            return
        end
        local delta = input.Position - dragStart
        targetFrame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end

    table.insert(Connections, dragHandle.InputBegan:Connect(function(input)
        if State.UiLocked then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = targetFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end))

    table.insert(Connections, dragHandle.InputChanged:Connect(function(input)
        if State.UiLocked then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end))

    table.insert(Connections, UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            update(input)
        end
    end))
end

function Utils.GetHumanoid(model)
    if not model or not model.Parent then return nil end
    return model:FindFirstChildOfClass("Humanoid")
end

function Utils.IsAlive(model)
    local hum = Utils.GetHumanoid(model)
    return hum ~= nil and hum.Health > 0
end

function Utils.GetBodyPart(model, partName)
    if not model or not model.Parent then return nil end
    local part = model:FindFirstChild(partName)
    if part and part:IsA("BasePart") then return part end

    if partName == "Torso" then
        local upper = model:FindFirstChild("UpperTorso") or model:FindFirstChild("LowerTorso")
        if upper and upper:IsA("BasePart") then return upper end
    end

    local head = model:FindFirstChild("Head")
    if partName == "Head" and head and head:IsA("BasePart") then return head end

    local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    if hrp and hrp:IsA("BasePart") then return hrp end

    return model:FindFirstChildWhichIsA("BasePart")
end

function Utils.IsVisible(targetPart, targetModel)
    local cam = GetCamera()
    if not targetPart or not cam then return false end

    local origin = cam.CFrame.Position
    local direction = targetPart.Position - origin
    if direction.Magnitude < 0.05 then return true end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ignore = { cam }
    if LocalPlayer.Character then
        table.insert(ignore, LocalPlayer.Character)
    end
    if targetModel then
        table.insert(ignore, targetModel)
    end
    params.FilterDescendantsInstances = ignore

    local ok, result = pcall(Workspace.Raycast, Workspace, origin, direction, params)
    if not ok then return false end
    return result == nil
end

function Utils.GetHealthColor(ratio)
    ratio = math.clamp(ratio, 0, 1)
    if ratio > 0.5 then
        return Utils.Colors.Yellow:Lerp(Utils.Colors.Green, (ratio - 0.5) * 2)
    else
        return Utils.Colors.RageAccent:Lerp(Utils.Colors.Yellow, ratio * 2)
    end
end

local NotifyHolder = nil
function Utils.Notify(title, text, accent)
    if not NotifyHolder or not NotifyHolder.Parent then return end
    local color = accent or Utils.Colors.LegitAccent

    local toast = Utils.Create("Frame", {
        Size = UDim2.new(1, 0, 0, 44),
        BackgroundColor3 = Utils.Colors.Panel,
        BackgroundTransparency = 1,
        ClipsDescendants = true,
    }, NotifyHolder)
    Utils.AddCorner(toast, 8)
    local stroke = Utils.AddStroke(toast, color, 1.2, 1)

    local bar = Utils.Create("Frame", {
        Size = UDim2.new(0, 3, 1, -10),
        Position = UDim2.new(0, 5, 0, 5),
        BackgroundColor3 = color,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
    }, toast)
    Utils.AddCorner(bar, 2)

    local tTitle = Utils.Create("TextLabel", {
        Size = UDim2.new(1, -16, 0, 16),
        Position = UDim2.new(0, 13, 0, 5),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = Utils.Colors.Text,
        TextTransparency = 1,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, toast)

    local tDesc = Utils.Create("TextLabel", {
        Size = UDim2.new(1, -16, 0, 16),
        Position = UDim2.new(0, 13, 0, 22),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = Utils.Colors.SubText,
        TextTransparency = 1,
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, toast)

    TweenService:Create(toast, TweenInfo.new(0.2), { BackgroundTransparency = 0.05 }):Play()
    TweenService:Create(stroke, TweenInfo.new(0.2), { Transparency = 0.25 }):Play()
    TweenService:Create(bar, TweenInfo.new(0.2), { BackgroundTransparency = 0 }):Play()
    TweenService:Create(tTitle, TweenInfo.new(0.2), { TextTransparency = 0 }):Play()
    TweenService:Create(tDesc, TweenInfo.new(0.2), { TextTransparency = 0 }):Play()

    task.delay(2.0, function()
        if toast and toast.Parent then
            TweenService:Create(toast, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
            TweenService:Create(stroke, TweenInfo.new(0.25), { Transparency = 1 }):Play()
            TweenService:Create(bar, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
            TweenService:Create(tTitle, TweenInfo.new(0.25), { TextTransparency = 1 }):Play()
            local tw = TweenService:Create(tDesc, TweenInfo.new(0.25), { TextTransparency = 1 })
            tw:Play()
            tw.Completed:Wait()
            if toast then toast:Destroy() end
        end
    end)
end

-- // =========================================================================
-- // 3. СБОРЩИК ЦЕЛЕЙ (PvP + PvE)
-- // =========================================================================
local Targets = {}

local function IsFriendlyPlayer(player)
    if not State.TeamCheck then return false end
    if not LocalPlayer.Team or not player.Team then return false end
    return player.Team == LocalPlayer.Team
end

local function RescanNpcs()
    local found = {}
    local seen = {}

    local function scanRoot(root)
        for _, inst in ipairs(root:GetDescendants()) do
            if inst:IsA("Humanoid") then
                local model = inst.Parent
                if model and model:IsA("Model") and not seen[model] then
                    if model ~= LocalPlayer.Character and Players:GetPlayerFromCharacter(model) == nil then
                        if inst.Health > 0 and Utils.GetBodyPart(model, "HumanoidRootPart") then
                            seen[model] = true
                            table.insert(found, model)
                        end
                    end
                end
            end
        end
    end

    local usedCustom = false
    for _, name in ipairs(Config.NpcContainerNames) do
        local folder = Workspace:FindFirstChild(name)
        if folder then
            usedCustom = true
            scanRoot(folder)
        end
    end

    if not usedCustom then
        scanRoot(Workspace)
    end

    CachedNpcs = found
    LastNpcScan = os.clock()
end

-- Возвращает список { Model = Model, Name = string, IsNpc = boolean, Humanoid = Humanoid }
function Targets.GetAll()
    local list = {}
    local mode = State.TargetMode

    if mode == "Both" or mode == "PvP" then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and not IsFriendlyPlayer(player) then
                local char = player.Character
                local hum = Utils.GetHumanoid(char)
                if hum and hum.Health > 0 then
                    table.insert(list, {
                        Model = char,
                        Name = player.DisplayName ~= "" and player.DisplayName or player.Name,
                        IsNpc = false,
                        Humanoid = hum,
                    })
                end
            end
        end
    end

    if mode == "Both" or mode == "PvE" then
        if (os.clock() - LastNpcScan) >= Config.NpcRescanInterval then
            RescanNpcs()
        end
        for _, npc in ipairs(CachedNpcs) do
            if npc and npc.Parent then
                local hum = Utils.GetHumanoid(npc)
                if hum and hum.Health > 0 then
                    table.insert(list, {
                        Model = npc,
                        Name = "[NPC] " .. npc.Name,
                        IsNpc = true,
                        Humanoid = hum,
                    })
                end
            end
        end
    end

    return list
end

-- // =========================================================================
-- // 4. TARGET ASSIST (AIM)
-- // =========================================================================
local TargetAssist = {}
local FovCircleFrame = nil

function TargetAssist.GetBestTarget(cam)
    local isRage = State.Rage.AimEnabled
    local isLegit = State.Legit.AimEnabled and not isRage
    if not isRage and not isLegit then return nil end

    local maxDist = isRage and State.Rage.MaxDistance or State.Legit.MaxDistance
    local fovLimit = isRage and math.huge or State.Legit.FovRadius
    local partName = isRage and State.Rage.TargetPart or State.Legit.TargetPart
    local checkWalls = isRage and (not State.Rage.IgnoreWalls) or State.Legit.VisibleOnly

    local vp = cam.ViewportSize
    local screenCenter = Vector2.new(vp.X * 0.5, vp.Y * 0.5)
    local camPos = cam.CFrame.Position

    local bestPart = nil
    local bestScore = fovLimit

    for _, entry in ipairs(Targets.GetAll()) do
        local part = Utils.GetBodyPart(entry.Model, partName)
        if part then
            local dist3D = (part.Position - camPos).Magnitude
            if dist3D <= maxDist and dist3D > 0.1 then
                local sp, onScreen = cam:WorldToViewportPoint(part.Position)
                if (onScreen and sp.Z > 0) or isRage then
                    local score
                    if onScreen and sp.Z > 0 then
                        score = (Vector2.new(sp.X, sp.Y) - screenCenter).Magnitude
                    else
                        score = dist3D + 5000
                    end

                    if score <= bestScore then
                        if not checkWalls or Utils.IsVisible(part, entry.Model) then
                            bestScore = score
                            bestPart = part
                        end
                    end
                end
            end
        end
    end

    return bestPart
end

function TargetAssist.Step(dt)
    if State.Unloaded then return end
    local cam = GetCamera()
    if not cam then return end

    if FovCircleFrame then
        local show = State.Legit.AimEnabled and State.Legit.ShowFov and not State.Rage.AimEnabled
        FovCircleFrame.Visible = show
        if show then
            local d = State.Legit.FovRadius * 2
            FovCircleFrame.Size = UDim2.fromOffset(d, d)
            FovCircleFrame.Position = UDim2.new(0.5, -State.Legit.FovRadius, 0.5, -State.Legit.FovRadius)
        end
    end

    local isRage = State.Rage.AimEnabled
    local isLegit = State.Legit.AimEnabled and not isRage
    if not isRage and not isLegit then return end

    if isLegit and State.Legit.RequireRMB then
        if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
            return
        end
    end

    local targetPart = TargetAssist.GetBestTarget(cam)
    if not targetPart then return end

    local camPos = cam.CFrame.Position
    if (targetPart.Position - camPos).Magnitude < 0.05 then return end

    local goal = CFrame.lookAt(camPos, targetPart.Position)
    if isRage then
        cam.CFrame = goal
    else
        local alpha = math.clamp(State.Legit.Smoothness * (dt * 60), 0.02, 1)
        cam.CFrame = cam.CFrame:Lerp(goal, alpha)
    end
end

-- // =========================================================================
-- // 5. HITBOX MODIFIER
-- // =========================================================================
local HitboxMod = {}

function HitboxMod.RestorePart(part)
    local orig = OriginalHitboxes[part]
    if not orig then return end
    if part and part.Parent then
        pcall(function()
            part.Size = orig.Size
            part.Transparency = orig.Transparency
            part.CanCollide = orig.CanCollide
            part.Massless = orig.Massless
        end)
    end
    OriginalHitboxes[part] = nil
end

function HitboxMod.RestoreAll()
    for part in pairs(OriginalHitboxes) do
        HitboxMod.RestorePart(part)
    end
end

function HitboxMod.Step()
    if State.Unloaded then return end

    local isRage = State.Rage.HitboxEnabled
    local isLegit = State.Legit.HitboxEnabled and not isRage

    if not isRage and not isLegit then
        if next(OriginalHitboxes) ~= nil then
            HitboxMod.RestoreAll()
        end
        return
    end

    local scale = isRage and State.Rage.HitboxScale or State.Legit.HitboxScale
    local partName = isRage and State.Rage.TargetPart or State.Legit.TargetPart
    local activeParts = {}

    for _, entry in ipairs(Targets.GetAll()) do
        local part = Utils.GetBodyPart(entry.Model, partName)
        if part then
            activeParts[part] = true
            if not OriginalHitboxes[part] then
                OriginalHitboxes[part] = {
                    Size = part.Size,
                    Transparency = part.Transparency,
                    CanCollide = part.CanCollide,
                    Massless = part.Massless,
                }
            end
            local orig = OriginalHitboxes[part]
            local targetSize = orig.Size * scale
            if (part.Size - targetSize).Magnitude > 0.05 then
                pcall(function()
                    part.Size = targetSize
                    part.Transparency = 0.65
                    part.CanCollide = false
                    part.Massless = true
                end)
            end
        end
    end

    for part in pairs(OriginalHitboxes) do
        if not activeParts[part] then
            HitboxMod.RestorePart(part)
        end
    end
end

-- // =========================================================================
-- // 6. TACTICAL ESP (100% ScreenGui + Highlight)
-- // =========================================================================
local EspMod = {}
local OverlayLayer = nil

local function CreateEspEntry()
    local root = Utils.Create("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Visible = false,
    }, OverlayLayer)

    local box = Utils.Create("Frame", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Visible = false,
    }, root)
    local boxStroke = Utils.AddStroke(box, Utils.Colors.LegitAccent, 1.4, 0)

    local corners = {}
    for i = 1, 8 do
        corners[i] = Utils.Create("Frame", {
            BorderSizePixel = 0,
            BackgroundColor3 = Utils.Colors.LegitAccent,
            Visible = false,
        }, root)
    end

    local hpBg = Utils.Create("Frame", {
        BackgroundColor3 = Color3.fromRGB(15, 15, 18),
        BorderSizePixel = 0,
        Visible = false,
    }, root)
    local hpFill = Utils.Create("Frame", {
        BackgroundColor3 = Utils.Colors.Green,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.fromScale(0, 1),
        Size = UDim2.fromScale(1, 1),
    }, hpBg)

    local infoLabel = Utils.Create("TextLabel", {
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextColor3 = Utils.Colors.Text,
        TextStrokeTransparency = 0.35,
        Size = UDim2.fromOffset(180, 16),
        AnchorPoint = Vector2.new(0.5, 1),
        Visible = false,
    }, root)

    local headDot = Utils.Create("Frame", {
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(5, 5),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Utils.Colors.White,
        Visible = false,
    }, root)
    Utils.AddCorner(headDot, 4)

    local tracer = Utils.Create("Frame", {
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Utils.Colors.LegitAccent,
        Visible = false,
    }, root)

    local offscreen = Utils.Create("Frame", {
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(10, 10),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Rotation = 45,
        BackgroundColor3 = Utils.Colors.LegitAccent,
        Visible = false,
    }, root)

    return {
        Root = root,
        Box = box,
        BoxStroke = boxStroke,
        Corners = corners,
        HpBg = hpBg,
        HpFill = hpFill,
        Info = infoLabel,
        HeadDot = headDot,
        Tracer = tracer,
        Offscreen = offscreen,
    }
end

local function DestroyEspEntry(model)
    local e = EspEntries[model]
    if e then
        if e.Root then e.Root:Destroy() end
        EspEntries[model] = nil
    end
end

local function DestroyHighlight(model)
    local hl = HighlightCache[model]
    if hl then
        pcall(function() hl:Destroy() end)
        HighlightCache[model] = nil
    end
end

function EspMod.ClearAll()
    for model in pairs(EspEntries) do
        DestroyEspEntry(model)
    end
    for model in pairs(HighlightCache) do
        DestroyHighlight(model)
    end
end

local function UpdateCorners(corners, x, y, w, h, color)
    local len = math.clamp(math.min(w, h) * 0.28, 4, 16)
    local t = 1.6
    local layout = {
        { x, y, len, t },
        { x, y, t, len },
        { x + w - len, y, len, t },
        { x + w - t, y, t, len },
        { x, y + h - t, len, t },
        { x, y + h - len, t, len },
        { x + w - len, y + h - t, len, t },
        { x + w - t, y + h - len, t, len },
    }
    for i = 1, 8 do
        local c = corners[i]
        local d = layout[i]
        c.Position = UDim2.fromOffset(d[1], d[2])
        c.Size = UDim2.fromOffset(d[3], d[4])
        c.BackgroundColor3 = color
        c.Visible = true
    end
end

function EspMod.Step()
    if State.Unloaded or not OverlayLayer then return end
    local cam = GetCamera()
    if not cam then return end

    local isRage = State.Rage.EspEnabled
    local isLegit = State.Legit.EspEnabled and not isRage

    if not isRage and not isLegit then
        if next(EspEntries) ~= nil or next(HighlightCache) ~= nil then
            EspMod.ClearAll()
        end
        return
    end

    local cfg = isRage and State.Rage or State.Legit
    local vp = cam.ViewportSize
    local camPos = cam.CFrame.Position
    local seen = {}
    local activeHighlights = 0

    for _, entry in ipairs(Targets.GetAll()) do
        local model = entry.Model
        local rootPart = Utils.GetBodyPart(model, "HumanoidRootPart")
        local headPart = Utils.GetBodyPart(model, "Head") or rootPart
        if rootPart and headPart then
            local dist = (rootPart.Position - camPos).Magnitude
            if dist <= cfg.EspMaxDist then
                local visiblePass = (not cfg.EspVisibleOnly) or Utils.IsVisible(headPart, model)
                if visiblePass then
                    seen[model] = true
                    local ui = EspEntries[model]
                    if not ui then
                        ui = CreateEspEntry()
                        EspEntries[model] = ui
                    end

                    local accent = entry.IsNpc and Utils.Colors.NpcAccent or (isRage and Utils.Colors.RageAccent or Utils.Colors.LegitAccent)
                    local topPos, topOn = cam:WorldToViewportPoint(headPart.Position + Vector3.new(0, 0.7, 0))
                    local botPos, botOn = cam:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3.0, 0))
                    local onScreen = (topOn or botOn) and topPos.Z > 0 and botPos.Z > 0

                    ui.Root.Visible = true

                    if onScreen then
                        ui.Offscreen.Visible = false

                        local h = math.clamp(math.abs(botPos.Y - topPos.Y), 12, vp.Y * 1.4)
                        local w = h * 0.56
                        local cx = (topPos.X + botPos.X) * 0.5
                        local x = cx - w * 0.5
                        local y = math.min(topPos.Y, botPos.Y)

                        -- Box / Corners
                        if cfg.BoxStyle == "Full" then
                            ui.Box.Visible = true
                            ui.Box.Position = UDim2.fromOffset(x, y)
                            ui.Box.Size = UDim2.fromOffset(w, h)
                            ui.BoxStroke.Color = accent
                            for i = 1, 8 do ui.Corners[i].Visible = false end
                        elseif cfg.BoxStyle == "Corners" then
                            ui.Box.Visible = false
                            UpdateCorners(ui.Corners, x, y, w, h, accent)
                        else
                            ui.Box.Visible = false
                            for i = 1, 8 do ui.Corners[i].Visible = false end
                        end

                        -- HP Bar
                        if cfg.ShowHpBar then
                            local ratio = math.clamp(entry.Humanoid.Health / math.max(entry.Humanoid.MaxHealth, 1), 0, 1)
                            ui.HpBg.Visible = true
                            ui.HpBg.Position = UDim2.fromOffset(x - 6, y)
                            ui.HpBg.Size = UDim2.fromOffset(3, h)
                            ui.HpFill.Size = UDim2.fromScale(1, ratio)
                            ui.HpFill.BackgroundColor3 = Utils.GetHealthColor(ratio)
                        else
                            ui.HpBg.Visible = false
                        end

                        -- Name + Distance
                        if cfg.ShowInfo then
                            ui.Info.Visible = true
                            ui.Info.Position = UDim2.fromOffset(cx, y - 3)
                            ui.Info.Text = string.format("%s [%dm]", entry.Name, math.floor(dist))
                            ui.Info.TextColor3 = entry.IsNpc and Utils.Colors.NpcAccent or Utils.Colors.Text
                        else
                            ui.Info.Visible = false
                        end

                        -- Head Dot
                        if cfg.ShowHeadDot then
                            local hp, hon = cam:WorldToViewportPoint(headPart.Position)
                            ui.HeadDot.Visible = hon and hp.Z > 0
                            ui.HeadDot.Position = UDim2.fromOffset(hp.X, hp.Y)
                            ui.HeadDot.BackgroundColor3 = accent
                        else
                            ui.HeadDot.Visible = false
                        end

                        -- Tracer
                        if cfg.ShowTracers then
                            local sx, sy = vp.X * 0.5, vp.Y
                            local ex, ey = cx, y + h
                            local dx, dy = ex - sx, ey - sy
                            local len = math.sqrt(dx * dx + dy * dy)
                            ui.Tracer.Visible = true
                            ui.Tracer.Position = UDim2.fromOffset((sx + ex) * 0.5, (sy + ey) * 0.5)
                            ui.Tracer.Size = UDim2.fromOffset(len, 1.3)
                            ui.Tracer.Rotation = math.deg(math.atan2(dy, dx))
                            ui.Tracer.BackgroundColor3 = accent
                        else
                            ui.Tracer.Visible = false
                        end
                    else
                        ui.Box.Visible = false
                        for i = 1, 8 do ui.Corners[i].Visible = false end
                        ui.HpBg.Visible = false
                        ui.Info.Visible = false
                        ui.HeadDot.Visible = false
                        ui.Tracer.Visible = false

                        if cfg.ShowOffscreen then
                            local rel = cam.CFrame:PointToObjectSpace(rootPart.Position)
                            local angle = math.atan2(-rel.Y, rel.X)
                            local radius = math.min(vp.X, vp.Y) * 0.42
                            local ox = vp.X * 0.5 + math.cos(angle) * radius
                            local oy = vp.Y * 0.5 + math.sin(angle) * radius
                            ui.Offscreen.Visible = true
                            ui.Offscreen.Position = UDim2.fromOffset(
                                math.clamp(ox, 16, vp.X - 16),
                                math.clamp(oy, 16, vp.Y - 16)
                            )
                            ui.Offscreen.BackgroundColor3 = accent
                        else
                            ui.Offscreen.Visible = false
                        end
                    end

                    -- Highlight (Chams) с учётом лимита движка
                    if cfg.ShowHighlight and activeHighlights < Config.MaxHighlights then
                        activeHighlights += 1
                        local hl = HighlightCache[model]
                        if not hl or not hl.Parent then
                            hl = Utils.Create("Highlight", {
                                Adornee = model,
                                DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
                                FillColor = accent,
                                FillTransparency = 0.65,
                                OutlineColor = Utils.Colors.White,
                                OutlineTransparency = 0.15,
                            }, model)
                            HighlightCache[model] = hl
                        else
                            hl.FillColor = accent
                        end
                    else
                        DestroyHighlight(model)
                    end
                end
            end
        end
    end

    for model in pairs(EspEntries) do
        if not seen[model] then
            DestroyEspEntry(model)
        end
    end
    for model in pairs(HighlightCache) do
        if not seen[model] then
            DestroyHighlight(model)
        end
    end
end

-- // =========================================================================
-- // 7. WEAPON / CAMERA STABILIZER (Универсальный уровень камеры)
-- // =========================================================================
local WeaponMod = {}
local LastPitch = nil

function WeaponMod.Step()
    if State.Unloaded then return end
    local isRage = State.Rage.CamStabilizer
    local isLegit = State.Legit.CamStabilizer and not isRage
    if not isRage and not isLegit then
        LastPitch = nil
        return
    end

    local cam = GetCamera()
    if not cam then return end

    local firing = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
    local pitch, yaw, roll = cam.CFrame:ToOrientation()

    if firing and LastPitch then
        local deltaPitch = pitch - LastPitch
        -- Компенсируем только резкий рывок вверх (отдача), не мешая ручному прицеливанию
        if deltaPitch > 0.002 and deltaPitch < 0.25 then
            local power = isRage and State.Rage.StabilizerPower or State.Legit.StabilizerPower
            local correctedPitch = pitch - (deltaPitch * power)
            cam.CFrame = CFrame.new(cam.CFrame.Position) * CFrame.fromOrientation(correctedPitch, yaw, roll)
            pitch = correctedPitch
        end
    end

    LastPitch = pitch
end

