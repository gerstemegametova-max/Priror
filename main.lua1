    ActiveMode = "Main", -- "Main" | "Legit" | "Rage"
    Minimized = false,
    UiLocked = false,
    Unloaded = false,

    Legit = {
        -- Target Assist
        AimEnabled = false,
        Smoothness = 0.25,
        TargetPart = "Head", -- "Head" | "Torso" | "HumanoidRootPart"
        MaxDistance = 250,
        FovRadius = 150,
        ShowFov = true,
        RequireRMB = true,
        VisibleOnly = true,

        -- Hitbox Modifier
        HitboxEnabled = false,
        HitboxScale = 1.5,

        -- Visual Overlay (Tactical ESP)
        EspEnabled = false,
        BoxStyle = "Corners", -- "Corners" | "Full" | "Off"
        ShowHpBar = true,
        ShowName = true,
        ShowDistance = true,
        ShowHeadDot = true,
        ShowTracers = false,
        ShowOffscreen = true,
        ShowSkeleton = false,
        EspMaxDist = 1000,
        EspVisibleOnly = true,

        -- Weapon Modifier
        NoRecoil = false,
        RecoilStrength = 0.5,
        NoShake = false,
    },

    Rage = {
        -- Target Assist
        AimEnabled = false,
        MaxDistance = 2000,
        AutoTarget = true,
        IgnoreWalls = true,

        -- Hitbox Modifier
        HitboxEnabled = true,
        HitboxScale = 6.0,

        -- Visual Overlay (Full Tactical ESP)
        EspEnabled = false,
        BoxStyle = "Corners", -- "Corners" | "Full" | "Off"
        ShowHpBar = true,
        ShowInfoText = true,
        ShowHeadDot = true,
        ShowTracers = true,
        ShowOffscreen = true,
        ShowHighlight = true,
        ShowParticles = true,
        ShowSkeleton = true,
        EspMaxDist = 3500,

        -- Weapon Modifier
        NoRecoil = true,
        NoShake = true,
        AutoFire = false,
    }
}

-- // Кэш и реестр подключений
local Connections = {}
local RenderBindings = {}
local OriginalHitboxes = {}
local EspCache = {}
local ParticleCache = {}
local HighlightCache = {}
local PinnedHudButtons = {}
local ToggleSyncCallbacks = {}
local UpdateCardBadgesCallback = nil

-- // 2. УТИЛИТЫ И СТИЛИЗАЦИЯ
local Utils = {}

Utils.Colors = {
    Bg = Color3.fromRGB(10, 10, 13),
    Panel = Color3.fromRGB(16, 17, 22),
    PanelLight = Color3.fromRGB(22, 24, 31),
    Element = Color3.fromRGB(24, 26, 34),
    ElementHover = Color3.fromRGB(32, 35, 46),
    Border = Color3.fromRGB(44, 48, 62),
    Text = Color3.fromRGB(242, 244, 250),
    SubText = Color3.fromRGB(145, 152, 172),
    LegitAccent = Color3.fromRGB(55, 145, 255),
    LegitDark = Color3.fromRGB(20, 48, 95),
    RageAccent = Color3.fromRGB(255, 52, 72),
    RageDark = Color3.fromRGB(95, 20, 32),
    LockAccent = Color3.fromRGB(255, 185, 45),
    Green = Color3.fromRGB(55, 230, 120),
    Yellow = Color3.fromRGB(255, 210, 60),
    White = Color3.fromRGB(255, 255, 255),
    Black = Color3.fromRGB(0, 0, 0),
}

function Utils.Create(className, props, parent)
    local inst = Instance.new(className)
    for k, v in pairs(props or {}) do
        inst[k] = v
    end
    if parent then
        inst.Parent = parent
    end
    return inst
end

function Utils.AddCorner(parent, radius)
    return Utils.Create("UICorner", { CornerRadius = UDim.new(0, radius or 6) }, parent)
end

function Utils.AddStroke(parent, color, thickness, transparency)
    return Utils.Create("UIStroke", {
        Color = color or Utils.Colors.Border,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    }, parent)
end

function Utils.AddGradient(parent, c1, c2, rotation)
    return Utils.Create("UIGradient", {
        Color = ColorSequence.new(c1, c2),
        Rotation = rotation or 90
    }, parent)
end

-- // Универсальное перетаскивание с учётом заморозки (State.UiLocked) и тачскрина
function Utils.MakeDraggable(dragHandle, targetFrame)
    local dragging = false
    local dragInput, dragStart, startPos

    local function update(input)
        if State.UiLocked then
            dragging = false
            return
        end
        local delta = input.Position - dragStart
        targetFrame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end

    local c1 = dragHandle.InputBegan:Connect(function(input)
        if State.UiLocked then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = targetFrame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    local c2 = dragHandle.InputChanged:Connect(function(input)
        if State.UiLocked then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    local c3 = UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            update(input)
        end
    end)

    table.insert(Connections, c1)
    table.insert(Connections, c2)
    table.insert(Connections, c3)
end

-- // Безопасный поиск частей персонажа (BRM5, R6 и R15)
function Utils.GetBodyPart(character, partName)
    if not character or not character.Parent then return nil end
    local part = character:FindFirstChild(partName)
    if part and part:IsA("BasePart") then
        return part
    end
    if partName == "Torso" then
        local upper = character:FindFirstChild("UpperTorso")
        if upper and upper:IsA("BasePart") then return upper end
    end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if hrp and hrp:IsA("BasePart") then
        return hrp
    end
    return nil
end

-- // Проверка видимости через Workspace:Raycast
function Utils.IsVisible(targetPart, targetCharacter)
    if not targetPart or not Camera then return false end
    local origin = Camera.CFrame.Position
    local direction = targetPart.Position - origin

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local ignoreList = { Camera }
    if LocalPlayer.Character then
        table.insert(ignoreList, LocalPlayer.Character)
    end
    if targetCharacter then
        table.insert(ignoreList, targetCharacter)
    end
    rayParams.FilterDescendantsInstances = ignoreList

    local ok, result = pcall(function()
        return Workspace:Raycast(origin, direction, rayParams)
    end)

    if not ok then return false end
    return result == nil
end

function Utils.IsAlive(character)
    if not character or not character.Parent then return false end
    local hum = character:FindFirstChild("Humanoid")
    return hum and hum:IsA("Humanoid") and hum.Health > 0
end

-- // Плавный градиент цвета здоровья (Зелёный -> Жёлтый -> Красный)
function Utils.GetHealthColor(ratio)
    ratio = math.clamp(ratio, 0, 1)
    if ratio > 0.5 then
        local t = (ratio - 0.5) * 2
        return Utils.Colors.Yellow:Lerp(Utils.Colors.Green, t)
    else
        local t = ratio * 2
        return Utils.Colors.RageAccent:Lerp(Utils.Colors.Yellow, t)
    end
end

-- // Система уведомлений
local NotifyHolder
function Utils.Notify(title, text, accentColor)
    if not NotifyHolder or not NotifyHolder.Parent then return end
    local accent = accentColor or Utils.Colors.LegitAccent

    local toast = Utils.Create("Frame", {
        Size = UDim2.new(1, 0, 0, 48),
        BackgroundColor3 = Utils.Colors.Panel,
        BackgroundTransparency = 1,
        ClipsDescendants = true
    }, NotifyHolder)
    Utils.AddCorner(toast, 8)
    local stroke = Utils.AddStroke(toast, accent, 1.2, 1)

    local bar = Utils.Create("Frame", {
        Size = UDim2.new(0, 3, 1, -10),
        Position = UDim2.new(0, 5, 0, 5),
        BackgroundColor3 = accent,
        BackgroundTransparency = 1,
        BorderSizePixel = 0
    }, toast)
    Utils.AddCorner(bar, 2)

    local tTitle = Utils.Create("TextLabel", {
        Size = UDim2.new(1, -18, 0, 18),
        Position = UDim2.new(0, 14, 0, 5),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = Utils.Colors.Text,
        TextTransparency = 1,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left
    }, toast)

    local tDesc = Utils.Create("TextLabel", {
        Size = UDim2.new(1, -18, 0, 18),
        Position = UDim2.new(0, 14, 0, 23),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = Utils.Colors.SubText,
        TextTransparency = 1,
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left
    }, toast)

    TweenService:Create(toast, TweenInfo.new(0.22), { BackgroundTransparency = 0.04 }):Play()
    TweenService:Create(stroke, TweenInfo.new(0.22), { Transparency = 0.2 }):Play()
    TweenService:Create(bar, TweenInfo.new(0.22), { BackgroundTransparency = 0 }):Play()
    TweenService:Create(tTitle, TweenInfo.new(0.22), { TextTransparency = 0 }):Play()
    TweenService:Create(tDesc, TweenInfo.new(0.22), { TextTransparency = 0 }):Play()

    task.delay(2.2, function()
        if toast and toast.Parent then
            TweenService:Create(toast, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
            TweenService:Create(stroke, TweenInfo.new(0.25), { Transparency = 1 }):Play()
            TweenService:Create(bar, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
            TweenService:Create(tTitle, TweenInfo.new(0.25), { TextTransparency = 1 }):Play()
            local lastTw = TweenService:Create(tDesc, TweenInfo.new(0.25), { TextTransparency = 1 })
            lastTw:Play()
            lastTw.Completed:Wait()
            if toast then toast:Destroy() end
        end
    end)
end

-- // 3. МОДУЛЬ TARGET ASSIST (НАВЕДЕНИЕ КАМЕРЫ)
local TargetAssist = {}
local FovCircleFrame = nil

function TargetAssist.GetBestTarget()
    if not Camera then return nil end
    local isRage = State.Rage.AimEnabled
    local isLegit = State.Legit.AimEnabled and not isRage

    if not isRage and not isLegit then return nil end

    local maxDist = isRage and State.Rage.MaxDistance or State.Legit.MaxDistance
    local fovLimit = isRage and math.huge or State.Legit.FovRadius
    local partName = isRage and "Head" or State.Legit.TargetPart
    local checkWalls = isRage and (not State.Rage.IgnoreWalls) or State.Legit.VisibleOnly

    local screenCenter = Vector2.new(Camera.ViewportSize.X * 0.5, Camera.ViewportSize.Y * 0.5)
    local bestPart = nil
    local shortestScore = fovLimit

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if Utils.IsAlive(char) then
                local targetPart = Utils.GetBodyPart(char, partName)
                if targetPart then
                    local dist3D = (targetPart.Position - Camera.CFrame.Position).Magnitude
                    if dist3D <= maxDist then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                        if onScreen or isRage then
                            local screenVec = Vector2.new(screenPos.X, screenPos.Y)
                            local dist2D = onScreen and (screenVec - screenCenter).Magnitude or (dist3D + 1000)

                            if dist2D <= shortestScore then
                                if not checkWalls or Utils.IsVisible(targetPart, char) then
                                    shortestScore = dist2D
                                    bestPart = targetPart
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    return bestPart
end

function TargetAssist.Step()
    if State.Unloaded or not Camera then return end

    if FovCircleFrame then
        local show = State.Legit.AimEnabled and State.Legit.ShowFov and not State.Rage.AimEnabled
        FovCircleFrame.Visible = show
        if show then
            local d = State.Legit.FovRadius * 2
            FovCircleFrame.Size = UDim2.new(0, d, 0, d)
            FovCircleFrame.Position = UDim2.new(0.5, -State.Legit.FovRadius, 0.5, -State.Legit.FovRadius)
        end
    end

    local isRage = State.Rage.AimEnabled
    local isLegit = State.Legit.AimEnabled and not isRage
    if not isRage and not isLegit then return end

    if isLegit and State.Legit.RequireRMB then
        if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
            return
        end
    end

    local targetPart = TargetAssist.GetBestTarget()
    if targetPart then
        local camPos = Camera.CFrame.Position
        local goalCFrame = CFrame.lookAt(camPos, targetPart.Position)

        if isRage then
            Camera.CFrame = goalCFrame
        else
            local alpha = math.clamp(State.Legit.Smoothness, 0.05, 1.0)
            Camera.CFrame = Camera.CFrame:Lerp(goalCFrame, alpha)
        end
    end
end

-- // 4. МОДУЛЬ HITBOX MODIFIER (ИЗМЕНЕНИЕ ХИТБОКСОВ)
local HitboxModifier = {}
local AllBodyPartNames = {
    "Head", "Torso", "UpperTorso", "LowerTorso", "HumanoidRootPart",
    "Left Arm", "Right Arm", "Left Leg", "Right Leg",
    "LeftUpperArm", "LeftLowerArm", "LeftHand",
    "RightUpperArm", "RightLowerArm", "RightHand",
    "LeftUpperLeg", "LeftLowerLeg", "LeftFoot",
    "RightUpperLeg", "RightLowerLeg", "RightFoot"
}

function HitboxModifier.RestoreCharacter(character)
    local saved = OriginalHitboxes[character]
    if not saved then return end

    for part, data in pairs(saved) do
        if part and part.Parent then
            pcall(function()
                part.Size = data.Size
                part.Transparency = data.Transparency
                part.CanCollide = data.CanCollide
                local box = part:FindFirstChild("BRM5_HitboxOutline")
                if box then box:Destroy() end
            end)
        end
    end
    OriginalHitboxes[character] = nil
end

function HitboxModifier.RestoreAll()
    for char, _ in pairs(OriginalHitboxes) do
        HitboxModifier.RestoreCharacter(char)
    end
    OriginalHitboxes = {}
end

function HitboxModifier.ApplyToCharacter(character)
    if not character or not character.Parent then return end
    if not Utils.IsAlive(character) then
        HitboxModifier.RestoreCharacter(character)
        return
    end

    local isRage = State.Rage.HitboxEnabled
    local isLegit = State.Legit.HitboxEnabled and not isRage

    if not isRage and not isLegit then
        HitboxModifier.RestoreCharacter(character)
        return
    end

    local targetParts = isRage and AllBodyPartNames or { "Head" }
    local scale = isRage and State.Rage.HitboxScale or State.Legit.HitboxScale
    local outlineColor = isRage and Utils.Colors.RageAccent or Utils.Colors.White

    OriginalHitboxes[character] = OriginalHitboxes[character] or {}

    for _, partName in ipairs(targetParts) do
        local part = character:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            if not OriginalHitboxes[character][part] then
                OriginalHitboxes[character][part] = {
                    Size = part.Size,
                    Transparency = part.Transparency,
                    CanCollide = part.CanCollide
                }
            end

            local orig = OriginalHitboxes[character][part]
            pcall(function()
                part.Size = orig.Size * scale
                part.CanCollide = false
                if partName == "HumanoidRootPart" then
                    part.Transparency = 0.85
                end

                local outline = part:FindFirstChild("BRM5_HitboxOutline")
                if not outline then
                    outline = Instance.new("SelectionBox")
                    outline.Name = "BRM5_HitboxOutline"
                    outline.Adornee = part
                    outline.SurfaceTransparency = 0.92
                    outline.LineThickness = isRage and 0.04 or 0.02
                    outline.Parent = part
                end
                outline.Color3 = outlineColor
                outline.SurfaceColor3 = outlineColor
            end)
        end
    end
end

local lastHitboxTick = 0
function HitboxModifier.Update()
    if State.Unloaded then return end
    if tick() - lastHitboxTick < 0.15 then return end
    lastHitboxTick = tick()

    if not State.Rage.HitboxEnabled and not State.Legit.HitboxEnabled then
        if next(OriginalHitboxes) ~= nil then
            HitboxModifier.RestoreAll()
        end
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            HitboxModifier.ApplyToCharacter(player.Character)
        end
    end
end

-- // 5. МОДУЛЬ TACTICAL VISUAL OVERLAY (УЛУЧШЕННЫЙ ESP)
local VisualOverlay = {}
local EspFolder = nil

local SkeletonConnectionsR15 = {
    { "Head", "UpperTorso" },
    { "UpperTorso", "LowerTorso" },
    { "UpperTorso", "LeftUpperArm" },
    { "LeftUpperArm", "LeftLowerArm" },
    { "UpperTorso", "RightUpperArm" },
    { "RightUpperArm", "RightLowerArm" },
    { "LowerTorso", "LeftUpperLeg" },
    { "LeftUpperLeg", "LeftLowerLeg" },
    { "LowerTorso", "RightUpperLeg" },
    { "RightUpperLeg", "RightLowerLeg" }
}

local SkeletonConnectionsR6 = {
    { "Head", "Torso" },
    { "Torso", "Left Arm" },
    { "Torso", "Right Arm" },
    { "Torso", "Left Leg" },
    { "Torso", "Right Leg" }
}

function VisualOverlay.RemovePlayerEsp(player)
    local cache = EspCache[player]
    if cache then
        if cache.Container then cache.Container:Destroy() end
        EspCache[player] = nil
    end

    if HighlightCache[player] then
        HighlightCache[player]:Destroy()
        HighlightCache[player] = nil
    end

    if ParticleCache[player] then
        ParticleCache[player]:Destroy()
        ParticleCache[player] = nil
    end
end

-- // Создание предварительно выделенного пула 2D-элементов для игрока (0 лагов в RenderStepped)
function VisualOverlay.CreatePlayerEsp(player)
    if EspCache[player] or not EspFolder then return end

    local container = Utils.Create("Folder", { Name = "ESP_" .. player.Name }, EspFolder)

    -- Полный бокс с мягкой заливкой
    local fullBox = Utils.Create("Frame", {
        BackgroundColor3 = Utils.Colors.LegitAccent,
        BackgroundTransparency = 0.93,
        Visible = false
    }, container)
    local fullStroke = Utils.AddStroke(fullBox, Utils.Colors.LegitAccent, 1.5)

    -- 8 сегментов для тактических угловых рамок (Corner Box) + тень
    local cornerShadows = {}
    local cornerLines = {}
    for i = 1, 8 do
        local sh = Utils.Create("Frame", {
            BackgroundColor3 = Utils.Colors.Black,
            BackgroundTransparency = 0.35,
            BorderSizePixel = 0,
            ZIndex = 2,
            Visible = false
        }, container)
        local ln = Utils.Create("Frame", {
            BackgroundColor3 = Utils.Colors.LegitAccent,
            BorderSizePixel = 0,
            ZIndex = 3,
            Visible = false
        }, container)
        table.insert(cornerShadows, sh)
        table.insert(cornerLines, ln)
    end

    -- Вертикальная полоска HP слева от бокса + призрачный след урона
    local hpBg = Utils.Create("Frame", {
        BackgroundColor3 = Color3.fromRGB(12, 12, 16),
        BackgroundTransparency = 0.2,
        BorderSizePixel = 0,
        ZIndex = 3,
        Visible = false
    }, container)
    Utils.AddStroke(hpBg, Utils.Colors.Black, 1, 0.3)

    local hpGhost = Utils.Create("Frame", {
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 0, 1, 0),
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Utils.Colors.White,
        BackgroundTransparency = 0.25,
        BorderSizePixel = 0,
        ZIndex = 4
    }, hpBg)

    local hpFill = Utils.Create("Frame", {
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 0, 1, 0),
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Utils.Colors.Green,
        BorderSizePixel = 0,
        ZIndex = 5
    }, hpBg)

    -- Имя игрока сверху бокса
    local nameLabel = Utils.Create("TextLabel", {
        Size = UDim2.new(0, 200, 0, 16),
        AnchorPoint = Vector2.new(0.5, 1),
        BackgroundTransparency = 1,
        Text = player.Name,
        TextColor3 = Utils.Colors.White,
        TextStrokeColor3 = Utils.Colors.Black,
        TextStrokeTransparency = 0.2,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        ZIndex = 6,
        Visible = false
    }, container)

    -- Нижняя плашка дистанции / статуса / HP
    local infoBadge = Utils.Create("TextLabel", {
        Size = UDim2.new(0, 180, 0, 15),
        AnchorPoint = Vector2.new(0.5, 0),
        BackgroundTransparency = 1,
        Text = "0m",
        TextColor3 = Utils.Colors.SubText,
        TextStrokeColor3 = Utils.Colors.Black,
        TextStrokeTransparency = 0.25,
        Font = Enum.Font.GothamMedium,
        TextSize = 10,
        ZIndex = 6,
        Visible = false
    }, container)

    -- Прицельный маркер на голове (Head Dot)
    local headDot = Utils.Create("Frame", {
        Size = UDim2.new(0, 6, 0, 6),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Utils.Colors.White,
        BorderSizePixel = 0,
        ZIndex = 6,
        Visible = false
    }, container)
    Utils.AddCorner(headDot, 99)
    local headDotStroke = Utils.AddStroke(headDot, Utils.Colors.LegitAccent, 1.5)

    -- Трассер (Snapline)
    local tracer = Utils.Create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Utils.Colors.LegitAccent,
        BackgroundTransparency = 0.35,
        BorderSizePixel = 0,
        ZIndex = 2,
        Visible = false
    }, container)

    -- Индикатор цели вне экрана (Offscreen Arrow)
    local offscreenDot = Utils.Create("Frame", {
        Size = UDim2.new(0, 14, 0, 14),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Utils.Colors.LegitAccent,
        BackgroundTransparency = 0.15,
        Rotation = 45,
        BorderSizePixel = 0,
        ZIndex = 7,
        Visible = false
    }, container)
    Utils.AddCorner(offscreenDot, 3)
    Utils.AddStroke(offscreenDot, Utils.Colors.White, 1.2)

    -- Линии скелета (10 костей)
    local skelLines = {}
    for i = 1, 10 do
        local ln = Utils.Create("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            BorderSizePixel = 0,
            BackgroundColor3 = Utils.Colors.White,
            ZIndex = 3,
            Visible = false
        }, container)
        table.insert(skelLines, ln)
    end

    EspCache[player] = {
        Container = container,
        FullBox = fullBox,
        FullStroke = fullStroke,
        CornerShadows = cornerShadows,
        CornerLines = cornerLines,
        HpBg = hpBg,
        HpGhost = hpGhost,
        HpFill = hpFill,
        GhostRatio = 1,
        NameLabel = nameLabel,
        InfoBadge = infoBadge,
        HeadDot = headDot,
        HeadDotStroke = headDotStroke,
        Tracer = tracer,
        OffscreenDot = offscreenDot,
        SkelLines = skelLines
    }
end

local function HideAllElements(cache)
    if not cache then return end
    cache.FullBox.Visible = false
    for i = 1, 8 do
        cache.CornerShadows[i].Visible = false
        cache.CornerLines[i].Visible = false
    end
    cache.HpBg.Visible = false
    cache.NameLabel.Visible = false
    cache.InfoBadge.Visible = false
    cache.HeadDot.Visible = false
    cache.Tracer.Visible = false
    cache.OffscreenDot.Visible = false
    for _, ln in ipairs(cache.SkelLines) do
        ln.Visible = false
    end
end

local function DrawLine2D(lineFrame, p1, p2, color, thickness, transparency)
    local dx = p2.X - p1.X
    local dy = p2.Y - p1.Y
    local len = math.sqrt(dx * dx + dy * dy)
    if len < 1 then
        lineFrame.Visible = false
        return
    end
    lineFrame.Position = UDim2.new(0, (p1.X + p2.X) * 0.5, 0, (p1.Y + p2.Y) * 0.5)
    lineFrame.Size = UDim2.new(0, len, 0, thickness or 1.5)
    lineFrame.Rotation = math.deg(math.atan2(dy, dx))
    lineFrame.BackgroundColor3 = color
    if transparency then
        lineFrame.BackgroundTransparency = transparency
    end
    lineFrame.Visible = true
end

-- // Отрисовка 8 угловых тактических скобок
local function DrawCornerBox(cache, x, y, w, h, color)
    local cornerLen = math.clamp(math.min(w, h) * 0.26, 5, 22)
    local thick = 2

    local coords = {
        -- Верхний левый
        { x, y, cornerLen, thick },
        { x, y, thick, cornerLen },
        -- Верхний правый
        { x + w - cornerLen, y, cornerLen, thick },
        { x + w - thick, y, thick, cornerLen },
        -- Нижний левый
        { x, y + h - thick, cornerLen, thick },
        { x, y + h - cornerLen, thick, cornerLen },
        -- Нижний правый
        { x + w - cornerLen, y + h - thick, cornerLen, thick },
        { x + w - thick, y + h - cornerLen, thick, cornerLen },
    }

    for i = 1, 8 do
        local c = coords[i]
        local sh = cache.CornerShadows[i]
        local ln = cache.CornerLines[i]

        sh.Position = UDim2.new(0, c[1] - 1, 0, c[2] - 1)
        sh.Size = UDim2.new(0, c[3] + 2, 0, c[4] + 2)
        sh.Visible = true

        ln.Position = UDim2.new(0, c[1], 0, c[2])
        ln.Size = UDim2.new(0, c[3], 0, c[4])
        ln.BackgroundColor3 = color
        ln.Visible = true
    end
end

local lastEspTick = 0
function VisualOverlay.Update()
    if State.Unloaded or not Camera then return end
    if tick() - lastEspTick < 0.025 then return end
    lastEspTick = tick()

    local isRage = State.Rage.EspEnabled
    local isLegit = State.Legit.EspEnabled and not isRage
    local vpSize = Camera.ViewportSize
    local screenCenter = Vector2.new(vpSize.X * 0.5, vpSize.Y * 0.5)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if not EspCache[player] then
                VisualOverlay.CreatePlayerEsp(player)
            end

            local cache = EspCache[player]
            local char = player.Character

            if (not isRage and not isLegit) or not Utils.IsAlive(char) then
                HideAllElements(cache)
                if HighlightCache[player] then HighlightCache[player].Enabled = false end
                if ParticleCache[player] then ParticleCache[player].Enabled = false end
            else
                local head = Utils.GetBodyPart(char, "Head")
                local hrp = Utils.GetBodyPart(char, "HumanoidRootPart")
                local hum = char:FindFirstChild("Humanoid")

                if head and hrp and hum then
                    local distStuds = (hrp.Position - Camera.CFrame.Position).Magnitude
                    local maxDist = isRage and State.Rage.EspMaxDist or State.Legit.EspMaxDist
                    local isVis = Utils.IsVisible(head, char)
                    local allowedByVis = isRage or (not State.Legit.EspVisibleOnly) or isVis

                    if distStuds > maxDist or not allowedByVis then
                        HideAllElements(cache)
                        if HighlightCache[player] then HighlightCache[player].Enabled = false end
                        if ParticleCache[player] then ParticleCache[player].Enabled = false end
                    else
                        local accent = isRage and Utils.Colors.RageAccent or Utils.Colors.LegitAccent
                        local distMeters = math.floor(distStuds / 3.57)
                        local hpRatio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)

                        -- Плавное дотягивание призрачной полоски урона
                        if cache.GhostRatio > hpRatio then
                            cache.GhostRatio = math.max(hpRatio, cache.GhostRatio - 0.03)
                        else
                            cache.GhostRatio = hpRatio
                        end

                        local topPos, topOn = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.15, 0))
                        local botPos, botOn = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 2.95, 0))
                        local headScreen, headOn = Camera:WorldToViewportPoint(head.Position)

                        local onScreen = topOn and botOn and topPos.Z > 0

                        -- Индикатор цели за пределами экрана (Offscreen Radar Arrow)
                        local showOff = (isRage and State.Rage.ShowOffscreen) or (isLegit and State.Legit.ShowOffscreen)
                        if not onScreen then
                            HideAllElements(cache)
                            if showOff then
                                local rel = Camera.CFrame:PointToObjectSpace(hrp.Position)
                                local angle = math.atan2(-rel.Y, rel.X)
                                local radius = math.min(vpSize.X, vpSize.Y) * 0.36
                                local arrowPos = screenCenter + Vector2.new(math.cos(angle) * radius, math.sin(angle) * radius)
                                cache.OffscreenDot.Position = UDim2.new(0, arrowPos.X, 0, arrowPos.Y)
                                cache.OffscreenDot.Rotation = math.deg(angle) + 45
                                cache.OffscreenDot.BackgroundColor3 = accent
                                cache.OffscreenDot.Visible = true
                            end
                        else
                            cache.OffscreenDot.Visible = false

                            local boxH = math.max(math.abs(botPos.Y - topPos.Y), 14)
                            local boxW = boxH * 0.56
                            local boxX = topPos.X - boxW * 0.5
                            local boxY = topPos.Y

                            -- 1. Стиль бокса (Corners / Full / Off)
                            local boxStyle = isRage and State.Rage.BoxStyle or State.Legit.BoxStyle
                            if boxStyle == "Corners" then
                                cache.FullBox.Visible = false
                                DrawCornerBox(cache, boxX, boxY, boxW, boxH, accent)
                            elseif boxStyle == "Full" then
                                for i = 1, 8 do
                                    cache.CornerShadows[i].Visible = false
                                    cache.CornerLines[i].Visible = false
                                end
                                cache.FullBox.Position = UDim2.new(0, boxX, 0, boxY)
                                cache.FullBox.Size = UDim2.new(0, boxW, 0, boxH)
                                cache.FullBox.BackgroundColor3 = accent
                                cache.FullStroke.Color = accent
                                cache.FullBox.Visible = true
                            else
                                cache.FullBox.Visible = false
                                for i = 1, 8 do
                                    cache.CornerShadows[i].Visible = false
                                    cache.CornerLines[i].Visible = false
                                end
                            end

                            -- 2. Вертикальная полоска HP с градиентом и следом урона
                            local showHp = (isRage and State.Rage.ShowHpBar) or (isLegit and State.Legit.ShowHpBar)
                            if showHp then
                                local barW = isRage and 4 or 3
                                cache.HpBg.Position = UDim2.new(0, boxX - (barW + 4), 0, boxY)
                                cache.HpBg.Size = UDim2.new(0, barW, 0, boxH)
                                cache.HpGhost.Size = UDim2.new(1, 0, cache.GhostRatio, 0)
                                cache.HpFill.Size = UDim2.new(1, 0, hpRatio, 0)

                                if isRage and hpRatio < 0.35 then
                                    local pulse = 0.5 + 0.5 * math.sin(tick() * 14)
                                    cache.HpFill.BackgroundColor3 = Color3.fromRGB(255, math.floor(70 * pulse), math.floor(70 * pulse))
                                else
                                    cache.HpFill.BackgroundColor3 = Utils.GetHealthColor(hpRatio)
                                end
                                cache.HpBg.Visible = true
                            else
                                cache.HpBg.Visible = false
                            end

                            -- 3. Имя игрока сверху бокса
                            local showName = isRage or State.Legit.ShowName
                            if showName then
                                cache.NameLabel.Position = UDim2.new(0, boxX + boxW * 0.5, 0, boxY - 3)
                                cache.NameLabel.Text = player.Name
                                cache.NameLabel.TextColor3 = isRage and Utils.Colors.Text or Utils.Colors.White
                                cache.NameLabel.Visible = true
                            else
                                cache.NameLabel.Visible = false
                            end

                            -- 4. Нижняя сводка (Дистанция + HP / Статус видимости)
                            if isRage then
                                cache.InfoBadge.Visible = State.Rage.ShowInfoText
                                cache.InfoBadge.Position = UDim2.new(0, boxX + boxW * 0.5, 0, boxY + boxH + 3)
                                cache.InfoBadge.Text = string.format("%dm • %d HP", distMeters, math.floor(hum.Health))
                                cache.InfoBadge.TextColor3 = Utils.Colors.RageAccent
                            else
                                if State.Legit.ShowDistance then
                                    cache.InfoBadge.Position = UDim2.new(0, boxX + boxW * 0.5, 0, boxY + boxH + 3)
                                    local tag = isVis and "VIS" or "OCC"
                                    cache.InfoBadge.Text = string.format("%dm [%s]", distMeters, tag)
                                    cache.InfoBadge.TextColor3 = isVis and Utils.Colors.LegitAccent or Utils.Colors.SubText
                                    cache.InfoBadge.Visible = true
                                else
                                    cache.InfoBadge.Visible = false
                                end
                            end

                            -- 5. Прицельный маркер на голове (Head Dot)
                            local showDot = (isRage and State.Rage.ShowHeadDot) or (isLegit and State.Legit.ShowHeadDot)
                            if showDot and headOn then
                                cache.HeadDot.Position = UDim2.new(0, headScreen.X, 0, headScreen.Y)
                                cache.HeadDot.BackgroundColor3 = isVis and Utils.Colors.White or Utils.Colors.SubText
                                cache.HeadDotStroke.Color = accent
                                cache.HeadDot.Visible = true
                            else
                                cache.HeadDot.Visible = false
                            end

                            -- 6. Трассер от низа экрана (Snapline)
                            local showTracer = (isRage and State.Rage.ShowTracers) or (isLegit and State.Legit.ShowTracers)
                            if showTracer then
                                local origin2D = Vector2.new(vpSize.X * 0.5, vpSize.Y - 12)
                                local target2D = Vector2.new(boxX + boxW * 0.5, boxY + boxH)
                                local alphaTrans = math.clamp(0.2 + (distStuds / maxDist) * 0.55, 0.2, 0.75)
                                DrawLine2D(cache.Tracer, origin2D, target2D, accent, 1.2, alphaTrans)
                            else
                                cache.Tracer.Visible = false
                            end

                            -- 7. Скелет (R6 / R15)
                            local showSkel = (isRage and State.Rage.ShowSkeleton) or (isLegit and State.Legit.ShowSkeleton)
                            if showSkel then
                                local isR15 = char:FindFirstChild("UpperTorso") ~= nil
                                local map = isR15 and SkeletonConnectionsR15 or SkeletonConnectionsR6
                                for idx, pair in ipairs(map) do
                                    local line = cache.SkelLines[idx]
                                    local pA = char:FindFirstChild(pair[1])
                                    local pB = char:FindFirstChild(pair[2])
                                    if line and pA and pB and pA:IsA("BasePart") and pB:IsA("BasePart") then
                                        local vA, onA = Camera:WorldToViewportPoint(pA.Position)
                                        local vB, onB = Camera:WorldToViewportPoint(pB.Position)
                                        if onA and onB and vA.Z > 0 and vB.Z > 0 then
                                            DrawLine2D(line, vA, vB, accent, 1.4, 0.15)
                                        else
                                            line.Visible = false
                                        end
                                    elseif line then
                                        line.Visible = false
                                    end
                                end
                            else
                                for _, ln in ipairs(cache.SkelLines) do ln.Visible = false end
                            end
                        end

                        -- 8. Highlight с плавным дыханием (Rage)
                        if isRage and State.Rage.ShowHighlight then
                            local hl = HighlightCache[player]
                            if not hl or hl.Parent ~= char then
                                if hl then hl:Destroy() end
                                hl = Instance.new("Highlight")
                                hl.Name = "BRM5_Highlight"
                                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                                hl.FillColor = Utils.Colors.RageAccent
                                hl.OutlineColor = Utils.Colors.White
                                hl.OutlineTransparency = 0.15
                                hl.Parent = char
                                HighlightCache[player] = hl
                            end
                            hl.FillTransparency = 0.68 + 0.12 * math.sin(tick() * 4)
                            hl.Enabled = true
                        elseif HighlightCache[player] then
                            HighlightCache[player].Enabled = false
                        end

                        -- 9. Партиклы над головой (Rage)
                        if isRage and State.Rage.ShowParticles then
                            local pe = ParticleCache[player]
                            if not pe or pe.Parent ~= head then
                                if pe then pe:Destroy() end
                                pe = Instance.new("ParticleEmitter")
                                pe.Name = "BRM5_HeadParticle"
                                pe.Rate = 5
                                pe.Lifetime = NumberRange.new(0.8, 1.2)
                                pe.Speed = NumberRange.new(1, 2)
                                pe.Size = NumberSequence.new(0.35, 0)
                                pe.Color = ColorSequence.new(Utils.Colors.RageAccent)
                                pe.Parent = head
                                ParticleCache[player] = pe
                            end
                            pe.Enabled = true
                        elseif ParticleCache[player] then
                            ParticleCache[player].Enabled = false
                        end
                    end
                end
            end
        end
    end
end

-- // 6. МОДУЛЬ WEAPON MODIFIER (NO RECOIL, NO SHAKE, AUTO FIRE)
local WeaponModifier = {}
local lastCamPitch = 0
local lastShotTime = 0

function WeaponModifier.Step()
    if State.Unloaded or not Camera then return end

    local isRage = State.Rage.NoRecoil or State.Rage.NoShake or State.Rage.AutoFire
    local isLegit = State.Legit.NoRecoil or State.Legit.NoShake

    if not isRage and not isLegit then
        local _, rx, _ = Camera.CFrame:ToOrientation()
        lastCamPitch = rx
        return
    end

    local cf = Camera.CFrame
    local rx, ry, rz = cf:ToOrientation()

    local isFiring = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
    if isFiring then
        local deltaPitch = rx - lastCamPitch
        if deltaPitch > 0.004 and deltaPitch < 0.25 then
            local factor = State.Rage.NoRecoil and 1.0 or (State.Legit.NoRecoil and State.Legit.RecoilStrength or 0)
            if factor > 0 then
                local correctedPitch = rx - (deltaPitch * factor)
                Camera.CFrame = CFrame.new(cf.Position) * CFrame.fromOrientation(correctedPitch, ry, rz)
                rx = correctedPitch
            end
        end
    end

    if State.Rage.NoShake or State.Legit.NoShake then
        if math.abs(rz) > 0.0005 then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position) * CFrame.fromOrientation(rx, ry, 0)
        end
    end

    lastCamPitch = rx

    if State.Rage.AutoFire and State.Rage.AimEnabled then
        local target = TargetAssist.GetBestTarget()
        if target and (tick() - lastShotTime > 0.12) then
            lastShotTime = tick()
            pcall(function()
                if mouse1press and mouse1release then
                    mouse1press()
                    task.delay(0.03, mouse1release)
                end
            end)
        end
    end
end

-- // 7. ПОСТРОЕНИЕ УЛУЧШЕННОГО UI
local ScreenGui
local MainWindow
local MainStroke
local HeaderAccentLine
local MiniIcon
local ScreenLockBtn
local TopLockBtn
local HudHolder
local Pages = {}

local function CountActiveFeatures(tbl)
    local active = 0
    for _, v in pairs(tbl) do
        if v == true then
            active += 1
        end
    end
    return active
end

local function SwitchPage(pageName)
    State.ActiveMode = pageName
    for name, frame in pairs(Pages) do
        frame.Visible = (name == pageName)
    end

    -- Динамическая подсветка рамки окна под выбранный режим
    local targetAccent = Utils.Colors.Border
    if pageName == "Legit" then
        targetAccent = Utils.Colors.LegitAccent
    elseif pageName == "Rage" then
        targetAccent = Utils.Colors.RageAccent
    end

    if MainStroke then
        TweenService:Create(MainStroke, TweenInfo.new(0.25), { Color = targetAccent }):Play()
    end
    if HeaderAccentLine then
        local lineColor = (pageName == "Main") and Utils.Colors.LegitAccent or targetAccent
        TweenService:Create(HeaderAccentLine, TweenInfo.new(0.25), { BackgroundColor3 = lineColor }):Play()
    end
    if UpdateCardBadgesCallback then
        UpdateCardBadgesCallback()
    end
end

-- // Обновление визуального состояния заморозки позиций (UI Lock)
local function UpdateLockVisuals()
    local locked = State.UiLocked
    local targetColor = locked and Utils.Colors.LockAccent or Utils.Colors.SubText
    local borderColor = locked and Utils.Colors.LockAccent or Utils.Colors.Border

    if ScreenLockBtn then
        ScreenLockBtn.Text = locked and "🔒 LOCKED" or "🔓 FREE"
        TweenService:Create(ScreenLockBtn, TweenInfo.new(0.2), {
            TextColor3 = targetColor,
            BackgroundColor3 = locked and Color3.fromRGB(32, 26, 14) or Utils.Colors.Bg
        }):Play()
        local st = ScreenLockBtn:FindFirstChildOfClass("UIStroke")
        if st then
            TweenService:Create(st, TweenInfo.new(0.2), { Color = borderColor }):Play()
        end
    end

    if TopLockBtn then
        TopLockBtn.Text = locked and "🔒" or "🔓"
        TweenService:Create(TopLockBtn, TweenInfo.new(0.2), {
            TextColor3 = targetColor
        }):Play()
    end

    for _, hudData in pairs(PinnedHudButtons) do
        if hudData.Stroke then
            local active = hudData.IsActive()
            local c = active and hudData.Accent or (locked and Utils.Colors.LockAccent or Utils.Colors.Border)
            TweenService:Create(hudData.Stroke, TweenInfo.new(0.2), { Color = c }):Play()
        end
    end
end

local function ToggleUiLock()
    State.UiLocked = not State.UiLocked
    UpdateLockVisuals()
    if State.UiLocked then
        Utils.Notify("UI Заморожен", "Меню и все плашки зафиксированы", Utils.Colors.LockAccent)
    else
        Utils.Notify("UI Разблокирован", "Можно перетаскивать меню и плашки", Utils.Colors.LegitAccent)
    end
end

-- // Вынос функции на экран в виде интерактивной плашки (HUD Pin)
local function TogglePinnedHudButton(pinId, shortTitle, tbl, key, accentColor, onChangeCallback)
    if PinnedHudButtons[pinId] then
        local existing = PinnedHudButtons[pinId]
        PinnedHudButtons[pinId] = nil
        if existing.Button and existing.Button.Parent then
            local closeTw = TweenService:Create(
                existing.Button,
                TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.In),
                { Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1 }
            )
            closeTw:Play()
            closeTw.Completed:Connect(function()
                if existing.Button then existing.Button:Destroy() end
            end)
        end
        return false
    end

    if not HudHolder then return false end

    local count = 0
    for _ in pairs(PinnedHudButtons) do count += 1 end

    local btn = Utils.Create("TextButton", {
        Name = "HUD_" .. pinId,
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(0, 20 + (count % 3) * 130, 0, 82 + math.floor(count / 3) * 44),
        BackgroundColor3 = Utils.Colors.Panel,
        BackgroundTransparency = 0.06,
        Text = "",
        AutoButtonColor = false,
        ClipsDescendants = true
    }, HudHolder)
    Utils.AddCorner(btn, 8)
    local stroke = Utils.AddStroke(btn, tbl[key] and accentColor or Utils.Colors.Border, 1.5)

    local indicator = Utils.Create("Frame", {
        Size = UDim2.new(0, 5, 0, 20),
        Position = UDim2.new(0, 7, 0.5, -10),
        BackgroundColor3 = tbl[key] and accentColor or Color3.fromRGB(58, 62, 76),
        BorderSizePixel = 0
    }, btn)
    Utils.AddCorner(indicator, 3)

    local lbl = Utils.Create("TextLabel", {
        Size = UDim2.new(1, -22, 1, 0),
        Position = UDim2.new(0, 17, 0, 0),
        BackgroundTransparency = 1,
        Text = shortTitle,
        TextColor3 = tbl[key] and Utils.Colors.Text or Utils.Colors.SubText,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd
    }, btn)

    Utils.MakeDraggable(btn, btn)

    local function RefreshHudBtn()
        local active = tbl[key]
        local strokeColor = active and accentColor or (State.UiLocked and Utils.Colors.LockAccent or Utils.Colors.Border)
        TweenService:Create(stroke, TweenInfo.new(0.18), { Color = strokeColor }):Play()
        TweenService:Create(indicator, TweenInfo.new(0.18), {
            BackgroundColor3 = active and accentColor or Color3.fromRGB(58, 62, 76)
        }):Play()
        TweenService:Create(lbl, TweenInfo.new(0.18), {
            TextColor3 = active and Utils.Colors.Text or Utils.Colors.SubText
        }):Play()
        if UpdateCardBadgesCallback then UpdateCardBadgesCallback() end
    end

    btn.MouseButton1Click:Connect(function()
        tbl[key] = not tbl[key]
        if ToggleSyncCallbacks[pinId] then
            ToggleSyncCallbacks[pinId]()
        end
        RefreshHudBtn()
        if onChangeCallback then onChangeCallback(tbl[key]) end
    end)

    PinnedHudButtons[pinId] = {
        Button = btn,
        Stroke = stroke,
        Accent = accentColor,
        Refresh = RefreshHudBtn,
        IsActive = function() return tbl[key] end
    }

    TweenService:Create(
        btn,
        TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        { Size = UDim2.new(0, 124, 0, 36) }
    ):Play()

    return true
end

-- // Секция-заголовок с декоративной линией
local function AddSectionHeader(parent, text, accentColor)
    local holder = Utils.Create("Frame", {
        Size = UDim2.new(1, 0, 0, 24),
        BackgroundTransparency = 1
    }, parent)

    Utils.Create("Frame", {
        Size = UDim2.new(0, 3, 0, 13),
        Position = UDim2.new(0, 2, 0.5, -6),
        BackgroundColor3 = accentColor,
        BorderSizePixel = 0
    }, holder)

    Utils.Create("TextLabel", {
        Size = UDim2.new(1, -12, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1,
        Text = string.upper(text),
        TextColor3 = accentColor,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left
    }, holder)

    return holder
end

-- // Переключатель (Toggle) с кнопкой выноса на экран (HUD)
local function AddToggle(parent, pinId, labelText, shortHudTitle, tbl, key, accentColor, callback)
    local row = Utils.Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = Utils.Colors.Element,
        Text = "",
        AutoButtonColor = false
    }, parent)
    Utils.AddCorner(row, 7)
    local rowStroke = Utils.AddStroke(row, Utils.Colors.Border, 1)

    Utils.Create("TextLabel", {
        Size = UDim2.new(1, -106, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Text = labelText,
        TextColor3 = Utils.Colors.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd
    }, row)

    local pinBtn = Utils.Create("TextButton", {
        Size = UDim2.new(0, 36, 0, 20),
        Position = UDim2.new(1, -92, 0.5, -10),
        BackgroundColor3 = Utils.Colors.Panel,
        Text = "HUD",
        TextColor3 = Utils.Colors.SubText,
        Font = Enum.Font.GothamBold,
        TextSize = 10
    }, row)
    Utils.AddCorner(pinBtn, 4)
    local pinStroke = Utils.AddStroke(pinBtn, Utils.Colors.Border, 1)

    local switchBg = Utils.Create("Frame", {
        Size = UDim2.new(0, 40, 0, 20),
        Position = UDim2.new(1, -48, 0.5, -10),
        BackgroundColor3 = tbl[key] and accentColor or Color3.fromRGB(42, 45, 58)
    }, row)
    Utils.AddCorner(switchBg, 10)

    local knob = Utils.Create("Frame", {
        Size = UDim2.new(0, 14, 0, 14),
        Position = tbl[key] and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
        BackgroundColor3 = Utils.Colors.White
    }, switchBg)
    Utils.AddCorner(knob, 7)

    local function RefreshSwitch()
        local active = tbl[key]
        TweenService:Create(switchBg, TweenInfo.new(0.18), {
            BackgroundColor3 = active and accentColor or Color3.fromRGB(42, 45, 58)
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.18), {
            Position = active and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
        }):Play()
        TweenService:Create(rowStroke, TweenInfo.new(0.18), {
            Color = active and accentColor or Utils.Colors.Border,
            Transparency = active and 0.45 or 0
        }):Play()
        if PinnedHudButtons[pinId] then
            PinnedHudButtons[pinId].Refresh()
        end
        if UpdateCardBadgesCallback then UpdateCardBadgesCallback() end
    end

    ToggleSyncCallbacks[pinId] = RefreshSwitch
    if tbl[key] then
        rowStroke.Color = accentColor
        rowStroke.Transparency = 0.45
    end

    row.MouseButton1Click:Connect(function()
        tbl[key] = not tbl[key]
        RefreshSwitch()
        if callback then callback(tbl[key]) end
    end)

    pinBtn.MouseButton1Click:Connect(function()
        local isPinned = TogglePinnedHudButton(pinId, shortHudTitle, tbl, key, accentColor, callback)
        TweenService:Create(pinBtn, TweenInfo.new(0.18), {
            TextColor3 = isPinned and accentColor or Utils.Colors.SubText,
            BackgroundColor3 = isPinned and Utils.Colors.ElementHover or Utils.Colors.Panel
        }):Play()
        TweenService:Create(pinStroke, TweenInfo.new(0.18), {
            Color = isPinned and accentColor or Utils.Colors.Border
        }):Play()
    end)

    return row
end

-- // Интерактивный сенсорный слайдер (плавная регулировка мышью и пальцем)
local function AddSlider(parent, labelText, tbl, key, minVal, maxVal, step, suffix, accentColor, callback)
    local card = Utils.Create("Frame", {
        Size = UDim2.new(1, 0, 0, 48),
        BackgroundColor3 = Utils.Colors.Element
    }, parent)
    Utils.AddCorner(card, 7)
    Utils.AddStroke(card, Utils.Colors.Border, 1)

    Utils.Create("TextLabel", {
        Size = UDim2.new(0.65, 0, 0, 22),
        Position = UDim2.new(0, 12, 0, 4),
        BackgroundTransparency = 1,
        Text = labelText,
        TextColor3 = Utils.Colors.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left
    }, card)

    local function FormatVal(v)
        if step < 1 then
            return string.format("%.2f%s", v, suffix or "")
        end
        return string.format("%d%s", math.floor(v + 0.5), suffix or "")
    end

    local valLabel = Utils.Create("TextLabel", {
        Size = UDim2.new(0.35, -12, 0, 22),
        Position = UDim2.new(0.65, 0, 0, 4),
        BackgroundTransparency = 1,
        Text = FormatVal(tbl[key]),
        TextColor3 = accentColor,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right
    }, card)

    local track = Utils.Create("TextButton", {
        Size = UDim2.new(1, -24, 0, 8),
        Position = UDim2.new(0, 12, 0, 31),
        BackgroundColor3 = Utils.Colors.Panel,
        Text = "",
        AutoButtonColor = false
    }, card)
    Utils.AddCorner(track, 4)

    local initRatio = math.clamp((tbl[key] - minVal) / (maxVal - minVal), 0, 1)
    local fill = Utils.Create("Frame", {
        Size = UDim2.new(initRatio, 0, 1, 0),
        BackgroundColor3 = accentColor,
        BorderSizePixel = 0
    }, track)
    Utils.AddCorner(fill, 4)

    local thumb = Utils.Create("Frame", {
        Size = UDim2.new(0, 14, 0, 14),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(initRatio, 0, 0.5, 0),
        BackgroundColor3 = Utils.Colors.White
    }, track)
    Utils.AddCorner(thumb, 7)

    local draggingSlider = false
    local function UpdateFromInput(inputX)
        local absPos = track.AbsolutePosition.X
        local absSize = math.max(track.AbsoluteSize.X, 1)
        local ratio = math.clamp((inputX - absPos) / absSize, 0, 1)
        local raw = minVal + (maxVal - minVal) * ratio
        local snapped = math.floor((raw / step) + 0.5) * step
        snapped = math.clamp(snapped, minVal, maxVal)
        if step < 1 then
            snapped = math.floor(snapped * 100 + 0.5) / 100
        end

        tbl[key] = snapped
        local finalRatio = (snapped - minVal) / (maxVal - minVal)
        fill.Size = UDim2.new(finalRatio, 0, 1, 0)
        thumb.Position = UDim2.new(finalRatio, 0, 0.5, 0)
        valLabel.Text = FormatVal(snapped)
        if callback then callback(snapped) end
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = true
            UpdateFromInput(input.Position.X)
        end
    end)

    local cMove = UserInputService.InputChanged:Connect(function(input)
        if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            UpdateFromInput(input.Position.X)
        end
    end)

    local cEnd = UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = false
        end
    end)

    table.insert(Connections, cMove)
    table.insert(Connections, cEnd)

    return card
end

-- // Селектор вариантов (CycleButton)
local function AddCycleButton(parent, labelText, tbl, key, options, formatter, accentColor, callback)
    local row = Utils.Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = Utils.Colors.Element,
        Text = "",
        AutoButtonColor = false
    }, parent)
    Utils.AddCorner(row, 7)
    Utils.AddStroke(row, Utils.Colors.Border, 1)

    Utils.Create("TextLabel", {
        Size = UDim2.new(0.58, 0, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Text = labelText,
        TextColor3 = Utils.Colors.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left
    }, row)

    local valBadge = Utils.Create("TextLabel", {
        Size = UDim2.new(0.37, -12, 0, 22),
        Position = UDim2.new(0.63, 0, 0.5, -11),
        BackgroundColor3 = Utils.Colors.Panel,
        Text = formatter and formatter(tbl[key]) or tostring(tbl[key]),
        TextColor3 = accentColor,
        Font = Enum.Font.GothamBold,
        TextSize = 11
    }, row)
    Utils.AddCorner(valBadge, 5)
    Utils.AddStroke(valBadge, accentColor, 1, 0.65)

    local currentIdx = 1
    for i, opt in ipairs(options) do
        if opt == tbl[key] then
            currentIdx = i
            break
        end
    end

    row.MouseButton1Click:Connect(function()
        currentIdx = (currentIdx % #options) + 1
        tbl[key] = options[currentIdx]
        valBadge.Text = formatter and formatter(tbl[key]) or tostring(tbl[key])
        if callback then callback(tbl[key]) end
    end)

    return row
end

-- // ПЛАВНАЯ АНИМИРОВАННАЯ ДЕАКТИВАЦИЯ СКРИПТА
local function DeactivateScript()
    if State.Unloaded then return end
    State.Unloaded = true

    for _, bindName in ipairs(RenderBindings) do
        pcall(function()
            RunService:UnbindFromRenderStep(bindName)
        end)
    end

    for _, conn in ipairs(Connections) do
        pcall(function()
            conn:Disconnect()
        end)
    end

    HitboxModifier.RestoreAll()

    for _, player in ipairs(Players:GetPlayers()) do
        VisualOverlay.RemovePlayerEsp(player)
    end

    if FovCircleFrame then
        FovCircleFrame.Visible = false
    end

    local animDuration = 0.35
    local shrinkInfo = TweenInfo.new(animDuration, Enum.EasingStyle.Back, Enum.EasingDirection.In)
    local fadeInfo = TweenInfo.new(animDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    if MainWindow and MainWindow.Visible then
        TweenService:Create(MainWindow, shrinkInfo, {
            Size = UDim2.new(0, 0, 0, 0),
            BackgroundTransparency = 1
        }):Play()
    end

    if MiniIcon and MiniIcon.Visible then
        TweenService:Create(MiniIcon, shrinkInfo, {
            Size = UDim2.new(0, 0, 0, 0),
            BackgroundTransparency = 1,
            TextTransparency = 1
        }):Play()
    end

    if ScreenLockBtn then
        TweenService:Create(ScreenLockBtn, fadeInfo, {
            BackgroundTransparency = 1,
            TextTransparency = 1
        }):Play()
    end

    for _, hudData in pairs(PinnedHudButtons) do
        if hudData.Button and hudData.Button.Parent then
            TweenService:Create(hudData.Button, shrinkInfo, {
                Size = UDim2.new(0, 0, 0, 0),
                BackgroundTransparency = 1
            }):Play()
        end
    end

    task.delay(animDuration + 0.05, function()
        if ScreenGui and ScreenGui.Parent then
            ScreenGui:Destroy()
        end
    end)
end

-- // Сворачивание и разворачивание главного окна
local function SetMenuMinimized(minimize)
    if State.Unloaded then return end
    State.Minimized = minimize

    if minimize then
        local tw = TweenService:Create(
            MainWindow,
            TweenInfo.new(0.24, Enum.EasingStyle.Back, Enum.EasingDirection.In),
            { Size = UDim2.new(0, 0, 0, 0) }
        )
        tw:Play()
        tw.Completed:Connect(function()
            if State.Minimized and not State.Unloaded then
                MainWindow.Visible = false
                MiniIcon.Size = UDim2.new(0, 0, 0, 0)
                MiniIcon.Visible = true
                TweenService:Create(
                    MiniIcon,
                    TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                    { Size = UDim2.new(0, 52, 0, 52) }
                ):Play()
            end
        end)
    else
        local tw = TweenService:Create(
            MiniIcon,
            TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
            { Size = UDim2.new(0, 0, 0, 0) }
        )
        tw:Play()
        tw.Completed:Connect(function()
            if not State.Minimized and not State.Unloaded then
                MiniIcon.Visible = false
                MainWindow.Size = UDim2.new(0, 0, 0, 0)
                MainWindow.Visible = true
                TweenService:Create(
                    MainWindow,
                    TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                    { Size = UDim2.new(0, 380, 0, 470) }
                ):Play()
            end
        end)
    end
end

