-- 2. UTILS & HEALTH HELPER
local Utils = {}
function Utils.Track(c)
    if c then table.insert(State.Connections, c) end
    return c
end
function Utils.Notify(t, x)
    pcall(function() StarterGui:SetCore("SendNotification", { Title = t, Text = x, Duration = 3 }) end)
end
function Utils.GuiParent()
    local ok, p = pcall(function()
        if type(gethui) == "function" then return gethui() end
        return CoreGui
    end)
    if ok and p then return p end
    return LocalPlayer and LocalPlayer:WaitForChild("PlayerGui", 5) or CoreGui
end
function Utils.Style(i, r, sc, sw)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8)
    c.Parent = i
    if sc then
        local s = Instance.new("UIStroke")
        s.Color = sc
        s.Thickness = sw or 1
        s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        s.Parent = i
    end
end
function Utils.Drag(tr, tf, cb)
    local d, di, ds, sp, md = false, nil, nil, nil, 0
    Utils.Track(tr.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            d = true; ds = inp.Position; sp = tf.Position; md = 0
            local rc
            rc = inp.Changed:Connect(function()
                if inp.UserInputState == Enum.UserInputState.End then
                    d = false
                    if rc then rc:Disconnect() end
                    if md < 12 and cb then cb() end
                end
            end)
        end
    end))
    Utils.Track(tr.InputChanged:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then di = inp end
    end))
    Utils.Track(UserInputService.InputChanged:Connect(function(inp)
        if inp == di and d and ds and sp then
            local dl = inp.Position - ds; md = dl.Magnitude
            tf.Position = UDim2.new(sp.X.Scale, sp.X.Offset + dl.X, sp.Y.Scale, sp.Y.Offset + dl.Y)
        end
    end))
end
function Utils.DeepClone(tbl, seen)
    if type(tbl) ~= "table" then return tbl end
    seen = seen or {}
    if seen[tbl] then return seen[tbl] end
    local copy = {}; seen[tbl] = copy
    for k, v in pairs(tbl) do copy[Utils.DeepClone(k, seen)] = Utils.DeepClone(v, seen) end
    return copy
end

local function ExtractNumber(v)
    if type(v) == "number" then return v end
    if type(v) == "string" then return tonumber(v) or tonumber(string.match(v, "[-]?%d+%.?%d*")) end
    return nil
end

local function GetBotHealth(model)
    if not model or not model.Parent then return 0, 100, true end
    local hp, maxHp = nil, nil
    local isDeadFlag = false
    local hum = model:FindFirstChildOfClass("Humanoid")
    if hum then
        hp = hum.Health; maxHp = hum.MaxHealth
        if hum:GetState() == Enum.HumanoidStateType.Dead then isDeadFlag = true end
    end
    local function CheckKV(rawName, rawVal)
        local n = string.lower(tostring(rawName))
        if (n == "dead" or n == "isdead" or n == "corpse" or n == "iscorpse") and rawVal == true then
            isDeadFlag = true; return
        end
        local num = ExtractNumber(rawVal)
        if not num then return end
        if n == "health" or n == "hp" or n == "currenthealth" then hp = num
        elseif n == "maxhealth" or n == "maxhp" then if num > 0 then maxHp = num end end
    end
    for _, inst in ipairs({ model, hum }) do
        if inst then
            local ok, attrs = pcall(function() return inst:GetAttributes() end)
            if ok and type(attrs) == "table" then
                for k, v in pairs(attrs) do CheckKV(k, v) end
            end
        end
    end
    for _, obj in ipairs(model:GetChildren()) do
        if obj:IsA("ValueBase") then pcall(function() CheckKV(obj.Name, obj.Value) end) end
    end
    local finalHp = (hp ~= nil) and hp or 100
    local finalMaxHp = (maxHp and maxHp > 0) and maxHp or math.max(finalHp, 100)
    local isDead = isDeadFlag or (hp ~= nil and hp <= 0)
    return finalHp, finalMaxHp, isDead
end

-- 3. VISUALS & UNLOCK CAMERA
local Visuals = {}
local wasNightVision, wasUnlockCam = false, false
local SleepBlackouts = {}
local MainFrameRef = nil

local function CheckIfSleepOverlay(g)
    if not g or not g.Parent then return end
    if MainFrameRef and g:IsDescendantOf(MainFrameRef) then return end
    if g:IsA("Frame") or g:IsA("ImageLabel") or g:IsA("CanvasGroup") then
        local n = string.lower(g.Name)
        local pn = g.Parent and string.lower(g.Parent.Name) or ""
        local isSleepName = string.find(n, "sleep", 1, true) or string.find(n, "rest", 1, true)
            or string.find(n, "blink", 1, true) or string.find(n, "black", 1, true)
            or string.find(n, "fade", 1, true) or string.find(n, "vignette", 1, true)
            or string.find(n, "blind", 1, true) or string.find(n, "eye", 1, true)
            or string.find(pn, "sleep", 1, true) or string.find(pn, "vignette", 1, true)
        local isFullScreen = (g.Size.X.Scale >= 0.85 and g.Size.Y.Scale >= 0.85)
        if isSleepName or isFullScreen then SleepBlackouts[g] = true end
    end
end

local function ProcessPostEffects(container)
    if not container then return end
    for _, e in ipairs(container:GetChildren()) do
        if State.NoBlur and (e:IsA("BlurEffect") or e:IsA("DepthOfFieldEffect") or e:IsA("SunRaysEffect")) then
            e.Enabled = false
            if e:IsA("BlurEffect") then e.Size = 0 end
        end
        if State.NoSleepScreen and e:IsA("ColorCorrectionEffect") then
            local en = string.lower(e.Name)
            if string.find(en, "sleep", 1, true) or string.find(en, "rest", 1, true) or string.find(en, "blind", 1, true) or string.find(en, "dark", 1, true) then
                e.Enabled = false
            end
            if e.Brightness < 0 then e.Brightness = 0 end
            if e.Contrast < 0 then e.Contrast = 0 end
            if e.Saturation < -0.2 then e.Saturation = 0 end
            if e.TintColor.R < 0.85 or e.TintColor.G < 0.85 or e.TintColor.B < 0.85 then
                e.TintColor = Color3.fromRGB(255, 255, 255)
            end
        end
    end
end

function Visuals.ScanSleepGui()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return end
    pcall(function() for _, g in ipairs(pg:GetDescendants()) do CheckIfSleepOverlay(g) end end)
end

function Visuals.Init()
    Visuals.ScanSleepGui()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if pg then
        Utils.Track(pg.DescendantAdded:Connect(function(desc)
            if State.NoSleepScreen then task.defer(function() pcall(CheckIfSleepOverlay, desc) end) end
        end))
    end
    local lastVisTick = 0
    Utils.Track(RunService.RenderStepped:Connect(function()
        if not State.Active or (not State.NoBlur and not State.NoSleepScreen) then return end
        local now = os.clock()
        if (now - lastVisTick) < 0.08 then return end
        lastVisTick = now
        ProcessPostEffects(Lighting)
        if Workspace.CurrentCamera then ProcessPostEffects(Workspace.CurrentCamera) end
        if State.NoSleepScreen then
            local cam = Workspace.CurrentCamera
            local vp = cam and cam.ViewportSize or Vector2.new(800, 600)
            for g in pairs(SleepBlackouts) do
                if not g or not g.Parent then SleepBlackouts[g] = nil
                elseif g.Visible then
                    local isBig = (g.AbsoluteSize.X >= vp.X * 0.75 and g.AbsoluteSize.Y >= vp.Y * 0.75) or (g.Size.X.Scale >= 0.85 and g.Size.Y.Scale >= 0.85)
                    if isBig then
                        if g:IsA("Frame") then
                            local c = g.BackgroundColor3
                            if c.R < 0.22 and c.G < 0.22 and c.B < 0.22 and g.BackgroundTransparency < 0.98 then g.BackgroundTransparency = 1 end
                        elseif g:IsA("ImageLabel") then
                            local ic, bc = g.ImageColor3, g.BackgroundColor3
                            if ic.R < 0.25 and ic.G < 0.25 and ic.B < 0.25 and g.ImageTransparency < 0.98 then g.ImageTransparency = 1 end
                            if bc.R < 0.22 and bc.G < 0.22 and bc.B < 0.22 and g.BackgroundTransparency < 0.98 then g.BackgroundTransparency = 1 end
                        elseif g:IsA("CanvasGroup") and g.GroupTransparency < 0.98 then
                            local c = g.GroupColor3
                            if c.R < 0.25 and c.G < 0.25 and c.B < 0.25 then g.GroupTransparency = 1 end
                        end
                    end
                end
            end
        end
    end))
    task.spawn(function()
        while State.Active do
            pcall(function()
                if State.UnlockCamera then
                    wasUnlockCam = true
                    LocalPlayer.CameraMaxZoomDistance = 100000; LocalPlayer.CameraMinZoomDistance = 0.5
                    LocalPlayer.DevCameraOcclusionMode = Enum.DevCameraOcclusionMode.Invisicam
                elseif wasUnlockCam then
                    wasUnlockCam = false
                    LocalPlayer.CameraMaxZoomDistance = LO.MaxZoom; LocalPlayer.CameraMinZoomDistance = LO.MinZoom
                    LocalPlayer.DevCameraOcclusionMode = LO.Occlusion
                end
                if State.NightVision then
                    wasNightVision = true
                    Lighting.Ambient = Color3.fromRGB(230, 230, 230); Lighting.OutdoorAmbient = Color3.fromRGB(230, 230, 230)
                    Lighting.Brightness = 3; Lighting.ClockTime = 14; Lighting.FogEnd = 100000; Lighting.GlobalShadows = false; Lighting.ExposureCompensation = 0.5
                    local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
                    if atmo then atmo.Density = 0; atmo.Haze = 0 end
                elseif wasNightVision then
                    wasNightVision = false; Visuals.RestoreLighting()
                end
            end)
            task.wait(0.3)
        end
    end)
end

function Visuals.RestoreLighting()
    pcall(function()
        Lighting.Ambient = LO.Ambient; Lighting.OutdoorAmbient = LO.OutdoorAmbient
        Lighting.Brightness = LO.Brightness; Lighting.GlobalShadows = LO.GlobalShadows
        Lighting.ClockTime = LO.ClockTime; Lighting.FogEnd = LO.FogEnd; Lighting.FogStart = LO.FogStart
        Lighting.ExposureCompensation = LO.ExposureCompensation
        local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
        if atmo then atmo.Density = LO.AtmoDensity; atmo.Haze = LO.AtmoHaze end
    end)
end

function Visuals.Restore()
    Visuals.RestoreLighting()
    pcall(function()
        LocalPlayer.CameraMaxZoomDistance = LO.MaxZoom; LocalPlayer.CameraMinZoomDistance = LO.MinZoom
        LocalPlayer.DevCameraOcclusionMode = LO.Occlusion
    end)
end

-- 4. SURVIVAL & SAVE DINO
local Survival = {}
local DataRemote = nil
local function FindDataRemote()
    if DataRemote and DataRemote.Parent then return DataRemote end
    local found = ReplicatedStorage:FindFirstChild("dataRemoteEvent", true)
    if found and found:IsA("RemoteEvent") then DataRemote = found; return found end
    return nil
end
function Survival.Init()
    task.spawn(function()
        while State.Active do
            if State.AutoClean then
                pcall(function()
                    if Env.PE_CapturedCleanPacket and Env.PE_CapturedCleanPacket.Remote then
                        Env.PE_CapturedCleanPacket.Remote:FireServer(table.unpack(Utils.DeepClone(Env.PE_CapturedCleanPacket.Args)))
                    else
                        local rem = FindDataRemote()
                        if rem then
                            local packet = {
                                [1] = { [1] = CLEAN_PREFIX_BYTE, [2] = CLEAN_BRIDGE_ID, [3] = { DEFAULT_WATER_COORDS[1], DEFAULT_WATER_COORDS[2], DEFAULT_WATER_COORDS[3] } },
                                [2] = CLEAN_ACTION_BYTE,
                            }
                            rem:FireServer(packet)
                        end
                    end
                end)
            end
            task.wait(1.2)
        end
    end)
end

local SaveDino = { Pad = nil }
local function ensurePad()
    if SaveDino.Pad and SaveDino.Pad.Parent then return SaveDino.Pad end
    local p = Instance.new("Part"); p.Name = "PE_UPad"; p.Size = Vector3.new(60, 3, 60)
    p.Anchored = true; p.CanCollide = true; p.Transparency = 0.85; p.Color = Color3.fromRGB(30, 30, 35)
    p.Parent = Workspace; SaveDino.Pad = p; return p
end
local function killPad() if SaveDino.Pad then pcall(function() SaveDino.Pad:Destroy() end); SaveDino.Pad = nil end end
local function noclip(c, en)
    if not c then return end
    if en then
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then
                if State.SaveDinoCollisions[p] == nil then State.SaveDinoCollisions[p] = p.CanCollide end
                p.CanCollide = false
            end
        end
    else
        for p, o in pairs(State.SaveDinoCollisions) do if p and p.Parent then pcall(function() p.CanCollide = o end) end end
        table.clear(State.SaveDinoCollisions)
    end
end
local function zero(c)
    if not c then return end
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") then pcall(function() p.AssemblyLinearVelocity = Vector3.zero; p.AssemblyAngularVelocity = Vector3.zero end) end
    end
end
local function feetOff(c)
    local ok, _, sz = pcall(function() return c:GetBoundingBox() end)
    if ok and sz then return math.clamp(sz.Y * 0.5, 3, 25) end
    return 6
end
function SaveDino.RecalculateTarget()
    if not State.SaveDinoOriginalCFrame then return end
    local y = (State.SaveDinoMode == "Down") and -State.SaveDinoOffset or (State.SaveDinoOffset * 4)
    State.SaveDinoTargetCFrame = State.SaveDinoOriginalCFrame + Vector3.new(0, y, 0)
end
function SaveDino.SetEnabled(en)
    State.SaveDinoEnabled = en; local c = LocalPlayer.Character
    if not c then State.SaveDinoPhase = "idle"; return end
    if en then
        if State.SaveDinoPhase == "idle" or not State.SaveDinoOriginalCFrame then
            local ok, pv = pcall(function() return c:GetPivot() end)
            if not ok or not pv then Utils.Notify("Save Dino", "Позиция не определена"); State.SaveDinoEnabled = false; return end
            State.SaveDinoOriginalCFrame = pv; State.SaveDinoCurrentCFrame = pv
        end
        SaveDino.RecalculateTarget(); State.SaveDinoPhase = "moving_to_safe"
        local h = c:FindFirstChildOfClass("Humanoid")
        if h then pcall(function() h:SetStateEnabled(Enum.HumanoidStateType.Freefall, false); h:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false); h:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false) end) end
        ensurePad(); Utils.Notify("Save Dino", "Погружение...")
    elseif State.SaveDinoPhase ~= "idle" then
        State.SaveDinoPhase = "returning"; Utils.Notify("Save Dino", "Возврат...")
    end
end
function SaveDino.ForceReset()
    State.SaveDinoEnabled = false; State.SaveDinoPhase = "idle"; local c = LocalPlayer.Character
    if c then
        noclip(c, false); zero(c)
        local h = c:FindFirstChildOfClass("Humanoid")
        if h then pcall(function() h:SetStateEnabled(Enum.HumanoidStateType.Freefall, true); h:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true); h:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true); h:ChangeState(Enum.HumanoidStateType.Running) end) end
    end
    State.SaveDinoOriginalCFrame = nil; State.SaveDinoTargetCFrame = nil; State.SaveDinoCurrentCFrame = nil; killPad()
end
function SaveDino.Init()
    Utils.Track(LocalPlayer.CharacterAdded:Connect(function() SaveDino.ForceReset() end))
    Utils.Track(RunService.Heartbeat:Connect(function(dt)
        if State.SaveDinoPhase == "idle" then return end
        local c = LocalPlayer.Character
        if not c or not c.Parent then SaveDino.ForceReset(); return end
        local ok, cur = pcall(function() return c:GetPivot() end)
        if not ok or not cur then return end
        if not State.SaveDinoCurrentCFrame then State.SaveDinoCurrentCFrame = cur end
        local pad = ensurePad(); local fo = feetOff(c)
        if State.SaveDinoPhase == "moving_to_safe" then
            noclip(c, true)
            local df = State.SaveDinoTargetCFrame.Position - State.SaveDinoCurrentCFrame.Position
            local di = df.Magnitude; local st = math.min(di, 120 * dt)
            if di <= 1.5 then State.SaveDinoCurrentCFrame = State.SaveDinoTargetCFrame; State.SaveDinoPhase = "holding"; Utils.Notify("Save Dino", "В безопасности")
            else State.SaveDinoCurrentCFrame = State.SaveDinoCurrentCFrame + df.Unit * st end
            pad.CFrame = CFrame.new(State.SaveDinoCurrentCFrame.Position - Vector3.new(0, fo, 0))
            pcall(function() c:PivotTo(State.SaveDinoCurrentCFrame) end); zero(c)
        elseif State.SaveDinoPhase == "holding" then
            noclip(c, true); pad.CFrame = CFrame.new(State.SaveDinoTargetCFrame.Position - Vector3.new(0, fo, 0))
            pcall(function() c:PivotTo(State.SaveDinoTargetCFrame) end); zero(c)
        elseif State.SaveDinoPhase == "returning" then
            noclip(c, true); local sf = State.SaveDinoOriginalCFrame + Vector3.new(0, 2.5, 0)
            local df = sf.Position - State.SaveDinoCurrentCFrame.Position; local di = df.Magnitude; local st = math.min(di, 110 * dt)
            if di <= 1.5 then noclip(c, false); pcall(function() c:PivotTo(sf) end); zero(c); SaveDino.ForceReset(); Utils.Notify("Save Dino", "На поверхности!")
            else
                State.SaveDinoCurrentCFrame = State.SaveDinoCurrentCFrame + df.Unit * st
                pad.CFrame = CFrame.new(State.SaveDinoCurrentCFrame.Position - Vector3.new(0, fo, 0))
                pcall(function() c:PivotTo(State.SaveDinoCurrentCFrame) end); zero(c)
            end
        end
    end))
end

-- 5. ZOMBIE BOT SCANNER & COMBAT
local Combat = {}
local ZP = PhysicalProperties.new(0.0001, 0, 0, 0, 0)
local CachedLocalGroups = nil
local PartToEnemyModel = {}
local PartToCategory = {}

local IgnoredMapFolders = {
    trees = true, foliage = true, rocks = true, grass = true, plants = true,
    leaves = true, clouds = true, lighting = true, water = true, map = true,
    terrain = true, props = true, buildings = true, effects = true,
}

local function matchCat(partName)
    local l = string.lower(partName)
    for _, c in ipairs({ "Jaw", "Neck", "Head", "Tail", "Leg", "Body" }) do
        for _, p in ipairs(PartPatterns[c]) do
            if string.find(l, p, 1, true) then return c end
        end
    end
    return nil
end

local function isLocal(m)
    return LocalPlayer.Character and (m == LocalPlayer.Character or m:IsDescendantOf(LocalPlayer.Character))
end

local function isRealPlayerCharacter(m)
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and (m == p.Character or m:IsDescendantOf(p.Character)) then return true, p end
    end
    return false, nil
end

local function isCritRoot(model, part, isSelf)
    if not part or not model then return true end
    local l = string.lower(part.Name)
    if l == "humanoidrootpart" or l == "rootpart" or l == "root" or l == "primary" or model.PrimaryPart == part then return true end
    if isSelf then
        local ok, ar = pcall(function() return part.AssemblyRootPart end)
        if ok and ar == part then return true end
    end
    return false
end

local function IsZombieBotModel(model)
    if not model or not model:IsA("Model") or not model.Parent or isLocal(model) then return false end
    local parentModel = model:FindFirstAncestorOfClass("Model")
    if parentModel and parentModel ~= Workspace then
        if parentModel:FindFirstChildOfClass("Humanoid") or parentModel:FindFirstChild("Hitboxes") or parentModel:FindFirstChildOfClass("AnimationController") then
            return false
        end
    end
    local isPlr = isRealPlayerCharacter(model)
    if isPlr then return State.AlsoTargetPlayers end

    local lowName = string.lower(model.Name)
    if string.find(lowName, "corpse", 1, true) or string.find(lowName, "carcass", 1, true)
        or string.find(lowName, "meat", 1, true) or string.find(lowName, "bone", 1, true)
        or string.find(lowName, "fossil", 1, true) or string.find(lowName, "pumpkin", 1, true)
        or string.find(lowName, "egg", 1, true) or string.find(lowName, "nest", 1, true)
        or string.find(lowName, "dead", 1, true) then
        return false
    end
    local _, _, isDead = GetBotHealth(model)
    if isDead then return false end
    if model:FindFirstChildOfClass("Humanoid") or model:FindFirstChild("Hitboxes") then return true end
    if model:FindFirstChildOfClass("AnimationController") then
        if model:FindFirstChild("Head", true) or model:FindFirstChild("HumanoidRootPart", true) or model:FindFirstChild("RootPart", true) then
            return true
        end
    end
    return false
end

local function getEnemyModelFromPart(part)
    if not part then return nil end
    local cached = PartToEnemyModel[part]
    if cached and cached.Parent then
        local _, _, isDead = GetBotHealth(cached)
        if not isDead then return cached end
    end
    if typeof(part) == "Instance" and part:IsA("BasePart") and not isLocal(part) then
        local cur = part.Parent
        local topBotModel = nil
        while cur and cur ~= Workspace do
            if cur:IsA("Model") and IsZombieBotModel(cur) then topBotModel = cur end
            cur = cur.Parent
        end
        if topBotModel then
            PartToEnemyModel[part] = topBotModel
            State.TrackedBots[topBotModel] = true
            return topBotModel
        end
    end
    return nil
end

local function findStrictTargetPartFast(model, cat)
    local c = State.CachedBotModels[model]
    if not c or (c.TotalParts or 0) == 0 then
        c = Combat.ScanModel(model, false)
        State.CachedBotModels[model] = c
    end
    if c[cat] then
        for _, p in ipairs(c[cat]) do if p and p.Parent then return p end end
    end
    if (cat == "Jaw" or cat == "Neck") and c.Head and c.Head[1] then return c.Head[1]
    elseif cat == "Head" and c.Jaw and c.Jaw[1] then return c.Jaw[1] end
    return nil
end

local function getClosestEnemyBot()
    local myChar = LocalPlayer.Character
    if not myChar then return nil end
    local ok, myPivot = pcall(function() return myChar:GetPivot().Position end)
    if not ok or not myPivot then return nil end
    local bestModel, bestDist = nil, 200
    for botModel in pairs(State.TrackedBots) do
        if botModel and botModel.Parent then
            local _, _, isDead = GetBotHealth(botModel)
            if not isDead then
                local ok2, ePos = pcall(function() return botModel:GetPivot().Position end)
                if ok2 and ePos then
                    local d = (ePos - myPivot).Magnitude
                    if d < bestDist then bestDist = d; bestModel = botModel end
                end
            end
        end
    end
    return bestModel
end

function Combat.ScanModel(model, isSelf)
    local cats = { Head = {}, Neck = {}, Jaw = {}, Body = {}, Tail = {}, Leg = {}, TotalParts = 0 }
    local added = { Head = {}, Neck = {}, Jaw = {}, Body = {}, Tail = {}, Leg = {} }
    local function addUnique(cat, part)
        if cats[cat] and not added[cat][part] then
            added[cat][part] = true
            table.insert(cats[cat], part)
            cats.TotalParts = cats.TotalParts + 1
            if not isSelf then PartToEnemyModel[part] = model; PartToCategory[part] = cat end
        end
    end
    pcall(function()
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("BasePart") and not isCritRoot(model, d, isSelf) then
                if not isSelf then PartToEnemyModel[d] = model end
                local c = matchCat(d.Name)
                if c and cats[c] then addUnique(c, d)
                elseif not isSelf then addUnique("Body", d) end
                if isSelf and d:FindFirstChildOfClass("TouchTransmitter") then addUnique("Jaw", d) end
            end
        end
        if #cats.Jaw == 0 and #cats.Head > 0 then for _, hp in ipairs(cats.Head) do addUnique("Jaw", hp) end
        elseif #cats.Head == 0 and #cats.Jaw > 0 then for _, jp in ipairs(cats.Jaw) do addUnique("Head", jp) end end
        if #cats.Neck == 0 and #cats.Head > 0 then for _, hp in ipairs(cats.Head) do addUnique("Neck", hp) end end
    end)
    return cats
end

function Combat.DiscoverBots()
    local function scanFolder(folder, depth)
        if depth > 3 then return end
        for _, ch in ipairs(folder:GetChildren()) do
            if ch:IsA("Model") then
                if IsZombieBotModel(ch) then State.TrackedBots[ch] = true end
            elseif ch:IsA("Folder") and not IgnoredMapFolders[string.lower(ch.Name)] then
                scanFolder(ch, depth + 1)
            end
        end
    end
    scanFolder(Workspace, 1)
    if State.AlsoTargetPlayers then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local _, _, dead = GetBotHealth(p.Character)
                if not dead then State.TrackedBots[p.Character] = true end
            end
        end
    end
end

local function IsCleanBridgePacket(arg1)
    if type(arg1) ~= "table" then return false end
    if arg1[2] == CLEAN_ACTION_BYTE then return true end
    local inner = arg1[1]
    if type(inner) == "table" and inner[2] == CLEAN_BRIDGE_ID then return true end
    if type(inner) == "table" and inner[1] == CLEAN_PREFIX_BYTE and type(inner[3]) == "table" and type(inner[3][1]) == "number" then return true end
    return false
end

local function TryPatchSilentAimTable(tbl, aimCat, depth)
    if depth > 4 then return false, false end
    local changed, cancel, targetPart = false, false, nil
    for k, v in pairs(tbl) do
        local tv = typeof(v)
        if tv == "Instance" then
            if v:IsA("BasePart") then
                local em = getEnemyModelFromPart(v)
                if em then
                    local hitCat = PartToCategory[v] or matchCat(v.Name) or "Body"
                    if hitCat == aimCat then targetPart = v
                    else
                        local tp = findStrictTargetPartFast(em, aimCat)
                        if tp then tbl[k] = tp; targetPart = tp; changed = true else cancel = true end
                    end
                end
            elseif v:IsA("Model") and not isLocal(v) then
                local tp = findStrictTargetPartFast(v, aimCat)
                if tp then targetPart = tp end
            elseif v:IsA("Humanoid") and v.Parent and not isLocal(v.Parent) then
                local tp = findStrictTargetPartFast(v.Parent, aimCat)
                if tp then targetPart = tp end
            end
        elseif tv == "string" and #v >= 3 and #v <= 22 then
            local strCat = matchCat(v)
            if strCat and strCat ~= aimCat then
                local em = getClosestEnemyBot()
                local tp = em and findStrictTargetPartFast(em, aimCat)
                if tp then tbl[k] = tp.Name; targetPart = tp; changed = true
                else tbl[k] = aimCat; changed = true end
            end
        elseif tv == "table" then
            local subMod, subCancel = TryPatchSilentAimTable(v, aimCat, depth + 1)
            if subMod then changed = true end
            if subCancel then cancel = true end
        end
    end
    if targetPart then
        for k, v in pairs(tbl) do
            local tv = typeof(v)
            if tv == "Vector3" then tbl[k] = targetPart.Position; changed = true
            elseif tv == "CFrame" then tbl[k] = targetPart.CFrame; changed = true end
        end
    end
    return changed, cancel
end

Env.PriorUI_NamecallHandler = function(old, self, ...)
    if type(checkcaller) == "function" and checkcaller() then return old(self, ...) end
    local cs = Env.PriorUI_State
    if not (cs and cs.Active) then return old(self, ...) end
    local m = getnamecallmethod()
    if m ~= "FireServer" and m ~= "InvokeServer" then return old(self, ...) end
    if cs.SaveDinoPhase == "idle" and not cs.SilentAim and Env.PE_CapturedCleanPacket then return old(self, ...) end

    local okName, rName = pcall(function() return self.Name end)
    if not okName or type(rName) ~= "string" then return old(self, ...) end
    if cs.SaveDinoPhase ~= "idle" and string.find(string.lower(rName), "fall", 1, true) then return nil end

    local a1 = ...
    if not Env.PE_CapturedCleanPacket and rName == "dataRemoteEvent" and type(a1) == "table" then
        if IsCleanBridgePacket(a1) then Env.PE_CapturedCleanPacket = { Remote = self, Args = Utils.DeepClone({ ... }) } end
    end

    if cs.SilentAim then
        local args = { ... }
        local modified, cancelHit = false, false
        for i = 1, #args do
            local arg = args[i]
            local ta = typeof(arg)
            if ta == "Instance" and arg:IsA("BasePart") then
                local em = getEnemyModelFromPart(arg)
                if em then
                    local hitCat = PartToCategory[arg] or matchCat(arg.Name) or "Body"
                    if hitCat ~= cs.AimTargetPart then
                        local tp = findStrictTargetPartFast(em, cs.AimTargetPart)
                        if tp then args[i] = tp; modified = true else cancelHit = true end
                    end
                end
            elseif ta == "string" and #arg >= 3 and #arg <= 22 then
                local strCat = matchCat(arg)
                if strCat and strCat ~= cs.AimTargetPart then
                    local em = getClosestEnemyBot()
                    local tp = em and findStrictTargetPartFast(em, cs.AimTargetPart)
                    args[i] = tp and tp.Name or cs.AimTargetPart
                    modified = true
                end
            elseif ta == "table" then
                local subMod, subCancel = TryPatchSilentAimTable(arg, cs.AimTargetPart, 1)
                if subMod then modified = true end
                if subCancel then cancelHit = true end
            end
        end
        if cancelHit and cs.StrictCancelNonTarget then return nil end
        if modified then return old(self, table.unpack(args)) end
    end
    return old(self, ...)
end

if not Env.PriorUI_HookInstalled and type(hookmetamethod) == "function" then
    pcall(function()
        local old
        old = hookmetamethod(game, "__namecall", function(self, ...)
            if Env.PriorUI_NamecallHandler then return Env.PriorUI_NamecallHandler(old, self, ...) end
            return old(self, ...)
        end)
        Env.PriorUI_HookInstalled = true
    end)
end

function Combat.RestoreSingleModelParts(model)
    local groups = State.CachedBotModels[model]
    if not groups then return end
    for _, parts in pairs(groups) do
        if type(parts) == "table" then
            for _, p in ipairs(parts) do
                local o = State.OriginalParts[p]
                if o and p and p.Parent then
                    pcall(function()
                        p.Size = o.Size; p.Transparency = o.Transparency; p.CanCollide = o.CanCollide
                        p.CanQuery = o.CanQuery; p.CanTouch = o.CanTouch; p.Massless = o.Massless
                        p.CustomPhysicalProperties = o.CustomPhysicalProperties; p.RootPriority = o.RootPriority
                        if o.Mesh and o.MeshScale then o.Mesh.Scale = o.MeshScale end
                    end)
                    State.OriginalParts[p] = nil
                end
            end
        end
    end
end

function Combat.RestoreEnemyParts()
    for p, o in pairs(State.OriginalParts) do
        pcall(function()
            if p and p.Parent then
                p.Size = o.Size; p.Transparency = o.Transparency; p.CanCollide = o.CanCollide
                p.CanQuery = o.CanQuery; p.CanTouch = o.CanTouch; p.Massless = o.Massless
                p.CustomPhysicalProperties = o.CustomPhysicalProperties; p.RootPriority = o.RootPriority
                if o.Mesh and o.MeshScale then o.Mesh.Scale = o.MeshScale end
            end
        end)
    end
    table.clear(State.OriginalParts); State.NeedsEnemyRestore = false
end

function Combat.RestoreLocalParts()
    for p, o in pairs(State.LocalOriginalParts) do
        pcall(function()
            if p and p.Parent then
                p.Size = o.Size; p.Transparency = o.Transparency
                if State.SaveDinoPhase == "idle" then p.CanCollide = o.CanCollide end
                p.CanQuery = o.CanQuery; p.CanTouch = o.CanTouch; p.Massless = o.Massless
                p.CustomPhysicalProperties = o.CustomPhysicalProperties; p.RootPriority = o.RootPriority
                if o.Mesh and o.MeshScale then o.Mesh.Scale = o.MeshScale end
            end
        end)
    end
    table.clear(State.LocalOriginalParts); State.NeedsLocalRestore = false
end

function Combat.RestoreAll()
    Combat.RestoreEnemyParts(); Combat.RestoreLocalParts()
end

function Combat.Init()
    Utils.Track(Workspace.DescendantAdded:Connect(function(desc)
        if desc:IsA("Model") then
            task.defer(function()
                if IsZombieBotModel(desc) then State.TrackedBots[desc] = true end
            end)
        end
    end))

    task.spawn(function()
        while State.Active do
            pcall(function()
                Combat.DiscoverBots()
                local nc = {}
                for botModel in pairs(State.TrackedBots) do
                    if botModel and botModel.Parent and not isLocal(botModel) then
                        local _, _, isDead = GetBotHealth(botModel)
                        if not isDead then
                            local isPlr = isRealPlayerCharacter(botModel)
                            if (not isPlr) or State.AlsoTargetPlayers then
                                if State.HitboxMaster or State.SilentAim then
                                    local prev = State.CachedBotModels[botModel]
                                    if not prev or (prev.TotalParts or 0) < 3 or #prev.Head == 0 then
                                        nc[botModel] = Combat.ScanModel(botModel, false)
                                    else
                                        nc[botModel] = prev
                                    end
                                end
                            end
                        else
                            Combat.RestoreSingleModelParts(botModel)
                            State.TrackedBots[botModel] = nil
                        end
                    else
                        State.TrackedBots[botModel] = nil
                    end
                end
                State.CachedBotModels = nc

                if State.ReachEnabled then
                    local myChar = LocalPlayer.Character
                    CachedLocalGroups = myChar and Combat.ScanModel(myChar, true) or nil
                end
            end)
            task.wait(1.0)
        end
    end)

    local lastApply = 0
    Utils.Track(RunService.Heartbeat:Connect(function()
        if not State.Active then return end
        local now = os.clock()
        if (now - lastApply) < 0.05 then return end
        lastApply = now

        if State.NeedsEnemyRestore then Combat.RestoreEnemyParts() end
        if State.NeedsLocalRestore then Combat.RestoreLocalParts() end

        if State.HitboxMaster or State.SilentAim then
            local enemyMult = HitboxMultipliers[State.HitboxSizeLevel] or 2.5
            local aimCat = State.AimTargetPart
            for model, groups in pairs(State.CachedBotModels) do
                if model and model.Parent and not isLocal(model) then
                    local _, _, isDead = GetBotHealth(model)
                    if not isDead then
                        for cat, parts in pairs(groups) do
                            if type(parts) == "table" then
                                local expandThisCat = State.HitboxMaster and (State.EnemyHitboxParts[cat] == true)
                                local isAimTargetCat = State.SilentAim and (cat == aimCat)
                                local disableNonTargetTouch = State.SilentAim and State.StrictCancelNonTarget and (not isAimTargetCat) and (not expandThisCat)
                                if expandThisCat or isAimTargetCat or disableNonTargetTouch then
                                    for _, part in ipairs(parts) do
                                        if part and part.Parent and not isCritRoot(model, part, false) then
                                            local o = State.OriginalParts[part]
                                            if not o then
                                                local mesh = part:FindFirstChildOfClass("SpecialMesh")
                                                o = {
                                                    Size = part.Size, Transparency = part.Transparency, CanCollide = part.CanCollide,
                                                    CanQuery = part.CanQuery, CanTouch = part.CanTouch, Massless = part.Massless,
                                                    CustomPhysicalProperties = part.CustomPhysicalProperties, RootPriority = part.RootPriority,
                                                    Mesh = mesh, MeshScale = mesh and mesh.Scale or nil,
                                                }
                                                State.OriginalParts[part] = o
                                            end
                                            if expandThisCat then
                                                local targetVec = o.Size * enemyMult
                                                if (part.Size - targetVec).Magnitude > 0.05 then
                                                    part.Massless = true; part.CanCollide = false; part.CustomPhysicalProperties = ZP; part.RootPriority = -127
                                                    part.Size = targetVec
                                                    if o.Mesh and o.MeshScale then o.Mesh.Scale = o.MeshScale * enemyMult end
                                                end
                                                if math.abs(part.Transparency - State.HitboxTransparency) > 0.02 then part.Transparency = State.HitboxTransparency end
                                                if not part.CanTouch then part.CanTouch = true end
                                                if not part.CanQuery then part.CanQuery = true end
                                            elseif disableNonTargetTouch then
                                                if (part.Size - o.Size).Magnitude > 0.05 then part.Size = o.Size end
                                                if part.CanTouch then part.CanTouch = false end
                                                if part.CanQuery then part.CanQuery = false end
                                            elseif isAimTargetCat then
                                                local aimVec = o.Size * 1.8
                                                if (part.Size - aimVec).Magnitude > 0.05 then
                                                    part.Massless = true; part.CanCollide = false; part.CustomPhysicalProperties = ZP; part.RootPriority = -127
                                                    part.Size = aimVec
                                                end
                                                if not part.CanTouch then part.CanTouch = true end
                                                if not part.CanQuery then part.CanQuery = true end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end

        if State.ReachEnabled and CachedLocalGroups then
            local myChar = LocalPlayer.Character
            if myChar and myChar.Parent then
                local reachMult = ReachMultipliers[State.ReachScaleLevel] or 2.0
                for cat, parts in pairs(CachedLocalGroups) do
                    if type(parts) == "table" and State.ReachParts[cat] == true then
                        for _, part in ipairs(parts) do
                            if part and part.Parent and not isCritRoot(myChar, part, true) then
                                local orig = State.LocalOriginalParts[part]
                                if not orig then
                                    local mesh = part:FindFirstChildOfClass("SpecialMesh")
                                    orig = {
                                        Size = part.Size, Transparency = part.Transparency, CanCollide = part.CanCollide,
                                        CanQuery = part.CanQuery, CanTouch = part.CanTouch, Massless = part.Massless,
                                        CustomPhysicalProperties = part.CustomPhysicalProperties, RootPriority = part.RootPriority,
                                        Mesh = mesh, MeshScale = mesh and mesh.Scale or nil,
                                    }
                                    State.LocalOriginalParts[part] = orig
                                end
                                local targetVec = orig.Size * reachMult
                                if (part.Size - targetVec).Magnitude > 0.05 then
                                    part.Massless = true; part.CanCollide = false; part.CustomPhysicalProperties = ZP; part.RootPriority = -127
                                    part.Size = targetVec
                                    if orig.Mesh and orig.MeshScale then orig.Mesh.Scale = orig.MeshScale * reachMult end
                                end
                                if math.abs(part.Transparency - State.ReachTransparency) > 0.02 then part.Transparency = State.ReachTransparency end
                                if not part.CanTouch then part.CanTouch = true end
                                if not part.CanQuery then part.CanQuery = true end
                            end
                        end
                    end
                end
            end
        end
    end))

    task.spawn(function()
        while State.Active do
            if State.NoAttackCD then
                pcall(function()
                    local ch = LocalPlayer.Character
                    if ch then
                        for _, inst in ipairs({ ch, LocalPlayer }) do
                            local ok, at = pcall(function() return inst:GetAttributes() end)
                            if ok and type(at) == "table" then
                                for k, v in pairs(at) do
                                    local kn = string.lower(k)
                                    if (string.find(kn, "cooldown", 1, true) or string.find(kn, "attackcd", 1, true) or string.find(kn, "bitecd", 1, true) or string.find(kn, "debounce", 1, true)) and type(v) == "number" then inst:SetAttribute(k, 0)
                                    elseif (kn == "canattack" or kn == "canbite") and type(v) == "boolean" then inst:SetAttribute(k, true) end
                                end
                            end
                        end
                    end
                end)
            end
            task.wait(0.12)
        end
    end)
end

-- 6. HALLOWEEN ESP MODULE (4 PUMPKIN TYPES: WHITE, GREEN, YELLOW, NORMAL + LIVE ZOMBIE BOTS)
local ESPModule = {}
local botGuis, worldGuis, trackedWorld, headCache, speciesCache = {}, {}, {}, {}, {}
local worldScanDone, worldScanning = false, false
local ESPFolder = Instance.new("Folder"); ESPFolder.Name = "PE_Halloween_ESP"
pcall(function() ESPFolder.Parent = Utils.GuiParent() end)

local PumpkinVisuals = {
    White  = { Title = "⚪ БЕЛАЯ ТЫКВА",   Color = Color3.fromRGB(245, 248, 255) },
    Yellow = { Title = "🟡 ЖЕЛТАЯ ТЫКВА",  Color = Color3.fromRGB(255, 225, 45)  },
    Green  = { Title = "🟢 ЗЕЛЕНАЯ ТЫКВА", Color = Color3.fromRGB(75, 240, 95)   },
    Normal = { Title = "🎃 ОБЫЧНАЯ ТЫКВА", Color = Color3.fromRGB(255, 140, 25)  },
}

-- Определяет точный тип тыквы (White / Green / Yellow / Normal) по названию, атрибутам или RGB-цвету 3D-детали
local function DetectPumpkinSubType(targetObj, part, fullText)
    local checkStr = fullText or ""
    if targetObj then
        local ok, attrs = pcall(function() return targetObj:GetAttributes() end)
        if ok and type(attrs) == "table" then
            for k, v in pairs(attrs) do
                checkStr = checkStr .. " " .. string.lower(tostring(k) .. " " .. tostring(v))
            end
        end
    end

    -- 1. Проверка по ключевым словам в названии / атрибутах
    if string.find(checkStr, "white", 1, true) or string.find(checkStr, "albino", 1, true) or string.find(checkStr, "ghost", 1, true) or string.find(checkStr, "pale", 1, true) or string.find(checkStr, "silver", 1, true) then
        return "White"
    elseif string.find(checkStr, "green", 1, true) or string.find(checkStr, "lime", 1, true) or string.find(checkStr, "emerald", 1, true) or string.find(checkStr, "uncommon", 1, true) then
        return "Green"
    elseif string.find(checkStr, "yellow", 1, true) or string.find(checkStr, "gold", 1, true) or string.find(checkStr, "golden", 1, true) or string.find(checkStr, "amber", 1, true) then
        return "Yellow"
    end

    -- 2. Проверка по реальному цвету самой тыквы (Part.Color / MeshPart.Color)
    local colorPart = part
    if targetObj and targetObj:IsA("Model") then
        for _, d in ipairs(targetObj:GetDescendants()) do
            if d:IsA("BasePart") and d.Transparency < 0.8 then
                local dn = string.lower(d.Name)
                -- Ищем основное тело тыквы, пропуская зеленый хвостик/стебель (stem/stalk/vine)
                if not string.find(dn, "stem", 1, true) and not string.find(dn, "stalk", 1, true) and not string.find(dn, "vine", 1, true) and not string.find(dn, "leaf", 1, true) then
                    colorPart = d
                    break
                end
            end
        end
    end

    if colorPart and colorPart:IsA("BasePart") then
        local c = colorPart.Color
        local h, s, v = Color3.toHSV(c)
        -- Белая тыква: низкая насыщенность и высокая яркость
        if s < 0.22 and v > 0.70 then
            return "White"
        end
        -- Зеленая тыква: оттенок зеленого (Hue ~ 0.21 .. 0.46)
        if h >= 0.21 and h <= 0.46 and s >= 0.22 then
            return "Green"
        end
        -- Желтая/золотая тыква: оттенок желтого (Hue ~ 0.115 .. 0.21) или очень высокое G при высоком R
        if (h >= 0.115 and h < 0.21 and s >= 0.25) or (c.R > 0.82 and c.G > 0.72 and c.B < 0.35) then
            return "Yellow"
        end
    end

    return "Normal"
end

local function getESPHead(c)
    if not c or not c:IsA("Model") then return nil end
    if headCache[c] and headCache[c].Parent then return headCache[c] end
    local h = c:FindFirstChild("Head", true)
    if h and h:IsA("BasePart") then headCache[c] = h; return h end
    for _, d in ipairs(c:GetDescendants()) do
        if d:IsA("BasePart") and string.find(string.lower(d.Name), "head", 1, true) then headCache[c] = d; return d end
    end
    local fb = c.PrimaryPart or c:FindFirstChildWhichIsA("BasePart", true)
    headCache[c] = fb; return fb
end

local InvalidSpeciesWords = {
    ["rig"] = true, ["model"] = true, ["default"] = true, ["male"] = true, ["female"] = true,
    ["adult"] = true, ["juvenile"] = true, ["baby"] = true, ["subadult"] = true, ["hatchling"] = true,
    ["hitboxes"] = true, ["hitbox"] = true, ["parts"] = true, ["character"] = true, ["humanoid"] = true,
    ["custom"] = true, ["none"] = true, ["null"] = true, ["true"] = true, ["false"] = true,
}
local ExactSpeciesKeys = {
    "dinosaur", "species", "dinoname", "dinosaur_name", "speciesname", "currentdino",
    "selecteddino", "selecteddinosaur", "creature", "creaturename", "mobname", "botname", "dino",
}

local function CleanBotSpeciesName(raw)
    if type(raw) ~= "string" then return nil end
    local s = string.gsub(raw, "^%s+", ""):gsub("%s+$", ""):gsub("[_%-%s]+%d+$", "")
    if #s < 3 or #s > 35 or tonumber(s) then return nil end
    if InvalidSpeciesWords[string.lower(s)] then return nil end
    return s
end

local function GetBotSpeciesName(model)
    if not model then return "Zombie Dino" end
    if speciesCache[model] and (os.clock() - speciesCache[model].time) < 5.0 then return speciesCache[model].name end
    local foundName = nil
    for _, inst in ipairs({ model, model:FindFirstChildOfClass("Humanoid") }) do
        if inst and not foundName then
            local ok, attrs = pcall(function() return inst:GetAttributes() end)
            if ok and type(attrs) == "table" then
                for _, targetKey in ipairs(ExactSpeciesKeys) do
                    for k, v in pairs(attrs) do
                        if string.lower(k) == targetKey or string.find(string.lower(k), targetKey, 1, true) then
                            local cleaned = CleanBotSpeciesName(v)
                            if cleaned then foundName = cleaned; break end
                        end
                    end
                    if foundName then break end
                end
            end
        end
    end
    if not foundName then
        for _, obj in ipairs(model:GetChildren()) do
            if obj:IsA("StringValue") then
                local on = string.lower(obj.Name)
                for _, targetKey in ipairs(ExactSpeciesKeys) do
                    if on == targetKey or string.find(on, targetKey, 1, true) then
                        local cleaned = CleanBotSpeciesName(obj.Value)
                        if cleaned then foundName = cleaned; break end
                    end
                end
            end
        end
    end
    if not foundName then
        local hum = model:FindFirstChildOfClass("Humanoid")
        if hum and hum.DisplayName ~= "" then foundName = CleanBotSpeciesName(hum.DisplayName) end
    end
    if not foundName then foundName = CleanBotSpeciesName(model.Name) or "Zombie Dino" end
    speciesCache[model] = { name = foundName, time = os.clock() }
    return foundName
end

local function GetMyPosition()
    local myChar = LocalPlayer.Character
    if myChar then
        local ok, pivot = pcall(function() return myChar:GetPivot().Position end)
        if ok and pivot then return pivot end
    end
    return Workspace.CurrentCamera and Workspace.CurrentCamera.CFrame.Position or Vector3.zero
end

local PumpkinKeywords = { "pumpkin", "jackolantern", "jack_o_lantern", "jack-o-lantern", "gourd", "halloween", "candy", "treat", "eventpumpkin", "xppumpkin" }
local IgnoredSpawnKeywords = { "spawn", "point", "zone", "holder", "spawner", "container", "trigger", "node", "tree", "leaf", "leaves", "branch", "trunk", "bark", "foliage", "bush" }
local BoneKeywords = { "fossil", "bone", "skeleton", "amber", "relic", "digsite", "dig_site", "excavat", "skull", "remains" }
local CorpseKeywords = { "carcass", "corpse", "deadbody", "dead_body", "meat", "gore", "chunk", "edible", "food", "prey", "ribcage", "flesh", "steak" }

local function MatchWorldCategoryFromText(tx, part)
    for _, k in ipairs(IgnoredSpawnKeywords) do
        if string.find(tx, k, 1, true) then return nil end
    end
    for _, k in ipairs(PumpkinKeywords) do
        if string.find(tx, k, 1, true) then
            if part and part:IsA("BasePart") then
                if part.Transparency >= 0.95 then return nil end
                local sz = part.Size.Magnitude
                if sz >= 0.8 and sz <= 14 then return "Pumpkin" end
            end
            return nil
        end
    end
    for _, k in ipairs(BoneKeywords) do if string.find(tx, k, 1, true) then return "Bone" end end
    for _, k in ipairs(CorpseKeywords) do if string.find(tx, k, 1, true) then return "Corpse" end end
    return nil
end

local function TryRegisterWorldObject(d)
    if not d or not d.Parent or d == SaveDino.Pad or isLocal(d) then return end
    if isRealPlayerCharacter(d) then return end
    if d:IsA("ProximityPrompt") or d:IsA("ClickDetector") then
        local target = d.Parent
        if not target or target == Workspace or trackedWorld[target] then return end
        local pName = target.Parent and target.Parent ~= Workspace and target.Parent.Name or ""
        local tx = string.lower(d.Name .. " " .. target.Name .. " " .. pName)
        if d:IsA("ProximityPrompt") then tx = tx .. " " .. string.lower(d.ActionText .. " " .. d.ObjectText) end
        local part = target:IsA("BasePart") and target or target:FindFirstAncestorWhichIsA("BasePart") or target:FindFirstChildWhichIsA("BasePart", true)
        local cat = MatchWorldCategoryFromText(tx, part)
        if cat and part then
            local pType = (cat == "Pumpkin") and DetectPumpkinSubType(target, part, tx) or nil
            trackedWorld[target] = { Category = cat, SubType = pType, Part = part, FullText = tx }
        end
        return
    end
    if d:IsA("Model") or d:IsA("BasePart") or d:IsA("MeshPart") then
        local ancestorModel = d:FindFirstAncestorOfClass("Model")
        if ancestorModel and ancestorModel ~= Workspace and (trackedWorld[ancestorModel] or State.TrackedBots[ancestorModel]) then return end
        local parentName = (d.Parent and d.Parent ~= Workspace) and string.lower(d.Parent.Name) or ""
        local grandParentName = (d.Parent and d.Parent.Parent and d.Parent.Parent ~= Workspace) and string.lower(d.Parent.Parent.Name) or ""
        local fullCheck = string.lower(d.Name) .. " " .. parentName .. " " .. grandParentName
        local part = (d:IsA("BasePart") and d) or (ancestorModel and ancestorModel.PrimaryPart) or d:FindFirstChildWhichIsA("BasePart", true)
        local cat = MatchWorldCategoryFromText(fullCheck, part)
        if cat and part then
            local rootTarget = (d:IsA("BasePart") and ancestorModel and ancestorModel ~= Workspace and not State.TrackedBots[ancestorModel]) and ancestorModel or d
            if not trackedWorld[rootTarget] then
                local pType = (cat == "Pumpkin") and DetectPumpkinSubType(rootTarget, part, fullCheck) or nil
                trackedWorld[rootTarget] = { Category = cat, SubType = pType, Part = part, FullText = fullCheck }
            end
        end
    end
end

function ESPModule.ScanWorldItems()
    if worldScanning then return end
    worldScanning = true
    task.spawn(function()
        local count = 0
        local function scanNode(node)
            local ok, ch = pcall(function() return node:GetChildren() end)
            if not ok or not ch then return end
            for _, child in ipairs(ch) do
                if not State.Active then return end
                count = count + 1
                if count % 200 == 0 then task.wait() end
                if child ~= Workspace.Terrain and not isLocal(child) then
                    TryRegisterWorldObject(child)
                    local cn = string.lower(child.Name)
                    if not IgnoredMapFolders[cn] and not trackedWorld[child] and not State.TrackedBots[child] then scanNode(child) end
                end
            end
        end
        scanNode(Workspace)
        worldScanDone = true; worldScanning = false
    end)
end

function ESPModule.Cleanup()
    for _, data in pairs(botGuis) do if data.gui then pcall(function() data.gui:Destroy() end) end end
    for _, data in pairs(worldGuis) do if data.gui then pcall(function() data.gui:Destroy() end) end end
    table.clear(botGuis); table.clear(worldGuis); table.clear(trackedWorld); table.clear(headCache); table.clear(speciesCache)
    if ESPFolder then pcall(function() ESPFolder:Destroy() end) end
end

function ESPModule.Init()
    Utils.Track(Workspace.DescendantAdded:Connect(function(desc)
        if State.ESPPumpkins or State.ESPBones or State.ESPCorpses then
            task.defer(function() pcall(TryRegisterWorldObject, desc) end)
        end
    end))
    task.defer(function()
        if State.ESPPumpkins or State.ESPBones or State.ESPCorpses then ESPModule.ScanWorldItems() end
    end)

    task.spawn(function()
        while State.Active do
            pcall(function()
                local myPos = GetMyPosition()
                if not State.BotESPEnabled then
                    for _, data in pairs(botGuis) do if data.gui and data.gui.Enabled then data.gui.Enabled = false end end
                else
                    for botModel, data in pairs(botGuis) do
                        local _, _, isDead = GetBotHealth(botModel)
                        if not botModel or not botModel.Parent or not State.TrackedBots[botModel] or isDead then
                            if data.gui then pcall(function() data.gui:Destroy() end) end
                            botGuis[botModel] = nil
                            if isDead then State.TrackedBots[botModel] = nil end
                        end
                    end
                    for botModel in pairs(State.TrackedBots) do
                        if botModel and botModel.Parent and not isLocal(botModel) then
                            local hp, maxHp, isDead = GetBotHealth(botModel)
                            if isDead then
                                State.TrackedBots[botModel] = nil
                                if botGuis[botModel] and botGuis[botModel].gui then
                                    pcall(function() botGuis[botModel].gui:Destroy() end)
                                    botGuis[botModel] = nil
                                end
                            else
                                local targetPart = getESPHead(botModel)
                                if targetPart then
                                    local dist = (myPos - targetPart.Position).Magnitude
                                    if dist <= State.BotESPMaxDistance then
                                        if not botGuis[botModel] or not botGuis[botModel].gui or not botGuis[botModel].gui.Parent then
                                            local billboard = Instance.new("BillboardGui"); billboard.Name = "PE_BotESP"
                                            billboard.Size = UDim2.fromOffset(185, 52); billboard.StudsOffset = Vector3.new(0, 5.5, 0)
                                            billboard.AlwaysOnTop = true; billboard.ResetOnSpawn = false; billboard.Enabled = false; billboard.Parent = ESPFolder

                                            local speciesLabel = Instance.new("TextLabel"); speciesLabel.Size = UDim2.new(1, 0, 0, 16)
                                            speciesLabel.BackgroundTransparency = 1; speciesLabel.TextColor3 = Color3.fromRGB(255, 145, 45)
                                            speciesLabel.TextStrokeTransparency = 0.05; speciesLabel.Font = Enum.Font.GothamBold; speciesLabel.TextSize = 12; speciesLabel.Parent = billboard

                                            local distLabel = Instance.new("TextLabel"); distLabel.Size = UDim2.new(1, 0, 0, 14); distLabel.Position = UDim2.new(0, 0, 0, 16)
                                            distLabel.BackgroundTransparency = 1; distLabel.TextColor3 = Color3.fromRGB(235, 235, 240)
                                            distLabel.TextStrokeTransparency = 0.1; distLabel.Font = Enum.Font.GothamBold; distLabel.TextSize = 11; distLabel.Parent = billboard

                                            local hpBarBg = Instance.new("Frame"); hpBarBg.Size = UDim2.new(1, 0, 0, 14); hpBarBg.Position = UDim2.new(0, 0, 0, 33)
                                            hpBarBg.BackgroundColor3 = Color3.fromRGB(24, 24, 28); hpBarBg.BorderSizePixel = 0; hpBarBg.Parent = billboard
                                            Utils.Style(hpBarBg, 4, Color3.fromRGB(0, 0, 0), 1)

                                            local hpBarFill = Instance.new("Frame"); hpBarFill.Size = UDim2.new(1, 0, 1, 0)
                                            hpBarFill.BackgroundColor3 = Color3.fromRGB(65, 235, 85); hpBarFill.BorderSizePixel = 0; hpBarFill.Parent = hpBarBg
                                            Utils.Style(hpBarFill, 4, nil)

                                            local hpText = Instance.new("TextLabel"); hpText.Size = UDim2.fromScale(1, 1); hpText.BackgroundTransparency = 1
                                            hpText.TextColor3 = Color3.fromRGB(255, 255, 255); hpText.TextStrokeTransparency = 0.05; hpText.Font = Enum.Font.GothamBold
                                            hpText.TextSize = 10; hpText.ZIndex = 3; hpText.Parent = hpBarBg

                                            botGuis[botModel] = { gui = billboard, species = speciesLabel, dist = distLabel, hpBg = hpBarBg, hpFill = hpBarFill, hpText = hpText }
                                        end
                                        local data = botGuis[botModel]; data.gui.Adornee = targetPart
                                        local dinoName = GetBotSpeciesName(botModel)
                                        local hpRatio = math.clamp(hp / maxHp, 0, 1)
                                        local isPlr, plrObj = isRealPlayerCharacter(botModel)
                                        data.species.Visible = State.ESP_BotSpecies
                                        if isPlr and plrObj then
                                            data.species.TextColor3 = Color3.fromRGB(255, 215, 90)
                                            data.species.Text = "[" .. tostring(dinoName) .. "]"
                                            data.dist.Text = string.format("[%dm] %s", math.floor(dist), plrObj.DisplayName or plrObj.Name)
                                        else
                                            data.species.TextColor3 = Color3.fromRGB(255, 130, 40)
                                            data.species.Text = "🧟 ZOMBIE: " .. tostring(dinoName)
                                            data.dist.Text = string.format("Дистанция: [%dm]", math.floor(dist))
                                        end
                                        data.hpBg.Visible = State.ESP_BotHealth
                                        if State.ESP_BotHealth then
                                            data.hpFill.Size = UDim2.new(hpRatio, 0, 1, 0)
                                            data.hpText.Text = string.format("HP: %d / %d", math.floor(hp + 0.5), math.floor(maxHp + 0.5))
                                            data.hpFill.BackgroundColor3 = (hpRatio < 0.3 and Color3.fromRGB(235, 65, 65)) or (hpRatio < 0.65 and Color3.fromRGB(240, 190, 50)) or Color3.fromRGB(60, 215, 80)
                                        end
                                        data.gui.Enabled = true
                                    elseif botGuis[botModel] and botGuis[botModel].gui then
                                        botGuis[botModel].gui.Enabled = false
                                    end
                                end
                            end
                        end
                    end
                end

                -- ESP Тыкв (с разделением на Белую, Зеленую, Желтую и Обычную) + Кости/Трупы
                if State.ESPPumpkins or State.ESPBones or State.ESPCorpses then
                    if not worldScanDone and not worldScanning then ESPModule.ScanWorldItems() end
                    for obj, info in pairs(trackedWorld) do
                        local part = info.Part
                        if not obj or not obj.Parent or not part or not part.Parent or (info.Category == "Pumpkin" and part.Transparency >= 0.95) then
                            if worldGuis[obj] and worldGuis[obj].gui then pcall(function() worldGuis[obj].gui:Destroy() end) end
                            worldGuis[obj] = nil; trackedWorld[obj] = nil
                        else
                            local cat = info.Category
                            local subType = info.SubType
                            if cat == "Pumpkin" then
                                subType = DetectPumpkinSubType(obj, part, info.FullText)
                                info.SubType = subType
                            end

                            local show = false
                            if cat == "Pumpkin" and State.ESPPumpkins then
                                show = (State.PumpkinTypes[subType or "Normal"] == true)
                            elseif cat == "Bone" and State.ESPBones then
                                show = true
                            elseif cat == "Corpse" and State.ESPCorpses then
                                show = true
                            end

                            local maxD = (cat == "Pumpkin") and State.PumpkinESPMaxDistance or State.WorldESPMaxDistance
                            local dist = (myPos - part.Position).Magnitude
                            if show and dist <= maxD then
                                if not worldGuis[obj] or not worldGuis[obj].gui or not worldGuis[obj].gui.Parent then
                                    local bGui = Instance.new("BillboardGui"); bGui.Name = "PE_HalloweenWorldESP"
                                    bGui.Size = UDim2.fromOffset(185, 28); bGui.StudsOffset = Vector3.new(0, 3.0, 0); bGui.AlwaysOnTop = true; bGui.Parent = ESPFolder
                                    local lbl = Instance.new("TextLabel"); lbl.Size = UDim2.fromScale(1, 1); lbl.BackgroundTransparency = 1
                                    lbl.TextStrokeTransparency = 0.05; lbl.Font = Enum.Font.GothamBold; lbl.TextSize = (cat == "Pumpkin") and 13 or 12
                                    lbl.Parent = bGui
                                    worldGuis[obj] = { gui = bGui, label = lbl }
                                end
                                local wGui = worldGuis[obj]; wGui.gui.Adornee = part
                                if cat == "Pumpkin" then
                                    local pVis = PumpkinVisuals[subType or "Normal"] or PumpkinVisuals.Normal
                                    wGui.label.TextColor3 = pVis.Color
                                    wGui.label.Text = string.format("%s [%dm]", pVis.Title, math.floor(dist))
                                elseif cat == "Bone" then
                                    wGui.label.TextColor3 = Color3.fromRGB(255, 235, 150)
                                    wGui.label.Text = string.format("[%dm] КОСТЬ", math.floor(dist))
                                else
                                    wGui.label.TextColor3 = Color3.fromRGB(255, 110, 90)
                                    wGui.label.Text = string.format("[%dm] ЕДА/ТРУП", math.floor(dist))
                                end
                                wGui.gui.Enabled = true
                            elseif worldGuis[obj] and worldGuis[obj].gui then
                                worldGuis[obj].gui.Enabled = false
                            end
                        end
                    end
                else
                    for _, gData in pairs(worldGuis) do if gData.gui and gData.gui.Enabled then gData.gui.Enabled = false end end
                end
            end)
            task.wait(0.25)
        end
    end)
end

-- 7. UI CONSTRUCTION & INIT
