CreateToggle(ToolsPage, "Auto Clean (Вшитый пакет мытья)", State.AutoClean, 1, function(v) State.AutoClean = v; if v then Utils.Notify("Auto Clean", "Пакетное мытье активировано!") end end)
CreateToggle(ToolsPage, "Save Dino (Уход под землю от ботов)", false, 2, function(v) SaveDino.SetEnabled(v) end)
CreateCycleButton(ToolsPage, "Направление Save Dino", { "Down", "Up" }, 1, 3, function(_, idx) State.SaveDinoMode = (idx == 1) and "Down" or "Up"; SaveDino.RecalculateTarget(); if State.SaveDinoPhase == "holding" then State.SaveDinoPhase = "moving_to_safe" end end)
CreateCycleButton(ToolsPage, "Глубина Save Dino", { 50, 70, 95, 120 }, 2, 4, function(val) State.SaveDinoOffset = val; SaveDino.RecalculateTarget(); if State.SaveDinoPhase == "holding" then State.SaveDinoPhase = "moving_to_safe" end end)

local function MinimizeUI()
    if State.Minimized then return end
    State.Minimized = true; MainFrame.Visible = false; MiniIcon.Size = IconSize; MiniIcon.Visible = true
end
local function RestoreUI()
    if not State.Minimized then return end
    State.Minimized = false; MiniIcon.Visible = false; MainFrame.Visible = true
end
local function DeactivateScript()
    if not State.Active then return end
    State.Active = false; State.SilentAim = false; State.HitboxMaster = false; State.ReachEnabled = false
    State.BotESPEnabled = false; State.ESPPumpkins = false; State.ESPBones = false; State.ESPCorpses = false
    State.NoAttackCD = false; State.AutoClean = false; State.UnlockCamera = false
    Visuals.Restore(); SaveDino.ForceReset(); Combat.RestoreAll(); ESPModule.Cleanup()
    for _, conn in ipairs(State.Connections) do pcall(function() conn:Disconnect() end) end
    table.clear(State.Connections)
    pcall(function() ScreenGui:Destroy() end)
    Env.PriorUI_Cleanup = nil; Utils.Notify("Apex-Halloween", "Скрипт выгружен.")
end

Env.PriorUI_Cleanup = DeactivateScript
Utils.Drag(TopBar, MainFrame, nil); Utils.Drag(MiniIcon, MiniIcon, RestoreUI)
Utils.Track(MinimizeBtn.Activated:Connect(MinimizeUI)); Utils.Track(DeactivateBtn.Activated:Connect(DeactivateScript))

Visuals.Init(); Survival.Init(); SaveDino.Init(); Combat.Init(); ESPModule.Init()
Utils.Notify("Apex-Halloween", "v1.4 запущен! Добавлены 4 вида тыкв.")
