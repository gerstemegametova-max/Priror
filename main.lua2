MiniIcon.Text = "🎃"; MiniIcon.TextColor3 = Color3.fromRGB(255, 160, 55); MiniIcon.Font = Enum.Font.GothamBold; MiniIcon.TextSize = 18; MiniIcon.Visible = false; MiniIcon.Parent = ScreenGui; Utils.Style(MiniIcon, 25, Theme.Stroke, 1.5)

