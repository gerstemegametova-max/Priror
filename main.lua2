-- Halloween ESP Tab (с отдельным выбором Белой, Зеленой, Желтой и Обычной тыквы)
CreateToggle(RenderPage, "🎃 Мастер ESP Тыкв (Вкл/Выкл все)", State.ESPPumpkins, 1, function(v) State.ESPPumpkins = v; if v then ESPModule.ScanWorldItems() end end)
CreateToggle(RenderPage, "⚪ [Тыква] Белая (White Pumpkin)", State.PumpkinTypes.White, 2, function(v) State.PumpkinTypes.White = v end)
