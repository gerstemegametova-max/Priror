CreateToggle(CombatPage, "[Reach] Ноги и Лапы (Legs)", State.ReachParts.Leg, 8, function(v) State.ReachParts.Leg = v; State.NeedsLocalRestore = true end)
CreateToggle(CombatPage, "[Reach] Тело (Body)", State.ReachParts.Body, 9, function(v) State.ReachParts.Body = v; State.NeedsLocalRestore = true end)

CreateToggle(CombatPage, "Silent Aim по Ботам-Зомби (Только в цель)", State.SilentAim, 10, function(v) State.SilentAim = v; State.NeedsEnemyRestore = true end)
CreateCycleButton(CombatPage, "Цель Silent Aim (Боты)", { "Head", "Neck", "Jaw", "Body", "Tail", "Leg" }, 1, 11, function(opt) State.AimTargetPart = opt; State.NeedsEnemyRestore = true end)
CreateToggle(CombatPage, "Не регать урон мимо цели Silent Aim", State.StrictCancelNonTarget, 12, function(v) State.StrictCancelNonTarget = v; State.NeedsEnemyRestore = true end)

CreateToggle(CombatPage, "Bot Hitbox Expander (Хитбоксы Зомби)", State.HitboxMaster, 13, function(v) State.HitboxMaster = v; State.NeedsEnemyRestore = true end)
CreateCycleButton(CombatPage, "Множитель Хитбокса Ботов", HitboxLabels, State.HitboxSizeLevel, 14, function(_, idx) State.HitboxSizeLevel = idx end)
CreateCycleButton(CombatPage, "Прозрачность Хитбокса Ботов", TransLabels, State.HitboxTransLevel, 15, function(_, idx) State.HitboxTransLevel = idx; State.HitboxTransparency = TransValues[idx] or 0.75 end)
CreateToggle(CombatPage, "[Hitbox Бота] Голова (Head)", State.EnemyHitboxParts.Head, 16, function(v) State.EnemyHitboxParts.Head = v; State.NeedsEnemyRestore = true end)
CreateToggle(CombatPage, "[Hitbox Бота] Шея (Neck)", State.EnemyHitboxParts.Neck, 17, function(v) State.EnemyHitboxParts.Neck = v; State.NeedsEnemyRestore = true end)
CreateToggle(CombatPage, "[Hitbox Бота] Челюсть (Jaw)", State.EnemyHitboxParts.Jaw, 18, function(v) State.EnemyHitboxParts.Jaw = v; State.NeedsEnemyRestore = true end)
CreateToggle(CombatPage, "[Hitbox Бота] Тело / Торс (Body)", State.EnemyHitboxParts.Body, 19, function(v) State.EnemyHitboxParts.Body = v; State.NeedsEnemyRestore = true end)
CreateToggle(CombatPage, "[Hitbox Бота] Хвост (Tail)", State.EnemyHitboxParts.Tail, 20, function(v) State.EnemyHitboxParts.Tail = v; State.NeedsEnemyRestore = true end)
CreateToggle(CombatPage, "[Hitbox Бота] Ноги / Лапы (Legs)", State.EnemyHitboxParts.Leg, 21, function(v) State.EnemyHitboxParts.Leg = v; State.NeedsEnemyRestore = true end)
CreateToggle(CombatPage, "Захватывать также обычных игроков", State.AlsoTargetPlayers, 22, function(v) State.AlsoTargetPlayers = v; State.NeedsEnemyRestore = true end)
